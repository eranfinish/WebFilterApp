<?xml version="1.0" encoding="utf-8"?>
<!--
  WebFilter MSI (MVP-PLAN §4.6). Per-machine, x64. Silent install:

    msiexec /i WebFilter.msi /qn ROLE=hub
    msiexec /i WebFilter.msi /qn ROLE=agent HUB=lab-hub.local:47800 PAIRCODE=XXXX-XXXX-XXXX

  Optional: CHROME_EXTENSION_ID, EDGE_EXTENSION_ID (store ids; the build's own ids are the default).
  Literal values that must match the code (service name, hub port, host name, generated file names) are checked by
  tests/WebFilter.Service.Tests/InstallerTests.cs.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:fw="http://wixtoolset.org/schemas/v4/wxs/firewall"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">
  <Package Name="WebFilter" Manufacturer="WebFilter" Version="$(var.ProductVersion)"
           UpgradeCode="46A1BD2D-B5F1-4861-8EB4-8DE387BCCB15" Scope="perMachine" Language="!(loc.ProductLanguage)">
    <!--
      The old version is removed inside the transaction (after InstallInitialize), so CloseNotifiers, a deferred action
      running as LocalSystem, can end running notifiers in every session before any file is removed or replaced.
    -->
    <MajorUpgrade Schedule="afterInstallInitialize" DowngradeErrorMessage="!(loc.DowngradeError)" />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <!--
      Install-time settings, remembered in HKLM\SOFTWARE\WebFilter for repair and upgrade.
      ROLE: remembered > command line or setup dialog > "hub" — a computer keeps its role; changing it means uninstalling
      (which deletes the data) and installing again. Extension ids: command line > this build's ids > remembered.
    -->
    <Property Id="ROLE" Value="hub" Secure="yes">
      <RegistrySearch Id="RememberedRole" Root="HKLM" Key="SOFTWARE\WebFilter" Name="Role" Type="raw" Bitness="always64" />
    </Property>
    <Property Id="CHROME_EXTENSION_ID" Secure="yes">
      <RegistrySearch Id="RememberedChromeId" Root="HKLM" Key="SOFTWARE\WebFilter" Name="ChromeExtensionId" Type="raw" Bitness="always64" />
    </Property>
    <Property Id="EDGE_EXTENSION_ID" Secure="yes">
      <RegistrySearch Id="RememberedEdgeId" Root="HKLM" Key="SOFTWARE\WebFilter" Name="EdgeExtensionId" Type="raw" Bitness="always64" />
    </Property>
    <SetProperty Action="SaveCmdlineChromeId" Id="CMDLINE_CHROME_ID" Value="[CHROME_EXTENSION_ID]" Before="AppSearch" Sequence="first" Condition="CHROME_EXTENSION_ID" />
    <SetProperty Action="SaveCmdlineEdgeId" Id="CMDLINE_EDGE_ID" Value="[EDGE_EXTENSION_ID]" Before="AppSearch" Sequence="first" Condition="EDGE_EXTENSION_ID" />
<?if $(var.ChromeExtensionId) != "" ?>
    <SetProperty Action="BuildChromeId" Id="CHROME_EXTENSION_ID" Value="$(var.ChromeExtensionId)" After="AppSearch" Sequence="first" />
<?endif?>
<?if $(var.EdgeExtensionId) != "" ?>
    <SetProperty Action="BuildEdgeId" Id="EDGE_EXTENSION_ID" Value="$(var.EdgeExtensionId)" After="AppSearch" Sequence="first" />
<?endif?>
    <SetProperty Action="RestoreCmdlineChromeId" Id="CHROME_EXTENSION_ID" Value="[CMDLINE_CHROME_ID]" After="LaunchConditions" Sequence="first" Condition="CMDLINE_CHROME_ID" />
    <SetProperty Action="RestoreCmdlineEdgeId" Id="EDGE_EXTENSION_ID" Value="[CMDLINE_EDGE_ID]" After="LaunchConditions" Sequence="first" Condition="CMDLINE_EDGE_ID" />

    <!-- Agent pairing (optional): the hub's address and a code from the hub's Devices screen. -->
    <Property Id="HUB" Secure="yes" />
    <Property Id="PAIRCODE" Secure="yes" Hidden="yes" />
    <Property Id="PairWithHub" Hidden="yes" />

    <Launch Condition="Installed OR REMOVE~=&quot;ALL&quot; OR ROLE~=&quot;hub&quot; OR ROLE~=&quot;agent&quot;" Message="!(loc.RoleInvalid)" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="WebFilter" />
    </StandardDirectory>
    <StandardDirectory Id="CommonAppDataFolder">
      <Directory Id="DATAFOLDER" Name="WebFilter" />
    </StandardDirectory>

    <Feature Id="WebFilter" Title="WebFilter" AllowAbsent="no">
      <ComponentGroupRef Id="Payload" />
      <ComponentRef Id="Service" />
      <ComponentRef Id="Admin" />
      <ComponentRef Id="WfpNative" />
      <ComponentRef Id="NativeHostRegistration" />
      <ComponentRef Id="InstallState" />
      <ComponentRef Id="DataFolder" />
      <ComponentRef Id="HubFirewall" />
      <ComponentRef Id="Notifier" />
      <ComponentRef Id="NotifierAutostart" />
    </Feature>

    <!-- Everything published, except the files authored below and appsettings*.json (generated by `configure`). -->
    <ComponentGroup Id="Payload" Directory="INSTALLFOLDER">
      <Files Include="$(var.PayloadDir)**">
        <Exclude Files="$(var.PayloadDir)WebFilter.Service.exe" />
        <Exclude Files="$(var.PayloadDir)WebFilter.Admin.exe" />
        <Exclude Files="$(var.PayloadDir)WebFilter.Notifier.exe" />
        <Exclude Files="$(var.PayloadDir)WebFilter.Wfp.Native.dll" />
        <Exclude Files="$(var.PayloadDir)appsettings*.json" />
        <Exclude Files="$(var.PayloadDir)**\*.pdb" />
      </Files>
    </ComponentGroup>

    <!-- The service: LocalSystem, automatic start, restarted on failure, also in Safe Mode with Networking (MVP-PLAN §4.2). -->
    <Component Id="Service" Directory="INSTALLFOLDER">
      <File Id="ServiceExe" Source="$(var.PayloadDir)WebFilter.Service.exe" KeyPath="yes" />
      <ServiceInstall Id="Service" Name="WebFilter" DisplayName="WebFilter" Description="!(loc.ServiceDescription)"
                      Type="ownProcess" Start="auto" ErrorControl="normal" Account="LocalSystem" Vital="yes">
        <!-- Recovery: restart whenever the process ends without a clean stop (crash, kill). -->
        <util:ServiceConfig FirstFailureActionType="restart" SecondFailureActionType="restart" ThirdFailureActionType="restart"
                            RestartServiceDelayInSeconds="10" ResetPeriodInDays="1" />
      </ServiceInstall>
      <ServiceControl Id="Service" Name="WebFilter" Start="install" Stop="both" Remove="uninstall" Wait="yes" />
      <RegistryKey Root="HKLM" Key="SYSTEM\CurrentControlSet\Control\SafeBoot\Network\WebFilter" ForceDeleteOnUninstall="yes">
        <RegistryValue Type="string" Value="Service" />
      </RegistryKey>
    </Component>

    <Component Id="Admin" Directory="INSTALLFOLDER">
      <File Id="AdminExe" Source="$(var.PayloadDir)WebFilter.Admin.exe" KeyPath="yes">
        <Shortcut Id="AdminShortcut" Directory="ProgramMenuFolder" Name="!(loc.AdminShortcutName)"
                  Description="!(loc.AdminShortcutDescription)" WorkingDirectory="INSTALLFOLDER" Advertise="yes" />
      </File>
    </Component>

    <!--
      The parents' notifications in the tray (PROTECTION-SPEC §10). Installed with the rest; started at logon only on the hub
      (NotifierAutostart), where the service serves the notify pipe.
    -->
    <Component Id="Notifier" Directory="INSTALLFOLDER">
      <File Id="NotifierExe" Source="$(var.PayloadDir)WebFilter.Notifier.exe" KeyPath="yes" />
    </Component>

    <!--
      Hub only: the notifier starts at logon for every user (HKLM Run). It exits at once for anyone the service does not
      answer as an administrator, so children's accounts on the hub computer see nothing. Removed with the component. The path
      is spelt out rather than [#NotifierExe], which another component owns (ICE69).
    -->
    <Component Id="NotifierAutostart" Directory="INSTALLFOLDER" Condition="ROLE~=&quot;hub&quot;" Transitive="yes">
      <RegistryValue Root="HKLM" Key="SOFTWARE\Microsoft\Windows\CurrentVersion\Run" Name="WebFilter Notifier" Type="string"
                     Value="&quot;[INSTALLFOLDER]WebFilter.Notifier.exe&quot;" KeyPath="yes" />
    </Component>


    <!--
      The WFP engine (MVP-PLAN §5.3), loaded by the service from its own folder. Named here rather than left to the
      payload wildcard, so an MSI cannot be built without it. The .wixproj builds it from src/WebFilter.Wfp.Native.
    -->
    <Component Id="WfpNative" Directory="INSTALLFOLDER">
      <File Id="WfpNativeDll" Source="$(var.PayloadDir)WebFilter.Wfp.Native.dll" KeyPath="yes" />
    </Component>

    <!--
      Chrome and Edge find the native host through these keys (MVP-PLAN §4.3). The manifest, like appsettings.json, is
      written by `WebFilter.Service configure`, so the MSI removes both on uninstall itself.
    -->
    <Component Id="NativeHostRegistration" Directory="INSTALLFOLDER">
      <RegistryKey Root="HKLM" Key="SOFTWARE\Google\Chrome\NativeMessagingHosts\com.webfilter.host" ForceDeleteOnUninstall="yes">
        <RegistryValue Type="string" Value="[INSTALLFOLDER]com.webfilter.host.json" KeyPath="yes" />
      </RegistryKey>
      <RegistryKey Root="HKLM" Key="SOFTWARE\Microsoft\Edge\NativeMessagingHosts\com.webfilter.host" ForceDeleteOnUninstall="yes">
        <RegistryValue Type="string" Value="[INSTALLFOLDER]com.webfilter.host.json" />
      </RegistryKey>
      <RemoveFile Id="HostManifest" Name="com.webfilter.host.json" On="uninstall" />
      <RemoveFile Id="AppSettings" Name="appsettings.json" On="uninstall" />
      <RemoveFile Id="GeneratedTemp" Name="*.tmp" On="uninstall" />
    </Component>

    <Component Id="InstallState" Directory="INSTALLFOLDER">
      <RegistryKey Root="HKLM" Key="SOFTWARE\WebFilter" ForceDeleteOnUninstall="yes">
        <RegistryValue Name="Role" Type="string" Value="[ROLE]" KeyPath="yes" />
        <RegistryValue Name="ChromeExtensionId" Type="string" Value="[CHROME_EXTENSION_ID]" />
        <RegistryValue Name="EdgeExtensionId" Type="string" Value="[EDGE_EXTENSION_ID]" />
      </RegistryKey>
    </Component>

    <!--
      %ProgramData%\WebFilter (settings, usage, pairing keys, profile caches): SYSTEM and Administrators only. Each profile
      cache file grants its own account read access itself (ProfileCacheWriter). Deleted on uninstall by `cleanup`.
    -->
    <Component Id="DataFolder" Directory="DATAFOLDER" Guid="C3D1F326-E333-43AF-B042-ACB2FA9E42DC">
      <CreateFolder>
        <PermissionEx Sddl="D:PAI(A;OICI;FA;;;SY)(A;OICI;FA;;;BA)" />
      </CreateFolder>
    </Component>

    <!-- Hub only: agents connect to TCP 47800 (HubApi.DefaultPort), from Private networks only. -->
    <Component Id="HubFirewall" Directory="INSTALLFOLDER" Condition="ROLE~=&quot;hub&quot;" Transitive="yes">
      <fw:FirewallException Id="HubPort" Name="WebFilter Hub" Description="!(loc.FirewallDescription)"
                            Program="[#ServiceExe]" Port="47800" Protocol="tcp" Profile="private" Scope="any" />
      <RegistryValue Root="HKLM" Key="SOFTWARE\WebFilter" Name="HubFirewallRule" Type="integer" Value="1" KeyPath="yes" />
    </Component>

    <!--
      Custom actions run WebFilter.Service.exe as LocalSystem (deferred, no impersonation), except the notifier's; WixQuietExec
      writes their output to the MSI log.
        configure  install, repair, upgrade: appsettings.json + host manifest, before the service starts.
        pair       agent with HUB and PAIRCODE: pairs with the hub. A failure does not fail the install (pair later).
        cleanup    uninstall (not the removal of an old version during upgrade), after the service stopped: browser
                   policies in HKLM and every user's hive, WFP filters, %ProgramData%\WebFilter. Best effort.
        unregister WebFilter.Notifier.exe's own switch. Uninstall on the hub (not during upgrade), before its files go,
                   as the user who uninstalls (impersonated, so their HKCU): their toasts and the notifier's toast
                   registration (PROTECTION-SPEC §10). Other users' keys stay; they only name the deleted exe
                   (installer/README.md). Best effort.
    -->
    <SetProperty Id="ConfigureService" Sequence="execute" Before="ConfigureService"
                 Value="&quot;[INSTALLFOLDER]WebFilter.Service.exe&quot; configure --role &quot;[ROLE]&quot; --chrome-extension-id &quot;[CHROME_EXTENSION_ID]&quot; --edge-extension-id &quot;[EDGE_EXTENSION_ID]&quot;" />
    <CustomAction Id="ConfigureService" BinaryRef="Wix4UtilCA_X64" DllEntry="WixQuietExec" Execute="deferred" Impersonate="no" Return="check" />

    <SetProperty Id="PairWithHub" Sequence="execute" Before="PairWithHub"
                 Value="&quot;[INSTALLFOLDER]WebFilter.Service.exe&quot; pair --hub &quot;[HUB]&quot; --code &quot;[PAIRCODE]&quot;" />
    <!-- HideTarget: the command line carries the pairing code; keep it out of the MSI log. -->
    <CustomAction Id="PairWithHub" BinaryRef="Wix4UtilCA_X64" DllEntry="WixQuietExec" Execute="deferred" Impersonate="no" Return="ignore" HideTarget="yes" />

    <SetProperty Id="CleanupMachine" Sequence="execute" Before="CleanupMachine"
                 Value="&quot;[INSTALLFOLDER]WebFilter.Service.exe&quot; cleanup" />
    <CustomAction Id="CleanupMachine" BinaryRef="Wix4UtilCA_X64" DllEntry="WixQuietExec" Execute="deferred" Impersonate="no" Return="ignore" />

    <SetProperty Id="UnregisterNotifier" Sequence="execute" Before="UnregisterNotifier"
                 Value="&quot;[INSTALLFOLDER]WebFilter.Notifier.exe&quot; --unregister" />
    <CustomAction Id="UnregisterNotifier" BinaryRef="Wix4UtilCA_X64" DllEntry="WixQuietExec" Execute="deferred" Impersonate="yes" Return="ignore" />

    <!--
      Upgrade, repair and uninstall: a notifier running in a signed-in session holds its files, and Restart Manager cannot
      close a tray app in another session, so the files would be left for a reboot (a silent upgrade then restarts the
      computer, seen in the lab on 2026-10-23). It is ended first, as LocalSystem in every session, before the old version
      is removed. It holds nothing that matters: its cursor is saved after every notification. Not found = nothing to do.
    -->
    <SetProperty Id="CloseNotifiers" Sequence="execute" Before="CloseNotifiers"
                 Value="&quot;[System64Folder]taskkill.exe&quot; /F /IM WebFilter.Notifier.exe" />
    <CustomAction Id="CloseNotifiers" BinaryRef="Wix4UtilCA_X64" DllEntry="WixQuietExec" Execute="deferred" Impersonate="no" Return="ignore" />

    <!--
      After an install or upgrade a parent ran with the full UI on the hub, the notifier starts again at once in their
      session, unelevated (the UI sequence runs in the parent's own process), instead of at the next logon. Silent installs
      leave it to the Run value. It exits by itself for anyone the service does not answer as an administrator.
    -->
    <SetProperty Id="WixShellExecTarget" Sequence="ui" Before="StartNotifier" Value="[#NotifierExe]" />
    <CustomAction Id="StartNotifier" BinaryRef="Wix4UtilCA_X64" DllEntry="WixShellExec" Execute="immediate" Return="ignore" />

    <InstallExecuteSequence>
      <Custom Action="CloseNotifiers" Before="RemoveExistingProducts" Condition="Installed OR WIX_UPGRADE_DETECTED" />
      <Custom Action="ConfigureService" After="InstallFiles" Condition="NOT REMOVE~=&quot;ALL&quot;" />
      <Custom Action="PairWithHub" After="ConfigureService" Condition="NOT REMOVE~=&quot;ALL&quot; AND ROLE~=&quot;agent&quot; AND HUB AND PAIRCODE" />
      <Custom Action="CleanupMachine" Before="RemoveFiles" Condition="REMOVE~=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
      <Custom Action="UnregisterNotifier" Before="RemoveFiles" Condition="REMOVE~=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE AND ROLE~=&quot;hub&quot;" />
    </InstallExecuteSequence>

    <InstallUISequence>
      <Custom Action="StartNotifier" After="ExecuteAction" Condition="ROLE~=&quot;hub&quot; AND NOT REMOVE~=&quot;ALL&quot;" />
    </InstallUISequence>

    <UIRef Id="WebFilterUI" />
  </Package>
</Wix>
