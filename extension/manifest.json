{
  "manifest_version": 3,
  "name": "WebFilter",
  "version": "0.0.0",
  "description": "__MSG_extDescription__",
  "default_locale": "en",
  "minimum_chrome_version": "120",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "__MSG_actionTitle__",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "nativeMessaging",
    "declarativeNetRequest",
    "storage",
    "alarms",
    "idle",
    "tabs",
    "notifications",
    "webNavigation"
  ],
  "host_permissions": ["<all_urls>"],
  "declarative_net_request": {
    "rule_resources": [
      { "id": "failclosed", "enabled": true, "path": "rulesets/failclosed.json" },
      { "id": "ads", "enabled": false, "path": "rulesets/ads.json" }
    ]
  },
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*", "*://*.youtube-nocookie.com/*"],
      "js": ["yt-main.js"],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    },
    {
      "matches": ["*://*.youtube.com/*", "*://*.youtube-nocookie.com/*"],
      "js": ["yt-bridge.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "blocked.html",
        "blocked.js",
        "timeup.html",
        "timeup.js",
        "my-channels.html",
        "my-channels.js",
        "pages.css",
        "icons/*"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
