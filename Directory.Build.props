<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <Product>WebFilter</Product>
    <Company>WebFilter</Company>
  </PropertyGroup>

  <!-- Simulation builds expose SimulationHooks (controllable clock, test pipe). Never shipped. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Simulation'">
    <DefineConstants>$(DefineConstants);SIMULATION</DefineConstants>
    <Optimize>false</Optimize>
  </PropertyGroup>
</Project>
