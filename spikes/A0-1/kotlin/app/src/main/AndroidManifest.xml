<?xml version="1.0" encoding="utf-8"?>
<!-- Spike A0.1. testOnly lets `adb install -t` install it and lets `dpm remove-active-admin` remove the owner. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:label="A0.1 DPC"
        android:allowBackup="false"
        android:testOnly="true">

        <receiver
            android:name=".AdminReceiver"
            android:exported="true"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>

        <!-- Test harness entry point, driven by `adb shell am broadcast -n`. -->
        <receiver
            android:name=".CmdReceiver"
            android:exported="true" />
    </application>
</manifest>
