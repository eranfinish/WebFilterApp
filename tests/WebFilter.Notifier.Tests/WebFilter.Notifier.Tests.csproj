<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- The notifier assembly references Windows Forms; the classes under test need no window or message loop. -->
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\WebFilter.Notifier\WebFilter.Notifier.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\src\WebFilter.Notifier\Resources\Strings.resx" Link="Resources\Strings.resx" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\src\WebFilter.Notifier\Resources\Strings.en.resx" Link="Resources\Strings.en.resx" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
