{
  "$schema": "../../schema/scenario.schema.json",
  "suite": "access-requests",
  "description": "Child requests access from the block page; the parent approves (minutes / today / always, site or page) or denies. Merging, rate limiting, cooldown, offline queueing.",
  "layers": ["engine", "integration", "browser"],
  "platforms": ["windows", "android"],
  "scenarios": [
    {
      "id": "AR-001",
      "title": "A site request approved for 15 minutes opens the whole site, then expires",
      "start": "2026-11-01T16:00",
      "steps": [
        { "do": "navigate", "member": "noa", "url": "https://pbskids.org/games", "expect": { "decision": "block", "reason": "blocked_not_in_allowlist" } },
        { "do": "requestAccess", "member": "noa", "kind": "url", "target": "https://pbskids.org/games", "message": "משחק חשבון מהמורה", "as": "r1", "expect": { "result": "created" } },
        { "do": "expectEvents", "type": "access_request", "member": "noa", "expect": { "count": 1 } },
        { "do": "expectRequests", "status": "pending", "expect": { "count": 1, "items": [ { "request": "r1", "kind": "url", "targetKey": "pbskids.org", "message": "משחק חשבון מהמורה" } ] } },
        { "do": "admin", "at": "16:05", "action": "approveRequest", "request": "r1", "minutes": 15 },
        { "do": "expectEvents", "type": "admin_change", "member": "noa", "expect": { "count": 1 } },
        { "do": "expectRequests", "status": "pending", "expect": { "count": 0 } },
        { "do": "navigate", "member": "noa", "url": "https://pbskids.org/games", "expect": { "decision": "allow", "reason": "allowed_rule" } },
        { "do": "navigate", "member": "noa", "url": "https://www.pbskids.org/videos", "expect": { "decision": "allow", "reason": "allowed_rule" }, "note": "site scope covers subdomains" },
        { "do": "navigate", "at": "16:19", "member": "noa", "url": "https://pbskids.org/games", "expect": { "decision": "allow", "reason": "allowed_rule" } },
        { "do": "navigate", "at": "16:20", "member": "noa", "url": "https://pbskids.org/games", "expect": { "decision": "block", "reason": "blocked_not_in_allowlist" } }
      ]
    },
    {
      "id": "AR-002",
      "title": "Approval until the end of the day overrides a blocked category until local midnight",
      "start": "2026-11-01T17:00",
      "steps": [
        { "do": "navigate", "member": "yoav", "url": "https://www.instagram.com/", "expect": { "decision": "block", "reason": "blocked_category" } },
        { "do": "requestAccess", "member": "yoav", "kind": "url", "target": "https://www.instagram.com/explore", "as": "r1", "expect": { "result": "created" } },
        { "do": "expectRequests", "expect": { "items": [ { "request": "r1", "status": "pending", "targetKey": "instagram.com" } ] }, "note": "www. is stripped from the target key" },
        { "do": "admin", "action": "approveRequest", "request": "r1", "duration": "today" },
        { "do": "navigate", "at": "21:00", "member": "yoav", "url": "https://www.instagram.com/", "expect": { "decision": "allow", "reason": "allowed_rule" } },
        { "do": "navigate", "at": "2026-11-02T15:00", "member": "yoav", "url": "https://www.instagram.com/", "expect": { "decision": "block", "reason": "blocked_category" } }
      ]
    },
    {
      "id": "AR-003",
      "title": "A page-scoped approval opens only that page and what is under it, permanently",
      "start": "2026-11-01T16:00",
      "steps": [
        { "do": "requestAccess", "member": "noa", "kind": "url", "target": "https://worksheets.example/math/grade2?id=7", "as": "r1", "expect": { "result": "created" } },
        { "do": "admin", "action": "approveRequest", "request": "r1", "approveAs": "page", "duration": "always" },
        { "do": "checkUrls", "member": "noa", "cases": [
          { "url": "https://worksheets.example/math/grade2",         "expect": { "decision": "allow", "reason": "allowed_rule" } },
          { "url": "https://worksheets.example/math/grade2/page2",   "expect": { "decision": "allow", "reason": "allowed_rule" } },
          { "url": "https://worksheets.example/math/grade2b",        "expect": { "decision": "block", "reason": "blocked_not_in_allowlist" }, "note": "segment boundary" },
          { "url": "https://worksheets.example/games",               "expect": { "decision": "block", "reason": "blocked_not_in_allowlist" } }
        ] },
        { "do": "navigate", "at": "2026-11-02T16:00", "member": "noa", "url": "https://worksheets.example/math/grade2?id=9", "expect": { "decision": "allow", "reason": "allowed_rule" }, "note": "no expiry; the query string is not part of the rule" }
      ]
    },
    {
      "id": "AR-004",
      "title": "After a denial the same site cannot be requested again for 60 minutes",
      "start": "2026-11-01T16:00",
      "steps": [
        { "do": "requestAccess", "member": "noa", "kind": "url", "target": "https://www.roblox.com/", "as": "r1", "expect": { "result": "created" } },
        { "do": "admin", "at": "16:02", "action": "denyRequest", "request": "r1" },
        { "do": "expectRequests", "expect": { "items": [ { "request": "r1", "status": "denied" } ] } },
        { "do": "navigate", "member": "noa", "url": "https://www.roblox.com/", "expect": { "decision": "block", "reason": "blocked_not_in_allowlist" } },
        { "do": "requestAccess", "at": "16:30", "member": "noa", "kind": "url", "target": "https://roblox.com/games", "expect": { "result": "cooldown" } },
        { "do": "requestAccess", "at": "17:02", "member": "noa", "kind": "url", "target": "https://roblox.com/games", "as": "r2", "expect": { "result": "created" } }
      ]
    },
    {
      "id": "AR-005",
      "title": "Repeated requests merge, and at most 5 new requests are accepted per rolling hour",
      "start": "2026-11-01T16:00",
      "steps": [
        { "do": "requestAccess", "member": "yoav", "kind": "url", "target": "https://a.example/", "as": "r1", "expect": { "result": "created" } },
        { "do": "requestAccess", "at": "16:01", "member": "yoav", "kind": "url", "target": "https://www.a.example/page", "expect": { "result": "merged", "sameAs": "r1" } },
        { "do": "requestAccess", "at": "16:02", "member": "yoav", "kind": "url", "target": "https://b.example/", "as": "r2", "expect": { "result": "created" } },
        { "do": "requestAccess", "at": "16:03", "member": "yoav", "kind": "url", "target": "https://c.example/", "as": "r3", "expect": { "result": "created" } },
        { "do": "requestAccess", "at": "16:04", "member": "yoav", "kind": "url", "target": "https://d.example/", "as": "r4", "expect": { "result": "created" } },
        { "do": "requestAccess", "at": "16:05", "member": "yoav", "kind": "url", "target": "https://e.example/", "as": "r5", "expect": { "result": "created" } },
        { "do": "requestAccess", "at": "16:06", "member": "yoav", "kind": "url", "target": "https://f.example/", "expect": { "result": "rate_limited" } },
        { "do": "expectRequests", "member": "yoav", "status": "pending", "expect": { "count": 5 } },
        { "do": "requestAccess", "at": "17:01", "member": "yoav", "kind": "url", "target": "https://f.example/", "as": "r6", "expect": { "result": "created" }, "note": "r1 (16:00) has left the 60-minute window" },
        { "do": "expectRequests", "member": "yoav", "status": "pending", "expect": { "count": 6 } }
      ]
    },
    {
      "id": "AR-006",
      "title": "Requesting a YouTube channel adds it to the approved channels",
      "platforms": ["windows"],
      "start": "2026-11-01T16:00",
      "steps": [
        { "do": "youtube", "member": "noa", "page": { "url": "https://www.youtube.com/watch?v=vidNatg0001", "channelId": "UCnatgeoKids000000000004" }, "expect": { "decision": "block", "reason": "blocked_youtube_channel" } },
        { "do": "requestAccess", "member": "noa", "kind": "youtube", "target": "UCnatgeoKids000000000004", "as": "r1", "expect": { "result": "created" } },
        { "do": "admin", "action": "approveRequest", "request": "r1", "duration": "always" },
        { "do": "youtube", "member": "noa", "page": { "url": "https://www.youtube.com/watch?v=vidNatg0001", "channelId": "UCnatgeoKids000000000004" }, "expect": { "decision": "allow", "reason": "allowed_youtube_channel" } }
      ]
    },
    {
      "id": "AR-007",
      "title": "A request for more time can be approved for less than was asked",
      "start": "2026-11-01T15:00",
      "steps": [
        { "do": "browse", "sessions": [ { "member": "noa", "from": "15:00", "to": "17:00" } ] },
        { "do": "requestAccess", "at": "17:01", "member": "noa", "kind": "time", "minutes": 30, "as": "r1", "expect": { "result": "created" } },
        { "do": "admin", "at": "17:03", "action": "approveRequest", "request": "r1", "minutes": 15 },
        { "do": "expectTime", "member": "noa", "state": "ok", "usedMinutes": 120, "limitMinutes": 135, "remainingMinutes": 15 }
      ]
    },
    {
      "id": "AR-008",
      "title": "Requesting a blocked app adds it to the member's approved apps",
      "platforms": ["windows"],
      "start": "2026-11-01T16:00",
      "steps": [
        { "do": "app", "member": "yoav", "device": "pc-kids", "app": { "path": "C:\\Users\\yoav\\AppData\\Local\\Discord\\app-1.0.9\\Discord.exe" }, "expect": { "decision": "block", "reason": "blocked_app_network" } },
        { "do": "requestAccess", "member": "yoav", "device": "pc-kids", "kind": "app", "target": "C:\\Users\\yoav\\AppData\\Local\\Discord\\app-1.0.9\\Discord.exe", "as": "r1", "expect": { "result": "created" } },
        { "do": "admin", "action": "approveRequest", "request": "r1", "duration": "always" },
        { "do": "app", "member": "yoav", "device": "pc-kids", "app": { "path": "C:\\Users\\yoav\\AppData\\Local\\Discord\\app-1.0.9\\Discord.exe" }, "expect": { "decision": "allow", "reason": "allowed_rule" } }
      ]
    },
    {
      "id": "AR-009",
      "title": "A request made while the hub is unreachable is queued and delivered on reconnect; the approval applies on every computer",
      "layers": ["engine", "integration"],
      "start": "2026-11-02T15:00",
      "steps": [
        { "do": "network", "device": "laptop-yoav", "hub": "offline" },
        { "do": "requestAccess", "member": "yoav", "device": "laptop-yoav", "kind": "url", "target": "https://www.instagram.com/", "as": "r1", "expect": { "result": "queued" } },
        { "do": "expectRequests", "expect": { "count": 0 } },
        { "do": "expectRequests", "device": "laptop-yoav", "expect": { "count": 1, "items": [ { "request": "r1", "status": "pending" } ] } },
        { "do": "network", "at": "15:10", "device": "laptop-yoav", "hub": "online" },
        { "do": "expectRequests", "expect": { "count": 1, "items": [ { "request": "r1", "status": "pending" } ] } },
        { "do": "admin", "action": "approveRequest", "request": "r1", "minutes": 30 },
        { "do": "navigate", "member": "yoav", "device": "laptop-yoav", "url": "https://www.instagram.com/", "expect": { "decision": "allow", "reason": "allowed_rule" } },
        { "do": "navigate", "member": "yoav", "device": "pc-kids",     "url": "https://www.instagram.com/", "expect": { "decision": "allow", "reason": "allowed_rule" } }
      ]
    },
    {
      "id": "AR-010",
      "title": "No requests can be made while the agent service is down",
      "platforms": ["windows"],
      "start": "2026-11-01T16:00",
      "steps": [
        { "do": "service", "device": "pc-kids", "state": "down" },
        { "do": "requestAccess", "member": "noa", "device": "pc-kids", "kind": "url", "target": "https://pbskids.org/", "expect": { "result": "unavailable" } }
      ]
    }
  ]
}
