{
  "$schema": "../../schema/scenario.schema.json",
  "suite": "youtube-decisions",
  "description": "YouTube decisions per member mode. 'page' is what the content script sees: the URL plus any channel identity found in the page data.",
  "layers": ["engine", "browser"],
  "platforms": ["windows"],
  "scenarios": [
    {
      "id": "YT-001",
      "title": "Allowlist mode: only approved channels play; home and search go to 'my channels'",
      "start": "2026-11-01T16:00",
      "steps": [
        { "do": "youtube", "member": "noa", "page": { "url": "https://www.youtube.com/watch?v=vidKhan0001", "channelId": "UCkhanKids00000000000001" }, "expect": { "decision": "allow", "reason": "allowed_youtube_channel" } },
        { "do": "youtube", "member": "noa", "page": { "url": "https://www.youtube.com/watch?v=vidGamr0001", "channelId": "UCgamerX0000000000000003" }, "expect": { "decision": "block", "reason": "blocked_youtube_channel" } },
        { "do": "youtube", "member": "noa", "page": { "url": "https://www.youtube.com/watch?v=vidNone0001" }, "expect": { "decision": "block", "reason": "blocked_youtube_unknown" }, "note": "no channel identity in the page" },
        { "do": "youtube", "member": "noa", "page": { "url": "https://www.youtube.com/channel/UCsesame0000000000000002" }, "expect": { "decision": "allow", "reason": "allowed_youtube_channel" } },
        { "do": "youtube", "member": "noa", "page": { "url": "https://www.youtube.com/@sesame-sim", "channelId": "UCsesame0000000000000002" }, "expect": { "decision": "allow", "reason": "allowed_youtube_channel" } },
        { "do": "youtube", "member": "noa", "page": { "url": "https://www.youtube.com/@Sesame-Sim", "handle": "@sesame-sim" }, "expect": { "decision": "allow", "reason": "allowed_youtube_channel" }, "note": "matched by the stored handle" },
        { "do": "youtube", "member": "noa", "page": { "url": "https://www.youtube.com/shorts/vidShrt0001", "channelId": "UCgamerX0000000000000003" }, "expect": { "decision": "block", "reason": "blocked_youtube_channel" } },
        { "do": "youtube", "member": "noa", "page": { "url": "https://www.youtube.com/" }, "expect": { "decision": "redirect", "reason": "redirect_youtube_home" } },
        { "do": "youtube", "member": "noa", "page": { "url": "https://www.youtube.com/results?search_query=dinosaurs" }, "expect": { "decision": "redirect", "reason": "redirect_youtube_home" } }
      ]
    },
    {
      "id": "YT-002",
      "title": "Allowlist mode: embeds play only for approved channels",
      "start": "2026-11-01T16:00",
      "steps": [
        { "do": "youtube", "member": "noa", "page": { "url": "https://www.youtube.com/embed/vidKhan0001", "frame": "sub", "parentUrl": "https://www.khanacademy.org/math/1", "channelId": "UCkhanKids00000000000001" }, "expect": { "decision": "allow", "reason": "allowed_youtube_channel" } },
        { "do": "youtube", "member": "noa", "page": { "url": "https://www.youtube-nocookie.com/embed/vidOthr0001", "frame": "sub", "parentUrl": "https://www.khanacademy.org/math/2" }, "expect": { "decision": "block", "reason": "blocked_youtube_unknown" } }
      ]
    },
    {
      "id": "YT-003",
      "title": "An approved channel is still subject to the daily limit",
      "start": "2026-11-01T15:00",
      "steps": [
        { "do": "browse", "sessions": [ { "member": "noa", "from": "15:00", "to": "17:00" } ] },
        { "do": "youtube", "member": "noa", "page": { "url": "https://www.youtube.com/watch?v=vidKhan0001", "channelId": "UCkhanKids00000000000001" }, "expect": { "decision": "block", "reason": "blocked_daily_limit" } }
      ]
    },
    {
      "id": "YT-004",
      "title": "Restricted mode: everything except blocked channels, no identification required",
      "start": "2026-11-01T16:00",
      "steps": [
        { "do": "youtube", "member": "yoav", "page": { "url": "https://www.youtube.com/watch?v=vidGamr0001", "channelId": "UCgamerX0000000000000003" }, "expect": { "decision": "block", "reason": "blocked_youtube_channel" } },
        { "do": "youtube", "member": "yoav", "page": { "url": "https://www.youtube.com/@gamerx-sim", "handle": "@gamerx-sim" }, "expect": { "decision": "block", "reason": "blocked_youtube_channel" } },
        { "do": "youtube", "member": "yoav", "page": { "url": "https://www.youtube.com/watch?v=vidNatg0001", "channelId": "UCnatgeoKids000000000004" }, "expect": { "decision": "allow", "reason": "allowed_default" } },
        { "do": "youtube", "member": "yoav", "page": { "url": "https://www.youtube.com/watch?v=vidNone0001" }, "expect": { "decision": "allow", "reason": "allowed_default" } },
        { "do": "youtube", "member": "yoav", "page": { "url": "https://www.youtube.com/" }, "expect": { "decision": "allow", "reason": "allowed_default" } }
      ]
    },
    {
      "id": "YT-005",
      "title": "YouTube off: every YouTube host is blocked at the URL level",
      "start": "2026-11-01T16:00",
      "setup": { "members": [ { "id": "yoav", "youtubeMode": "off" } ] },
      "steps": [
        {
          "do": "checkUrls", "member": "yoav",
          "cases": [
            { "url": "https://www.youtube.com/",                            "expect": { "decision": "block", "reason": "blocked_youtube_off" } },
            { "url": "https://m.youtube.com/watch?v=vidKhan0001",           "expect": { "decision": "block", "reason": "blocked_youtube_off" } },
            { "url": "https://youtu.be/vidKhan0001",                        "expect": { "decision": "block", "reason": "blocked_youtube_off" } },
            { "url": "https://www.youtube-nocookie.com/embed/vidKhan0001", "frame": "sub", "expect": { "decision": "block", "reason": "blocked_youtube_off" } }
          ]
        }
      ]
    },
    {
      "id": "YT-006",
      "title": "Unrestricted adults are never filtered on YouTube",
      "start": "2026-11-01T23:00",
      "steps": [
        { "do": "youtube", "member": "dana", "page": { "url": "https://www.youtube.com/watch?v=vidGamr0001", "channelId": "UCgamerX0000000000000003" }, "expect": { "decision": "allow", "reason": "allowed_unrestricted" } }
      ]
    },
    {
      "id": "YT-007",
      "title": "YouTube off does not break Google sign-in: accounts.youtube.com is allowed in every YouTube mode",
      "start": "2026-11-01T16:00",
      "setup": { "members": [ { "id": "yoav", "youtubeMode": "off" }, { "id": "noa", "youtubeMode": "off" } ] },
      "steps": [
        {
          "do": "checkUrls", "member": "yoav",
          "cases": [
            { "url": "https://accounts.youtube.com/accounts/SetSID?ssdc=1", "expect": { "decision": "allow", "reason": "allowed_default" } },
            { "url": "https://www.youtube.com/",                            "expect": { "decision": "block", "reason": "blocked_youtube_off" } },
            { "url": "https://studio.youtube.com/",                         "expect": { "decision": "block", "reason": "blocked_youtube_off" } }
          ]
        },
        {
          "do": "checkUrls", "member": "noa",
          "cases": [
            { "url": "https://accounts.youtube.com/accounts/SetSID?ssdc=1", "expect": { "decision": "allow", "reason": "allowed_default" }, "note": "allowlist mode too: the YouTube handling decides YouTube hosts, and it never blocks the sign-in host" },
            { "url": "https://m.youtube.com/",                              "expect": { "decision": "block", "reason": "blocked_youtube_off" } }
          ]
        }
      ]
    },
    {
      "id": "YT-008",
      "title": "Channel search (allowlist mode): YouTube's results restricted to channels are shown; any other search goes there; channels found are still not approved",
      "start": "2026-11-01T16:00",
      "setup": { "members": [ { "id": "noa", "youTubeChannelSearch": true } ] },
      "steps": [
        { "do": "youtube", "member": "noa", "page": { "url": "https://www.youtube.com/results?search_query=dinosaurs&sp=EgIQAg%253D%253D" }, "expect": { "decision": "allow", "reason": "allowed_default" }, "note": "as YouTube's own 'Channels' filter writes it; the extension hides every result that is not a channel" },
        { "do": "youtube", "member": "noa", "page": { "url": "https://www.youtube.com/results?search_query=dinosaurs&sp=EgIQAg%3D%3D" }, "expect": { "decision": "allow", "reason": "allowed_default" } },
        { "do": "youtube", "member": "noa", "page": { "url": "https://www.youtube.com/results?search_query=dinosaurs" }, "expect": { "decision": "redirect", "reason": "redirect_youtube_channel_search" }, "note": "YouTube's own search box: the same terms, restricted to channels" },
        { "do": "youtube", "member": "noa", "page": { "url": "https://www.youtube.com/results?search_query=dinosaurs&sp=EgIQAQ%253D%253D" }, "expect": { "decision": "redirect", "reason": "redirect_youtube_channel_search" }, "note": "Type: Videos" },
        { "do": "youtube", "member": "noa", "page": { "url": "https://www.youtube.com/results?search_query=dinosaurs&sp=EgIQCQ%253D%253D" }, "expect": { "decision": "redirect", "reason": "redirect_youtube_channel_search" }, "note": "Type: Shorts" },
        { "do": "youtube", "member": "noa", "page": { "url": "https://www.youtube.com/results?search_query=dinosaurs&sp=EgIQAg%253D%253D&sp=CAI%253D" }, "expect": { "decision": "redirect", "reason": "redirect_youtube_channel_search" }, "note": "a second filter" },
        { "do": "youtube", "member": "noa", "page": { "url": "https://m.youtube.com/results?search_query=dinosaurs&sp=EgIQAg%253D%253D" }, "expect": { "decision": "redirect", "reason": "redirect_youtube_channel_search" }, "note": "only on youtube.com, where the extension knows the page" },
        { "do": "youtube", "member": "noa", "page": { "url": "https://music.youtube.com/search?q=dinosaurs" }, "expect": { "decision": "redirect", "reason": "redirect_youtube_channel_search" } },
        { "do": "youtube", "member": "noa", "page": { "url": "https://www.youtube.com/results?sp=EgIQAg%253D%253D" }, "expect": { "decision": "redirect", "reason": "redirect_youtube_home" }, "note": "nothing searched for" },
        { "do": "youtube", "member": "noa", "page": { "url": "https://www.youtube.com/results?search_query=+++" }, "expect": { "decision": "redirect", "reason": "redirect_youtube_home" } },
        { "do": "youtube", "member": "noa", "page": { "url": "https://www.youtube.com/" }, "expect": { "decision": "redirect", "reason": "redirect_youtube_home" } },
        { "do": "youtube", "member": "noa", "page": { "url": "https://www.youtube.com/@natgeokids-sim", "channelId": "UCnatgeoKids000000000004" }, "expect": { "decision": "block", "reason": "blocked_youtube_channel" }, "note": "a channel from the results: a request away" },
        { "do": "youtube", "member": "noa", "page": { "url": "https://www.youtube.com/watch?v=vidKhan0001", "channelId": "UCkhanKids00000000000001" }, "expect": { "decision": "allow", "reason": "allowed_youtube_channel" } }
      ]
    },
    {
      "id": "YT-009",
      "title": "Without channel search a channel-only search goes to 'my channels'; in the restricted mode the switch changes nothing",
      "start": "2026-11-01T16:00",
      "setup": { "members": [ { "id": "yoav", "youTubeChannelSearch": true } ] },
      "steps": [
        { "do": "youtube", "member": "noa", "page": { "url": "https://www.youtube.com/results?search_query=dinosaurs&sp=EgIQAg%253D%253D" }, "expect": { "decision": "redirect", "reason": "redirect_youtube_home" } },
        { "do": "youtube", "member": "yoav", "page": { "url": "https://www.youtube.com/results?search_query=dinosaurs" }, "expect": { "decision": "allow", "reason": "allowed_default" } },
        { "do": "youtube", "member": "yoav", "page": { "url": "https://www.youtube.com/results?search_query=dinosaurs&sp=EgIQAg%253D%253D" }, "expect": { "decision": "allow", "reason": "allowed_default" } }
      ]
    },
    {
      "id": "YT-010",
      "title": "Channel search follows time like every YouTube page",
      "start": "2026-11-01T15:00",
      "setup": { "members": [ { "id": "noa", "youTubeChannelSearch": true } ] },
      "steps": [
        { "do": "browse", "sessions": [ { "member": "noa", "from": "15:00", "to": "17:00" } ] },
        { "do": "youtube", "member": "noa", "page": { "url": "https://www.youtube.com/results?search_query=dinosaurs&sp=EgIQAg%253D%253D" }, "expect": { "decision": "block", "reason": "blocked_daily_limit" } }
      ]
    }
  ]
}
