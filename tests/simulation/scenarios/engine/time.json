{
  "$schema": "../../schema/scenario.schema.json",
  "suite": "time",
  "description": "Time windows, daily limits, warnings, extensions, midnight reset, daylight saving, idle and non-counted browsing.",
  "layers": ["engine", "integration", "browser"],
  "platforms": ["windows", "android"],
  "scenarios": [
    {
      "id": "TIME-001",
      "title": "A window includes its start minute and excludes its end minute",
      "note": "2026-11-01 is a Sunday; noa's window is 15:00-19:00",
      "start": "2026-11-01T14:00",
      "steps": [
        { "do": "navigate",   "at": "14:59", "member": "noa", "url": "https://www.khanacademy.org/", "expect": { "decision": "block", "reason": "blocked_time_window" } },
        { "do": "expectTime", "at": "14:59", "member": "noa", "state": "outside_window", "usedMinutes": 0, "windowEndsAt": null },
        { "do": "navigate",   "at": "15:00", "member": "noa", "url": "https://www.khanacademy.org/", "expect": { "decision": "allow", "reason": "allowed_category" } },
        { "do": "expectTime", "at": "15:00", "member": "noa", "state": "ok", "usedMinutes": 0, "limitMinutes": 120, "remainingMinutes": 120, "windowEndsAt": "19:00" },
        { "do": "navigate",   "at": "18:59", "member": "noa", "url": "https://www.khanacademy.org/", "expect": { "decision": "allow", "reason": "allowed_category" } },
        { "do": "navigate",   "at": "19:00", "member": "noa", "url": "https://www.khanacademy.org/", "expect": { "decision": "block", "reason": "blocked_time_window" } }
      ]
    },
    {
      "id": "TIME-002",
      "title": "Two windows on the same day, with a gap between them",
      "note": "2026-11-06 is a Friday; noa: 09:00-13:00 and 16:00-20:00",
      "start": "2026-11-06T08:00",
      "steps": [
        { "do": "navigate",   "at": "08:59", "member": "noa", "url": "https://scratch.mit.edu/", "expect": { "decision": "block", "reason": "blocked_time_window" } },
        { "do": "navigate",   "at": "09:00", "member": "noa", "url": "https://scratch.mit.edu/", "expect": { "decision": "allow", "reason": "allowed_category" } },
        { "do": "navigate",   "at": "12:59", "member": "noa", "url": "https://scratch.mit.edu/", "expect": { "decision": "allow", "reason": "allowed_category" } },
        { "do": "navigate",   "at": "13:00", "member": "noa", "url": "https://scratch.mit.edu/", "expect": { "decision": "block", "reason": "blocked_time_window" } },
        { "do": "expectTime", "at": "13:30", "member": "noa", "state": "outside_window", "limitMinutes": 180, "windowEndsAt": null },
        { "do": "navigate",   "at": "15:59", "member": "noa", "url": "https://scratch.mit.edu/", "expect": { "decision": "block", "reason": "blocked_time_window" } },
        { "do": "navigate",   "at": "16:00", "member": "noa", "url": "https://scratch.mit.edu/", "expect": { "decision": "allow", "reason": "allowed_category" } },
        { "do": "navigate",   "at": "19:59", "member": "noa", "url": "https://scratch.mit.edu/", "expect": { "decision": "allow", "reason": "allowed_category" } },
        { "do": "navigate",   "at": "20:00", "member": "noa", "url": "https://scratch.mit.edu/", "expect": { "decision": "block", "reason": "blocked_time_window" } }
      ]
    },
    {
      "id": "TIME-003",
      "title": "The daily limit warns at 10, 5 and 1 minutes and then expires, except for always-allowed sites",
      "start": "2026-11-01T15:00",
      "steps": [
        { "do": "browse", "sessions": [ { "member": "noa", "device": "pc-kids", "from": "15:00", "to": "16:52" } ] },
        { "do": "expectTime", "member": "noa", "state": "warn", "usedMinutes": 112, "limitMinutes": 120, "remainingMinutes": 8, "windowEndsAt": "19:00" },
        { "do": "browse", "sessions": [ { "member": "noa", "device": "pc-kids", "from": "16:52", "to": "17:00" } ] },
        {
          "do": "expectEvents", "type": "time_warning", "member": "noa",
          "expect": { "count": 3, "items": [
            { "at": "16:50", "remainingMinutes": 10 },
            { "at": "16:55", "remainingMinutes": 5 },
            { "at": "16:59", "remainingMinutes": 1 }
          ] }
        },
        { "do": "expectEvents", "type": "time_expired", "member": "noa", "expect": { "count": 1, "items": [ { "at": "17:00" } ] } },
        { "do": "expectTime", "member": "noa", "state": "expired", "usedMinutes": 120, "limitMinutes": 120, "remainingMinutes": 0, "windowEndsAt": "19:00" },
        { "do": "navigate", "member": "noa", "url": "https://www.khanacademy.org/", "expect": { "decision": "block", "reason": "blocked_daily_limit" } },
        { "do": "navigate", "member": "noa", "url": "https://mashov.info/",         "expect": { "decision": "allow", "reason": "allowed_always", "ruleId": "r-school" } }
      ]
    },
    {
      "id": "TIME-004",
      "title": "Extra time after the limit expired is usable immediately and expires again",
      "start": "2026-11-01T15:00",
      "steps": [
        { "do": "browse", "sessions": [ { "member": "noa", "from": "15:00", "to": "17:00" } ] },
        { "do": "admin", "at": "17:05", "action": "extendTime", "member": "noa", "minutes": 15 },
        { "do": "expectTime", "member": "noa", "state": "ok", "usedMinutes": 120, "limitMinutes": 135, "remainingMinutes": 15, "windowEndsAt": "19:00" },
        { "do": "navigate", "member": "noa", "url": "https://www.khanacademy.org/", "expect": { "decision": "allow", "reason": "allowed_category" } },
        { "do": "browse", "sessions": [ { "member": "noa", "from": "17:05", "to": "17:20" } ] },
        { "do": "expectTime", "member": "noa", "state": "expired", "usedMinutes": 135, "limitMinutes": 135, "remainingMinutes": 0 },
        { "do": "navigate", "member": "noa", "url": "https://www.khanacademy.org/", "expect": { "decision": "block", "reason": "blocked_daily_limit" } }
      ]
    },
    {
      "id": "TIME-005",
      "title": "Extra time near the end of a window also extends the window for today",
      "note": "2026-11-02 is a Monday",
      "start": "2026-11-02T15:00",
      "steps": [
        { "do": "browse", "sessions": [ { "member": "noa", "from": "15:00", "to": "16:00" } ] },
        { "do": "admin", "at": "18:50", "action": "extendTime", "member": "noa", "minutes": 15 },
        { "do": "expectTime", "member": "noa", "state": "ok", "usedMinutes": 60, "limitMinutes": 135, "remainingMinutes": 75, "windowEndsAt": "19:05" },
        { "do": "navigate", "at": "19:04", "member": "noa", "url": "https://www.khanacademy.org/", "expect": { "decision": "allow", "reason": "allowed_category" } },
        { "do": "navigate", "at": "19:05", "member": "noa", "url": "https://www.khanacademy.org/", "expect": { "decision": "block", "reason": "blocked_time_window" } }
      ]
    },
    {
      "id": "TIME-006",
      "title": "Extra time outside any window opens a temporary window starting now",
      "start": "2026-11-02T20:00",
      "steps": [
        { "do": "admin", "action": "extendTime", "member": "noa", "minutes": 30 },
        { "do": "expectTime", "member": "noa", "state": "ok", "usedMinutes": 0, "limitMinutes": 150, "windowEndsAt": "20:30" },
        { "do": "navigate", "at": "20:10", "member": "noa", "url": "https://www.khanacademy.org/", "expect": { "decision": "allow", "reason": "allowed_category" } },
        { "do": "navigate", "at": "20:30", "member": "noa", "url": "https://www.khanacademy.org/", "expect": { "decision": "block", "reason": "blocked_time_window" } }
      ]
    },
    {
      "id": "TIME-007",
      "title": "Idle browsing is not counted",
      "start": "2026-11-01T15:00",
      "steps": [
        { "do": "browse", "sessions": [ { "member": "noa", "from": "15:00", "to": "16:00", "active": false } ] },
        { "do": "expectTime", "member": "noa", "state": "ok", "usedMinutes": 0, "remainingMinutes": 120 },
        { "do": "browse", "sessions": [ { "member": "noa", "from": "16:00", "to": "16:30" } ] },
        { "do": "expectTime", "member": "noa", "state": "ok", "usedMinutes": 30, "remainingMinutes": 90 }
      ]
    },
    {
      "id": "TIME-008",
      "title": "Only the minutes inside a window are counted",
      "start": "2026-11-01T14:30",
      "steps": [
        { "do": "browse", "sessions": [ { "member": "noa", "from": "14:30", "to": "15:30" } ] },
        { "do": "expectTime", "member": "noa", "state": "ok", "usedMinutes": 30 },
        { "do": "browse", "sessions": [ { "member": "noa", "from": "19:00", "to": "20:00" } ] },
        { "do": "expectTime", "member": "noa", "state": "outside_window", "usedMinutes": 30 }
      ]
    },
    {
      "id": "TIME-009",
      "title": "Usage resets at local midnight and the next day's limits apply",
      "note": "2026-11-05 is a Thursday (240 min), 2026-11-06 a Friday (300 min)",
      "start": "2026-11-05T14:00",
      "steps": [
        { "do": "browse", "sessions": [ { "member": "yoav", "device": "laptop-yoav", "from": "14:00", "to": "18:00" } ] },
        { "do": "expectTime", "member": "yoav", "state": "expired", "usedMinutes": 240, "limitMinutes": 240, "remainingMinutes": 0 },
        { "do": "navigate", "at": "21:00", "member": "yoav", "device": "laptop-yoav", "url": "https://www.wikipedia.org/", "expect": { "decision": "block", "reason": "blocked_daily_limit" } },
        { "do": "expectTime", "at": "2026-11-06T09:00", "member": "yoav", "state": "ok", "usedMinutes": 0, "limitMinutes": 300, "remainingMinutes": 300, "windowEndsAt": "23:00" },
        { "do": "navigate", "member": "yoav", "device": "laptop-yoav", "url": "https://www.wikipedia.org/", "expect": { "decision": "allow", "reason": "allowed_default" } }
      ]
    },
    {
      "id": "TIME-010",
      "title": "Windows follow wall-clock time across the end of daylight saving time",
      "note": "Israel leaves DST on 2026-10-25 at 02:00 (UTC+3 to UTC+2). An engine that keeps the old offset would allow 14:30 as if it were 15:30.",
      "start": "2026-10-24T10:00",
      "steps": [
        { "do": "browse", "sessions": [ { "member": "noa", "from": "10:00", "to": "10:30" } ] },
        { "do": "expectTime", "member": "noa", "state": "ok", "usedMinutes": 30, "limitMinutes": 180, "windowEndsAt": "20:00" },
        { "do": "navigate", "at": "2026-10-25T14:30", "member": "noa", "url": "https://www.khanacademy.org/", "expect": { "decision": "block", "reason": "blocked_time_window" } },
        { "do": "navigate", "at": "2026-10-25T15:00", "member": "noa", "url": "https://www.khanacademy.org/", "expect": { "decision": "allow", "reason": "allowed_category" } },
        { "do": "expectTime", "member": "noa", "state": "ok", "usedMinutes": 0, "limitMinutes": 120, "windowEndsAt": "19:00" },
        { "do": "browse", "sessions": [ { "member": "noa", "from": "2026-10-25T15:00", "to": "2026-10-25T16:00" } ] },
        { "do": "expectTime", "member": "noa", "state": "ok", "usedMinutes": 60, "remainingMinutes": 60 }
      ]
    },
    {
      "id": "TIME-011",
      "title": "Changing the system time zone does not change any decision",
      "start": "2026-11-01T14:00",
      "steps": [
        { "do": "setSystemTimezone", "device": "pc-kids", "tz": "America/New_York" },
        { "do": "navigate", "at": "14:30", "member": "noa", "device": "pc-kids", "url": "https://www.khanacademy.org/", "expect": { "decision": "block", "reason": "blocked_time_window" } },
        { "do": "navigate", "at": "15:00", "member": "noa", "device": "pc-kids", "url": "https://www.khanacademy.org/", "expect": { "decision": "allow", "reason": "allowed_category" } }
      ]
    },
    {
      "id": "TIME-012",
      "title": "Unrestricted adults have no time tracking",
      "start": "2026-11-01T10:00",
      "steps": [
        { "do": "browse", "sessions": [ { "member": "dana", "device": "pc-kids", "from": "10:00", "to": "14:00" } ] },
        { "do": "expectTime", "member": "dana", "state": "unlimited" }
      ]
    },
    {
      "id": "TIME-013",
      "title": "When a member has windows, a day without any window has no internet",
      "start": "2026-11-06T10:00",
      "setup": { "schedules": [ { "member": "yoav", "days": [0, 1, 2, 3, 4], "start": "14:00", "end": "21:30" } ] },
      "steps": [
        { "do": "navigate", "member": "yoav", "url": "https://www.wikipedia.org/", "expect": { "decision": "block", "reason": "blocked_time_window" } },
        { "do": "expectTime", "member": "yoav", "state": "outside_window", "windowEndsAt": null }
      ]
    }
  ]
}
