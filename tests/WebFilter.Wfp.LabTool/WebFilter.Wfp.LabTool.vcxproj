<?xml version="1.0" encoding="utf-8"?>
<!--
  wfpctl.exe: a command-line front end to WebFilter.Wfp.Native.dll for the lab harness
  (tests/simulation/lab/Test-LabWfp.ps1). Lab VMs only: it changes WFP policy. Built with Visual Studio's MSBuild:

    "<VS>\MSBuild\Current\Bin\MSBuild.exe" tests\WebFilter.Wfp.LabTool\WebFilter.Wfp.LabTool.vcxproj -p:Configuration=Release -p:Platform=x64

  Output: bin\x64\<Configuration>\wfpctl.exe, next to a copy of WebFilter.Wfp.Native.dll.
-->
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|x64">
      <Configuration>Debug</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
  </ItemGroup>

  <PropertyGroup Label="Globals">
    <VCProjectVersion>18.0</VCProjectVersion>
    <ProjectGuid>{0E4A7C2B-91D3-4F6A-B5E8-7A2C9D1E3F40}</ProjectGuid>
    <Keyword>Win32Proj</Keyword>
    <RootNamespace>WebFilterWfpLabTool</RootNamespace>
    <WindowsTargetPlatformVersion>10.0</WindowsTargetPlatformVersion>
  </PropertyGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />

  <PropertyGroup Label="Configuration">
    <ConfigurationType>Application</ConfigurationType>
    <PlatformToolset>v145</PlatformToolset>
    <CharacterSet>Unicode</CharacterSet>
    <UseDebugLibraries Condition="'$(Configuration)' == 'Debug'">true</UseDebugLibraries>
    <UseDebugLibraries Condition="'$(Configuration)' == 'Release'">false</UseDebugLibraries>
  </PropertyGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />

  <PropertyGroup>
    <TargetName>wfpctl</TargetName>
    <LinkIncremental>false</LinkIncremental>
    <OutDir>$(MSBuildProjectDirectory)\bin\$(Platform)\$(Configuration)\</OutDir>
    <IntDir>$(MSBuildProjectDirectory)\obj\$(Platform)\$(Configuration)\</IntDir>
  </PropertyGroup>

  <ItemDefinitionGroup>
    <ClCompile>
      <LanguageStandard>stdcpp20</LanguageStandard>
      <WarningLevel>Level4</WarningLevel>
      <TreatWarningAsError>true</TreatWarningAsError>
      <SDLCheck>true</SDLCheck>
      <ConformanceMode>true</ConformanceMode>
      <AdditionalIncludeDirectories>$(MSBuildProjectDirectory)\..\..\src\WebFilter.Wfp.Native;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <PreprocessorDefinitions>WIN32_LEAN_AND_MEAN;NOMINMAX;_CONSOLE;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <RuntimeLibrary Condition="'$(Configuration)' == 'Debug'">MultiThreadedDebug</RuntimeLibrary>
      <RuntimeLibrary Condition="'$(Configuration)' == 'Release'">MultiThreaded</RuntimeLibrary>
    </ClCompile>
    <Link>
      <SubSystem>Console</SubSystem>
      <AdditionalDependencies>userenv.lib;advapi32.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
  </ItemDefinitionGroup>

  <ItemGroup>
    <ClCompile Include="wfpctl.cpp" />
  </ItemGroup>

  <ItemGroup>
    <!-- Links the DLL's import library; the DLL is copied next to wfpctl.exe below. -->
    <ProjectReference Include="..\..\src\WebFilter.Wfp.Native\WebFilter.Wfp.Native.vcxproj">
      <Project>{6C0B5E3A-2F7D-4C8E-9A41-3B7E2D9F5A10}</Project>
    </ProjectReference>
  </ItemGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />

  <Target Name="CopyNativeDll" AfterTargets="Build">
    <Copy SourceFiles="$(MSBuildProjectDirectory)\..\..\src\WebFilter.Wfp.Native\bin\$(Platform)\$(Configuration)\WebFilter.Wfp.Native.dll" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>
</Project>
