<Window x:Class="AdminControlPanel.Views.PasswordResetDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Reset Password - URL Filter"
        Height="420" Width="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="SingleBorderWindow"
        Background="#F5F5F5">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#FF9800" Padding="15">
            <StackPanel HorizontalAlignment="Center">
                <TextBlock Text="🔑" FontSize="36" HorizontalAlignment="Center"/>
                <TextBlock Text="Reset Password" FontSize="20" FontWeight="Bold"
                          Foreground="White" HorizontalAlignment="Center" Margin="0,5,0,0"/>
            </StackPanel>
        </Border>

        <!-- Reset Form -->
        <StackPanel Grid.Row="1" Margin="25,20,25,20">

            <!-- Security Question -->
            <TextBlock Text="Security Question:" FontWeight="Bold" Margin="0,0,0,5"/>
            <Border Background="#EEEEEE" CornerRadius="4" Padding="12" Margin="0,0,0,15">
                <TextBlock x:Name="SecurityQuestionText" TextWrapping="Wrap" FontStyle="Italic"/>
            </Border>

            <!-- Security Answer -->
            <TextBlock Text="Your Answer:" FontWeight="Bold" Margin="0,0,0,5"/>
            <TextBox x:Name="SecurityAnswerBox" FontSize="14" Padding="10"/>

            <!-- New Password -->
            <TextBlock Text="New PIN/Password:" FontWeight="Bold" Margin="0,20,0,5"/>
            <PasswordBox x:Name="NewPasswordBox" FontSize="14" Padding="10" MaxLength="50"/>

            <!-- Confirm New Password -->
            <TextBlock Text="Confirm New PIN/Password:" FontWeight="Bold" Margin="0,15,0,5"/>
            <PasswordBox x:Name="ConfirmPasswordBox" FontSize="14" Padding="10" MaxLength="50"/>

            <!-- Error Message -->
            <Border x:Name="ErrorBorder" Background="#FFEBEE" CornerRadius="4"
                   Padding="10" Margin="0,15,0,0" Visibility="Collapsed">
                <TextBlock x:Name="ErrorMessage" Text="" Foreground="#C62828"
                          TextWrapping="Wrap"/>
            </Border>

        </StackPanel>

        <!-- Footer with buttons -->
        <Border Grid.Row="2" Background="#EEEEEE" Padding="15">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Width="90" Height="35"
                       Background="#9E9E9E" Foreground="White" FontWeight="Bold"
                       Margin="0,0,10,0" Click="Cancel_Click"/>

                <Button Content="Reset Password" Width="120" Height="35"
                       Background="#FF9800" Foreground="White" FontWeight="Bold"
                       Click="ResetPassword_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
