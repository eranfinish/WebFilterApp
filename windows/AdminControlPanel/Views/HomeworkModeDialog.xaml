<Window x:Class="AdminControlPanel.Views.HomeworkModeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Homework Mode" Height="500" Width="550"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">
    
    <Window.Resources>
        <Style x:Key="DurationOptionStyle" TargetType="Border">
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Padding" Value="15"/>
            <Setter Property="Background" Value="#F5F5F5"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E8F5E8"/>
                    <Setter Property="BorderBrush" Value="#4CAF50"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- Title -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,15">
            <TextBlock Text="📚" FontSize="24" Margin="0,0,10,0"/>
            <TextBlock Text="Enable Homework Mode" 
                      FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
        </StackPanel>
        
        <!-- Selected Users -->
        <Border Grid.Row="1" Background="#E3F2FD" CornerRadius="8" Padding="15" Margin="0,0,0,15">
            <StackPanel>
                <TextBlock Text="Selected Students:" FontWeight="Bold" Margin="0,0,0,5"/>
                <TextBlock x:Name="SelectedUsersText" Text="Users will be shown here" 
                          FontSize="12" Foreground="Gray" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>
        
        <!-- Description -->
        <Border Grid.Row="2" Background="#FFF3E0" CornerRadius="8" Padding="15" Margin="0,0,0,15">
            <StackPanel>
                <TextBlock Text="📖 What is Homework Mode?" FontWeight="Bold" Margin="0,0,0,8"/>
                <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="#555">
                    • Only educational websites and resources will be accessible<LineBreak/>
                    • Social media, games, and entertainment sites will be blocked<LineBreak/>
                    • YouTube will be limited to educational channels only<LineBreak/>
                    • Search engines will enforce safe search and educational content
                </TextBlock>
            </StackPanel>
        </Border>
        
        <!-- Duration Selection -->
        <TextBlock Grid.Row="3" 
                  Text="How long should homework mode last?"
                  HorizontalAlignment="Center" 
                  FontSize="14" FontWeight="Bold"
                  Margin="0,0,0,15"/>
        
        <!-- Duration Options -->
        <ScrollViewer Grid.Row="4" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="DurationOptionsPanel">
                <!-- Duration options will be added here -->
            </StackPanel>
        </ScrollViewer>
        
        <!-- Custom Duration Input -->
        <Border Grid.Row="5" Style="{StaticResource DurationOptionStyle}" Margin="5,10,5,10">
            <StackPanel>
                <TextBlock Text="⚙️ Custom Duration" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBox x:Name="CustomDurationTextBox" Width="60" Height="30" 
                            Text="120" TextAlignment="Center" VerticalContentAlignment="Center"
                            PreviewTextInput="CustomDurationTextBox_PreviewTextInput"
                            TextChanged="CustomDurationTextBox_TextChanged"/>
                    <TextBlock Text="minutes" FontSize="14" VerticalAlignment="Center" Margin="10,0,15,0"/>
                    <TextBlock Text="(" FontSize="12" VerticalAlignment="Center" Foreground="Gray"/>
                    <TextBlock x:Name="CustomDurationHoursText" Text="2h 0m" FontSize="12" VerticalAlignment="Center" Foreground="Gray"/>
                    <TextBlock Text=")" FontSize="12" VerticalAlignment="Center" Foreground="Gray"/>
                </StackPanel>
            </StackPanel>
        </Border>
        
        <!-- Action Buttons -->
        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
            <Button Name="CancelButton" Content="Cancel" 
                    Width="100" Height="35" Margin="0,0,10,0"
                    Click="Cancel_Click"
                    Background="#F44336" Foreground="White" FontWeight="Bold"/>
            <Button Name="EnableButton" Content="📚 Start Homework Mode" 
                    Width="180" Height="35"
                    Click="EnableHomeworkMode_Click"
                    Background="#4CAF50" Foreground="White" FontWeight="Bold"/>
        </StackPanel>
    </Grid>
</Window>