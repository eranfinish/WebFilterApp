<Window x:Class="AdminControlPanel.Views.TimeExtensionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Extend Time" Height="450" Width="500"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">
    
    <Window.Resources>
        <Style x:Key="TimeOptionStyle" TargetType="Border">
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Padding" Value="15"/>
            <Setter Property="Background" Value="#F5F5F5"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E8F5E8"/>
                    <Setter Property="BorderBrush" Value="#4CAF50"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- Title -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,15">
            <TextBlock Text="⏰" FontSize="24" Margin="0,0,10,0"/>
            <TextBlock Text="Extend Internet Time" 
                      FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
        </StackPanel>
        
        <!-- User Info -->
        <Border Grid.Row="1" Background="#E3F2FD" CornerRadius="8" Padding="15" Margin="0,0,0,20">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock x:Name="UserIcon" Text="👤" FontSize="32" Margin="0,0,15,0" VerticalAlignment="Center"/>
                <StackPanel>
                    <TextBlock x:Name="UserNameText" Text="Selected User" 
                              FontSize="16" FontWeight="Bold"/>
                    <TextBlock x:Name="UserStatusText" Text="Current status will be shown here" 
                              FontSize="12" Foreground="Gray"/>
                </StackPanel>
            </StackPanel>
        </Border>
        
        <!-- Instructions -->
        <TextBlock Grid.Row="2" 
                  Text="How much additional time would you like to give?"
                  HorizontalAlignment="Center" 
                  FontSize="14"
                  Margin="0,0,0,20"/>
        
        <!-- Time Options -->
        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="TimeOptionsPanel">
                <!-- Time options will be added here -->
            </StackPanel>
        </ScrollViewer>
        
        <!-- Custom Time Input -->
        <Border Grid.Row="4" Style="{StaticResource TimeOptionStyle}" Margin="5,10,5,10">
            <StackPanel>
                <TextBlock Text="⚙️ Custom Time" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBox x:Name="CustomMinutesTextBox" Width="80" Height="30" 
                            Text="30" TextAlignment="Center" VerticalContentAlignment="Center"
                            PreviewTextInput="CustomMinutesTextBox_PreviewTextInput"
                            TextChanged="CustomMinutesTextBox_TextChanged"/>
                    <TextBlock Text="minutes" FontSize="14" VerticalAlignment="Center" Margin="10,0,0,0"/>
                </StackPanel>
            </StackPanel>
        </Border>
        
        <!-- Action Buttons -->
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
            <Button Name="CancelButton" Content="Cancel" 
                    Width="100" Height="35" Margin="0,0,10,0"
                    Click="Cancel_Click"
                    Background="#F44336" Foreground="White" FontWeight="Bold"/>
            <Button Name="ExtendButton" Content="Extend Time" 
                    Width="120" Height="35"
                    Click="ExtendTime_Click"
                    Background="#4CAF50" Foreground="White" FontWeight="Bold"/>
        </StackPanel>
    </Grid>
</Window>