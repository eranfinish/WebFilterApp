<Window x:Class="AdminControlPanel.Views.WebsiteListsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Website Lists - Whitelist &amp; Blacklist" Height="700" Width="1000"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- Header -->
        <Border Grid.Row="0" Background="#2196F3" Padding="20,15">
            <StackPanel HorizontalAlignment="Center">
                <TextBlock Text="🛡️ Website Filtering Lists" FontSize="20" FontWeight="Bold" 
                          Foreground="White" HorizontalAlignment="Center"/>
                <TextBlock Text="Manage which websites are blocked or allowed for your family" FontSize="12" 
                          Foreground="LightBlue" HorizontalAlignment="Center" Margin="0,5,0,0"/>
            </StackPanel>
        </Border>
        
        <!-- Quick Add Section -->
        <Border Grid.Row="1" Background="LightBlue" Padding="15" Margin="0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <TextBox x:Name="QuickAddTextBox" Grid.Column="0" Padding="12" FontSize="14" 
                        Margin="0,0,10,0" Text="" 
                        VerticalAlignment="Center" Height="40"/>
                
                <Button x:Name="QuickBlockButton" Grid.Column="1" Content="🚫 Block This Site" 
                       Background="Red" Foreground="White" Padding="15,10" Margin="0,0,5,0" 
                       Click="QuickBlock_Click" FontWeight="Bold" Height="40"/>
                
                <Button x:Name="QuickAllowButton" Grid.Column="2" Content="✅ Allow This Site" 
                       Background="Green" Foreground="White" Padding="15,10" Margin="5,0,10,0" 
                       Click="QuickAllow_Click" FontWeight="Bold" Height="40"/>
                
                <Button x:Name="RefreshButton" Grid.Column="3" Content="🔄 Refresh" 
                       Padding="15,10" Click="RefreshLists_Click" Height="40"/>
            </Grid>
        </Border>
        
        <!-- Lists Display -->
        <Grid Grid.Row="2" Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            
            <!-- Blocked Sites -->
            <Border Grid.Column="0" Background="White" CornerRadius="10" Padding="15" Margin="0,0,5,0">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="5" ShadowDepth="2" Color="LightGray"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <TextBlock Grid.Row="0" Text="🚫 BLOCKED WEBSITES" FontWeight="Bold" FontSize="16" 
                              Foreground="Red" HorizontalAlignment="Center" Margin="0,0,0,15"/>
                    
                    <ListView x:Name="BlockedSitesList" Grid.Row="1" BorderThickness="1" BorderBrush="LightGray">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Website" Width="180" DisplayMemberBinding="{Binding UrlPattern}"/>
                                <GridViewColumn Header="Category" Width="100" DisplayMemberBinding="{Binding Category}"/>
                                <GridViewColumn Header="Actions" Width="80">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="❌ Remove" Padding="5,2" Click="RemoveBlocked_Click" 
                                                   Tag="{Binding}" FontSize="10" Background="Orange" Foreground="White"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </Grid>
            </Border>
            
            <!-- Allowed Sites -->
            <Border Grid.Column="1" Background="White" CornerRadius="10" Padding="15" Margin="5,0,0,0">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="5" ShadowDepth="2" Color="LightGray"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <TextBlock Grid.Row="0" Text="✅ ALLOWED WEBSITES" FontWeight="Bold" FontSize="16" 
                              Foreground="Green" HorizontalAlignment="Center" Margin="0,0,0,15"/>
                    
                    <ListView x:Name="AllowedSitesList" Grid.Row="1" BorderThickness="1" BorderBrush="LightGray">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Website" Width="180" DisplayMemberBinding="{Binding UrlPattern}"/>
                                <GridViewColumn Header="Category" Width="100" DisplayMemberBinding="{Binding Category}"/>
                                <GridViewColumn Header="Actions" Width="80">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="❌ Remove" Padding="5,2" Click="RemoveAllowed_Click" 
                                                   Tag="{Binding}" FontSize="10" Background="Orange" Foreground="White"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </Grid>
            </Border>
        </Grid>
        
        <!-- Footer -->
        <Border Grid.Row="3" Background="#F5F5F5" Padding="15,10">
            <Grid>
                <TextBlock x:Name="StatusText" Text="Ready" FontSize="12" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock x:Name="CountsText" Text="Loading..." FontSize="12" VerticalAlignment="Center" Margin="0,0,20,0"/>
                    <Button Content="Close" Padding="20,8" Click="Close_Click" IsCancel="True"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>