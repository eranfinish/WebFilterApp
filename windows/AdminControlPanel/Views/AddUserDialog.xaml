<Window x:Class="AdminControlPanel.Views.AddUserDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add Family Member" Height="550" Width="450"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,20">
            <TextBlock Text="👨‍👩‍👧‍👦" FontSize="32" Margin="0,0,10,0"/>
            <TextBlock Text="Add Family Member" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>
        </StackPanel>

        <!-- Windows Account Selection -->
        <StackPanel Grid.Row="1" Margin="0,0,0,15">
            <TextBlock Text="Windows Account *" FontWeight="Bold" Margin="0,0,0,5"/>
            <ComboBox x:Name="WindowsUserComboBox"
                     Padding="10" FontSize="14"
                     DisplayMemberPath="DisplayText"
                     SelectionChanged="WindowsUserComboBox_SelectionChanged"/>
            <TextBlock Text="Select the Windows user account for this family member"
                      FontSize="11" Foreground="Gray" Margin="0,3,0,0"/>
        </StackPanel>

        <!-- Display Name -->
        <StackPanel Grid.Row="2" Margin="0,0,0,15">
            <TextBlock Text="Display Name *" FontWeight="Bold" Margin="0,0,0,5"/>
            <TextBox x:Name="DisplayNameTextBox"
                    Padding="10" FontSize="14"
                    BorderThickness="1" BorderBrush="#CCCCCC"/>
        </StackPanel>

        <!-- User Type -->
        <StackPanel Grid.Row="3" Margin="0,0,0,15">
            <TextBlock Text="User Type *" FontWeight="Bold" Margin="0,0,0,5"/>
            <ComboBox x:Name="UserTypeComboBox" Padding="10" FontSize="14">
                <ComboBoxItem Content="👶 Child (Under 13)" Tag="Child"/>
                <ComboBoxItem Content="🧑‍🎓 Teen (13-17)" Tag="Teen" IsSelected="True"/>
                <ComboBoxItem Content="👨‍💼 Adult (18+)" Tag="Adult"/>
                <ComboBoxItem Content="👤 Guest" Tag="Guest"/>
            </ComboBox>
        </StackPanel>

        <!-- Age -->
        <StackPanel Grid.Row="4" Margin="0,0,0,15">
            <TextBlock Text="Age (Optional)" FontWeight="Bold" Margin="0,0,0,5"/>
            <TextBox x:Name="AgeTextBox"
                    Padding="10" FontSize="14"
                    BorderThickness="1" BorderBrush="#CCCCCC"
                    PreviewTextInput="AgeTextBox_PreviewTextInput"/>
        </StackPanel>

        <!-- Daily Time Limit -->
        <StackPanel Grid.Row="5" Margin="0,0,0,15">
            <TextBlock Text="Daily Time Limit" FontWeight="Bold" Margin="0,0,0,5"/>
            <StackPanel Orientation="Horizontal">
                <Slider x:Name="TimeLimitSlider"
                       Minimum="30" Maximum="480" Value="120"
                       Width="200" VerticalAlignment="Center"
                       ValueChanged="TimeLimitSlider_ValueChanged"/>
                <TextBlock x:Name="TimeLimitText" Text="2 hours"
                          VerticalAlignment="Center" Margin="15,0,0,0"
                          FontWeight="Bold" FontSize="14"/>
            </StackPanel>
            <TextBlock Text="Set to maximum (8 hours) for unlimited access"
                      FontSize="11" Foreground="Gray" Margin="0,5,0,0"/>
        </StackPanel>

        <!-- Info Panel -->
        <Border Grid.Row="6" Background="#E3F2FD" CornerRadius="8" Padding="15" Margin="0,10,0,0">
            <StackPanel>
                <TextBlock Text="How it works:" FontWeight="Bold" Margin="0,0,0,10"/>
                <TextBlock TextWrapping="Wrap" FontSize="12">
                    <Run>1. Each family member needs a</Run>
                    <Run FontWeight="Bold">Windows user account</Run>
                    <LineBreak/>
                    <Run>2. When they log into Windows and browse the internet,</Run>
                    <LineBreak/>
                    <Run>   the filter applies rules based on their user type</Run>
                    <LineBreak/>
                    <Run>3. Time limits and website blocking are per-user</Run>
                </TextBlock>
            </StackPanel>
        </Border>

        <!-- Action Buttons -->
        <StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
            <Button Content="Cancel" Width="100" Height="40" Margin="0,0,10,0"
                    Background="#F44336" Foreground="White" FontWeight="Bold"
                    Click="Cancel_Click"/>
            <Button Content="Add Member" Width="120" Height="40"
                    Background="#4CAF50" Foreground="White" FontWeight="Bold"
                    Click="Add_Click"/>
        </StackPanel>
    </Grid>
</Window>
