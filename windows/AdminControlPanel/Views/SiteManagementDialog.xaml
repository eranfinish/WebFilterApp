<Window x:Class="AdminControlPanel.Views.SiteManagementDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Site Management" Height="600" Width="800"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- Header -->
        <Border Grid.Row="0" Background="#2196F3" Padding="20,15">
            <TextBlock Text="🛡️ Website Filtering Management" FontSize="18" FontWeight="Bold" 
                      Foreground="White" HorizontalAlignment="Center"/>
        </Border>
        
        <!-- Add Site Section -->
        <Border Grid.Row="1" Background="White" Padding="20" Margin="10" CornerRadius="5">
            <StackPanel>
                <TextBlock Text="Add Website to List:" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>
                
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <TextBox x:Name="UrlTextBox" Grid.Column="0" Padding="10" FontSize="14" 
                            Margin="0,0,10,0" Text="Enter website (e.g., facebook.com)" 
                            GotFocus="UrlTextBox_GotFocus" LostFocus="UrlTextBox_LostFocus"
                            Foreground="Gray"/>
                    
                    <ComboBox x:Name="ActionComboBox" Grid.Column="1" Padding="10" FontSize="14" 
                             Width="100" Margin="0,0,10,0" SelectedIndex="0">
                        <ComboBoxItem>Block</ComboBoxItem>
                        <ComboBoxItem>Allow</ComboBoxItem>
                    </ComboBox>
                    
                    <ComboBox x:Name="CategoryComboBox" Grid.Column="2" Padding="10" FontSize="14" 
                             Width="120" Margin="0,0,10,0" SelectedIndex="0">
                        <ComboBoxItem>Custom</ComboBoxItem>
                        <ComboBoxItem>Social Media</ComboBoxItem>
                        <ComboBoxItem>Gaming</ComboBoxItem>
                        <ComboBoxItem>Education</ComboBoxItem>
                        <ComboBoxItem>Adult Content</ComboBoxItem>
                        <ComboBoxItem>News</ComboBoxItem>
                    </ComboBox>
                    
                    <Button x:Name="AddSiteButton" Grid.Column="3" Content="Add Site" 
                           Padding="15,10" Click="AddSite_Click" 
                           Style="{StaticResource PrimaryButton}"/>
                </Grid>
                
                <TextBlock x:Name="StatusTextBlock" Margin="0,10,0,0" Foreground="Green"/>
            </StackPanel>
        </Border>
        
        <!-- Site Lists -->
        <TabControl Grid.Row="2" Margin="10,0,10,10">
            <!-- Blocked Sites -->
            <TabItem Header="🚫 Blocked Sites">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <TextBlock Grid.Row="0" Text="Blocked Websites:" FontWeight="Bold" 
                              Margin="10" FontSize="14"/>
                    
                    <ListView x:Name="BlacklistView" Grid.Row="1" Margin="10">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Website" Width="200" DisplayMemberBinding="{Binding UrlPattern}"/>
                                <GridViewColumn Header="Category" Width="120" DisplayMemberBinding="{Binding Category}"/>
                                <GridViewColumn Header="Match Type" Width="100" DisplayMemberBinding="{Binding MatchType}"/>
                                <GridViewColumn Header="Added" Width="120" DisplayMemberBinding="{Binding AddedDate, StringFormat='{}{0:yyyy-MM-dd}'}"/>
                                <GridViewColumn Header="Actions" Width="100">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="Remove" Padding="5,2" Click="RemoveSite_Click" 
                                                   Tag="{Binding}" FontSize="10"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </Grid>
            </TabItem>
            
            <!-- Allowed Sites -->
            <TabItem Header="✅ Allowed Sites">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <TextBlock Grid.Row="0" Text="Allowed Websites:" FontWeight="Bold" 
                              Margin="10" FontSize="14"/>
                    
                    <ListView x:Name="WhitelistView" Grid.Row="1" Margin="10">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Website" Width="200" DisplayMemberBinding="{Binding UrlPattern}"/>
                                <GridViewColumn Header="Category" Width="120" DisplayMemberBinding="{Binding Category}"/>
                                <GridViewColumn Header="Match Type" Width="100" DisplayMemberBinding="{Binding MatchType}"/>
                                <GridViewColumn Header="Added" Width="120" DisplayMemberBinding="{Binding AddedDate, StringFormat='{}{0:yyyy-MM-dd}'}"/>
                                <GridViewColumn Header="Actions" Width="100">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="Remove" Padding="5,2" Click="RemoveSite_Click" 
                                                   Tag="{Binding}" FontSize="10"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </Grid>
            </TabItem>
        </TabControl>
        
        <!-- Footer -->
        <Border Grid.Row="3" Background="#F5F5F5" Padding="20,10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Refresh Lists" Padding="15,8" Margin="0,0,10,0" 
                       Click="RefreshLists_Click" Style="{StaticResource PrimaryButton}"/>
                <Button Content="Close" Padding="15,8" Click="Close_Click" IsCancel="True"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>