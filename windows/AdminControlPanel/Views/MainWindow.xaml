<Window x:Class="AdminControlPanel.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="URL Filter Admin Control Panel" Height="600" Width="900"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <TabControl Margin="10">
            <TabItem Header="Dashboard">
                <Grid>
                    <TextBlock Text="URL Filter System Status" FontSize="24" FontWeight="Bold" 
                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
            </TabItem>
            
            <TabItem Header="Users">
                <Grid>
                    <TextBlock Text="User Management (Coming Soon)" FontSize="16" 
                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
            </TabItem>
            
            <TabItem Header="URL Lists">
                <Grid>
                    <TextBlock Text="URL List Management (Coming Soon)" FontSize="16" 
                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
            </TabItem>
            
            <TabItem Header="Settings">
                <Grid>
                    <TextBlock Text="System Settings (Coming Soon)" FontSize="16" 
                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>