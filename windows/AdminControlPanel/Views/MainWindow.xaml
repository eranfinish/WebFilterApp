<Window x:Class="AdminControlPanel.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:AdminControlPanel.Controls"
        Title="🏠 Family Internet Dashboard" Height="800" Width="1200"
        WindowStartupLocation="CenterScreen">
    <Grid Background="#F5F5F5">
        <!-- Header -->
        <Border Background="#2196F3" Height="60" VerticalAlignment="Top">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0">
                    <TextBlock Text="🏠 Family Internet Dashboard" FontSize="20" FontWeight="Bold"
                              Foreground="White" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Filtering Toggle + Status (center-right) -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                           VerticalAlignment="Center" Margin="20,0">

                    <!-- Filtering Status Indicator -->
                    <Border x:Name="FilterStatusBorder" Background="#4CAF50" CornerRadius="12"
                            Padding="10,4" Margin="0,0,15,0" VerticalAlignment="Center">
                        <TextBlock x:Name="FilterStatusText" Text="Filtering: ON" FontSize="12"
                                  FontWeight="Bold" Foreground="White"/>
                    </Border>

                    <!-- Enable/Disable Filtering Toggle Button -->
                    <Button x:Name="ToggleFilteringButton" Content="Disable Filtering"
                            Padding="12,6" FontSize="12" FontWeight="Bold"
                            Background="#FF5722" Foreground="White" BorderThickness="0"
                            Click="ToggleFiltering_Click" VerticalAlignment="Center" Margin="0,0,15,0"/>

                    <TextBlock Text="👤 Admin" FontSize="14" Foreground="White" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>
        
        <!-- Main Content -->
        <ScrollViewer Margin="0,60,0,0" VerticalScrollBarVisibility="Auto">
            <TabControl Margin="20">
                <!-- Family Dashboard -->
                <TabItem Header="👨‍👩‍👧‍👦 Family Dashboard">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        
                        <!-- Family Status Overview -->
                        <Border Grid.Row="0" Background="White" CornerRadius="10" Padding="20" Margin="0,0,0,20">
                            <StackPanel>
                                <TextBlock Text="👨‍👩‍👧‍👦 Family Status: All Good ✅" FontSize="18" FontWeight="Bold" 
                                          HorizontalAlignment="Center" Margin="0,0,0,15"/>
                                
                                <!-- User Cards -->
                                <WrapPanel x:Name="UserCardsPanel" HorizontalAlignment="Center">
                                    <!-- User cards will be loaded dynamically -->
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                        
                        <!-- Quick Actions -->
                        <controls:QuickActionsPanel Grid.Row="1"/>
                        
                        <!-- Today's Activity Summary -->
                        <Border Grid.Row="2" Background="White" CornerRadius="10" Padding="20" Margin="0,20,0,0">
                            <StackPanel>
                                <TextBlock Text="📊 Today's Activity" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition/>
                                        <ColumnDefinition/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Internet Usage: 5 hours of 8 hours allowed" FontSize="14"/>
                                        <ProgressBar Value="62.5" Height="20" Margin="0,5,10,10" Background="LightGray">
                                            <ProgressBar.Foreground>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                    <GradientStop Color="Green" Offset="0"/>
                                                    <GradientStop Color="Orange" Offset="0.7"/>
                                                    <GradientStop Color="Red" Offset="1"/>
                                                </LinearGradientBrush>
                                            </ProgressBar.Foreground>
                                        </ProgressBar>
                                    </StackPanel>
                                    
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="🚨 Recent Alert: Jake tried to access gaming sites (3x)" 
                                                  FontSize="14" Foreground="Red"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Grid>
                </TabItem>
                
                <!-- Time Controls -->
                <TabItem Header="⏰ Time Controls">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="Time Management Controls" FontSize="18" FontWeight="Bold" 
                                      Margin="0,0,0,20" HorizontalAlignment="Center"/>
                            
                            <controls:TimeSliderControl Margin="0,10"/>
                            <controls:TimeSliderControl Margin="0,10"/>
                            <controls:TimeSliderControl Margin="0,10"/>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
                
                <!-- YouTube Management -->
                <TabItem Header="📺 YouTube">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        
                        <!-- Search Bar -->
                        <Border Grid.Row="0" Background="White" CornerRadius="8" Padding="15" Margin="0,0,0,20">
                            <StackPanel>
                                <TextBlock Text="📺 YouTube Channel Management" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <TextBox Grid.Column="0" Text="Search for educational channels..." 
                                            Padding="10" FontSize="14" Style="{StaticResource ModernTextBox}"/>
                                    <Button Grid.Column="1" Content="🔍 Search" Padding="15,10" 
                                           Style="{StaticResource PrimaryButton}"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                        
                        <!-- Quick Categories -->
                        <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="15" Margin="0,0,0,20">
                            <StackPanel>
                                <TextBlock Text="Quick Categories:" FontWeight="SemiBold" Margin="0,0,0,10"/>
                                <WrapPanel>
                                    <Button Content="📚 All Educational" Margin="5" Padding="10,5" Style="{StaticResource PrimaryButton}"/>
                                    <Button Content="🔢 Math &amp; Science" Margin="5" Padding="10,5" Style="{StaticResource PrimaryButton}"/>
                                    <Button Content="📖 Reading" Margin="5" Padding="10,5" Style="{StaticResource PrimaryButton}"/>
                                    <Button Content="🎨 Art &amp; Music" Margin="5" Padding="10,5" Style="{StaticResource PrimaryButton}"/>
                                    <Button Content="🌍 Geography" Margin="5" Padding="10,5" Style="{StaticResource PrimaryButton}"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                        
                        <!-- Channel Cards -->
                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="Recommended Educational Channels:" FontWeight="SemiBold" Margin="0,0,0,15"/>
                                <controls:YouTubeChannelCard Margin="0,5"/>
                                <controls:YouTubeChannelCard Margin="0,5"/>
                                <controls:YouTubeChannelCard Margin="0,5"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </TabItem>
                
                <!-- Website Filtering -->
                <TabItem Header="🛡️ Website Filtering">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        
                        <!-- Quick Actions -->
                        <Border Grid.Row="0" Background="White" CornerRadius="10" Padding="20" Margin="10,10,10,5">
                            <StackPanel>
                                <TextBlock Text="Website Management" FontSize="16" FontWeight="Bold" Margin="0,0,0,15"/>
                                <WrapPanel>
                                    <Button Content="📝 Manage Websites" Padding="15,10" Margin="5" Click="ManageWebsites_Click" Style="{StaticResource PrimaryButton}"/>
                                    <Button Content="📊 View Statistics" Padding="15,10" Margin="5" Click="ViewStatistics_Click" Style="{StaticResource PrimaryButton}"/>
                                    <Button Content="🔄 Refresh Lists" Padding="15,10" Margin="5" Click="RefreshLists_Click" Style="{StaticResource PrimaryButton}"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                        
                        <!-- Website Lists Summary -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="WebsiteListsPanel" Margin="10,5,10,10">
                                <TextBlock Text="Loading website lists..." FontSize="14" HorizontalAlignment="Center" Margin="20"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </TabItem>
                
                <!-- User Management -->
                <TabItem Header="👥 Users">
                    <Grid Margin="20">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        
                        <!-- Header -->
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,20">
                            <TextBlock Text="👥" FontSize="24" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <StackPanel>
                                <TextBlock Text="Family Members" FontSize="20" FontWeight="Bold"/>
                                <TextBlock Text="Manage family members and their internet access" FontSize="12" Foreground="Gray"/>
                            </StackPanel>
                            <Button Name="AddUserButton" Content="➕ Add Family Member" 
                                    HorizontalAlignment="Right" Margin="20,0,0,0"
                                    Width="150" Height="35" 
                                    Background="#4CAF50" Foreground="White" FontWeight="Bold"
                                    Click="AddUser_Click"/>
                        </StackPanel>
                        
                        <!-- User List -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <StackPanel Name="UserListPanel">
                                <!-- Users will be loaded here -->
                            </StackPanel>
                        </ScrollViewer>
                        
                        <!-- Actions Bar -->
                        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                            <Button Name="RefreshUsersButton" Content="🔄 Refresh" 
                                    Width="100" Height="35" Margin="0,0,10,0"
                                    Background="#2196F3" Foreground="White" FontWeight="Bold"
                                    Click="RefreshUsers_Click"/>
                            <Button Name="ExportUsersButton" Content="📄 Export List" 
                                    Width="120" Height="35" Margin="0,0,10,0"
                                    Background="#FF9800" Foreground="White" FontWeight="Bold"
                                    Click="ExportUsers_Click"/>
                            <Button Name="ImportUsersButton" Content="📁 Import Users" 
                                    Width="130" Height="35"
                                    Background="#9C27B0" Foreground="White" FontWeight="Bold"
                                    Click="ImportUsers_Click"/>
                        </StackPanel>
                    </Grid>
                </TabItem>
                
                <!-- Settings -->
                <TabItem Header="⚙️ Settings">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <Grid Margin="20">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            
                            <!-- Header -->
                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,20">
                                <TextBlock Text="⚙️" FontSize="24" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <StackPanel>
                                    <TextBlock Text="System Settings" FontSize="20" FontWeight="Bold"/>
                                    <TextBlock Text="Configure URL Filter system preferences" FontSize="12" Foreground="Gray"/>
                                </StackPanel>
                            </StackPanel>
                            
                            <!-- Settings Content -->
                            <StackPanel Grid.Row="1">
                                
                                <!-- General Settings -->
                                <GroupBox Header="🔧 General Settings" Margin="0,0,0,20" Padding="15">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="200"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="100"/>
                                        </Grid.ColumnDefinitions>
                                        
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Auto-start with Windows:" VerticalAlignment="Center"/>
                                        <CheckBox Grid.Row="0" Grid.Column="1" Name="AutoStartCheckBox" Content="Start URL Filter service automatically" 
                                                  IsChecked="True" VerticalAlignment="Center"/>
                                        
                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Enable logging:" VerticalAlignment="Center" Margin="0,10,0,0"/>
                                        <CheckBox Grid.Row="1" Grid.Column="1" Name="EnableLoggingCheckBox" Content="Log filtering activities and blocked attempts" 
                                                  IsChecked="True" VerticalAlignment="Center" Margin="0,10,0,0"/>
                                        
                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Update frequency:" VerticalAlignment="Center" Margin="0,10,0,0"/>
                                        <ComboBox Grid.Row="2" Grid.Column="1" Name="UpdateFrequencyComboBox" 
                                                  SelectedIndex="1" VerticalAlignment="Center" Margin="0,10,0,0">
                                            <ComboBoxItem Content="Daily"/>
                                            <ComboBoxItem Content="Weekly"/>
                                            <ComboBoxItem Content="Monthly"/>
                                            <ComboBoxItem Content="Manual"/>
                                        </ComboBox>
                                        
                                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Notification level:" VerticalAlignment="Center" Margin="0,10,0,0"/>
                                        <ComboBox Grid.Row="3" Grid.Column="1" Name="NotificationLevelComboBox" 
                                                  SelectedIndex="1" VerticalAlignment="Center" Margin="0,10,0,0">
                                            <ComboBoxItem Content="All notifications"/>
                                            <ComboBoxItem Content="Important only"/>
                                            <ComboBoxItem Content="Minimal"/>
                                            <ComboBoxItem Content="None"/>
                                        </ComboBox>
                                    </Grid>
                                </GroupBox>
                                
                                <!-- Filtering Settings -->
                                <GroupBox Header="🔍 Filtering Settings" Margin="0,0,0,20" Padding="15">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="200"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Default child policy:" VerticalAlignment="Center"/>
                                        <ComboBox Grid.Row="0" Grid.Column="1" Name="DefaultChildPolicyComboBox" 
                                                  SelectedIndex="2" VerticalAlignment="Center">
                                            <ComboBoxItem Content="Allow all"/>
                                            <ComboBoxItem Content="Filtered"/>
                                            <ComboBoxItem Content="Restricted"/>
                                            <ComboBoxItem Content="Block all"/>
                                        </ComboBox>
                                        
                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Default teen policy:" VerticalAlignment="Center" Margin="0,10,0,0"/>
                                        <ComboBox Grid.Row="1" Grid.Column="1" Name="DefaultTeenPolicyComboBox" 
                                                  SelectedIndex="1" VerticalAlignment="Center" Margin="0,10,0,0">
                                            <ComboBoxItem Content="Allow all"/>
                                            <ComboBoxItem Content="Filtered"/>
                                            <ComboBoxItem Content="Restricted"/>
                                            <ComboBoxItem Content="Block all"/>
                                        </ComboBox>
                                        
                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Block VPN/Proxy:" VerticalAlignment="Center" Margin="0,10,0,0"/>
                                        <CheckBox Grid.Row="2" Grid.Column="1" Name="BlockVpnCheckBox" Content="Block VPN and proxy connections" 
                                                  IsChecked="True" VerticalAlignment="Center" Margin="0,10,0,0"/>
                                        
                                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Safe search:" VerticalAlignment="Center" Margin="0,10,0,0"/>
                                        <CheckBox Grid.Row="3" Grid.Column="1" Name="SafeSearchCheckBox" Content="Enforce safe search on search engines" 
                                                  IsChecked="True" VerticalAlignment="Center" Margin="0,10,0,0"/>
                                    </Grid>
                                </GroupBox>
                                
                                <!-- Time Management -->
                                <GroupBox Header="⏰ Time Management" Margin="0,0,0,20" Padding="15">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="200"/>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Max daily hours (child):" VerticalAlignment="Center"/>
                                        <TextBox Grid.Row="0" Grid.Column="1" Name="MaxChildHoursTextBox" Text="2" TextAlignment="Center" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Row="0" Grid.Column="2" Text="hours per day" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                        
                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Max daily hours (teen):" VerticalAlignment="Center" Margin="0,10,0,0"/>
                                        <TextBox Grid.Row="1" Grid.Column="1" Name="MaxTeenHoursTextBox" Text="4" TextAlignment="Center" VerticalAlignment="Center" Margin="0,10,0,0"/>
                                        <TextBlock Grid.Row="1" Grid.Column="2" Text="hours per day" VerticalAlignment="Center" Margin="10,10,0,0"/>
                                        
                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Session timeout:" VerticalAlignment="Center" Margin="0,10,0,0"/>
                                        <TextBox Grid.Row="2" Grid.Column="1" Name="SessionTimeoutTextBox" Text="120" TextAlignment="Center" VerticalAlignment="Center" Margin="0,10,0,0"/>
                                        <TextBlock Grid.Row="2" Grid.Column="2" Text="minutes of inactivity" VerticalAlignment="Center" Margin="10,10,0,0"/>
                                    </Grid>
                                </GroupBox>
                                
                                <!-- Action Buttons -->
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                                    <Button Name="SaveSettingsButton" Content="💾 Save Settings" 
                                            Width="130" Height="35" Margin="0,0,10,0"
                                            Background="#4CAF50" Foreground="White" FontWeight="Bold"
                                            Click="SaveSettings_Click"/>
                                    <Button Name="ResetSettingsButton" Content="🔄 Reset to Defaults" 
                                            Width="150" Height="35" Margin="0,0,10,0"
                                            Background="#FF9800" Foreground="White" FontWeight="Bold"
                                            Click="ResetSettings_Click"/>
                                    <Button Name="ExportSettingsButton" Content="📤 Export Settings" 
                                            Width="140" Height="35"
                                            Background="#2196F3" Foreground="White" FontWeight="Bold"
                                            Click="ExportSettings_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </ScrollViewer>
    </Grid>
</Window>