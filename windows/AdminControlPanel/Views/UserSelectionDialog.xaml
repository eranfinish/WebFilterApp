<Window x:Class="AdminControlPanel.Views.UserSelectionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Select User" Height="400" Width="500"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">
    
    <Window.Resources>
        <Style x:Key="UserCardStyle" TargetType="Border">
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Background" Value="#F5F5F5"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E8F5E8"/>
                    <Setter Property="BorderBrush" Value="#4CAF50"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- Title -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,20">
            <TextBlock Text="⏰" FontSize="24" Margin="0,0,10,0"/>
            <TextBlock x:Name="TitleTextBlock" Text="Extend Time - Select User" 
                      FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
        </StackPanel>
        
        <!-- Action Description -->
        <TextBlock x:Name="DescriptionTextBlock" Grid.Row="1" 
                  Text="Select which family member to extend time for:"
                  HorizontalAlignment="Center" 
                  FontSize="14"
                  Margin="0,0,0,20"/>
        
        <!-- User List -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="UserListPanel">
                <!-- User cards will be added dynamically -->
            </StackPanel>
        </ScrollViewer>
        
        <!-- Action Buttons -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
            <Button Name="CancelButton" Content="Cancel" 
                    Width="100" Height="35" Margin="0,0,10,0"
                    Click="Cancel_Click"
                    Background="#F44336" Foreground="White" FontWeight="Bold"/>
            <Button Name="SelectAllButton" Content="All Users" 
                    Width="100" Height="35"
                    Click="SelectAll_Click"
                    Background="#FF9800" Foreground="White" FontWeight="Bold"/>
        </StackPanel>
    </Grid>
</Window>