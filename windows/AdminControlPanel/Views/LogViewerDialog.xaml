<Window x:Class="AdminControlPanel.Views.LogViewerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="URL Filter System - Log Viewer" Height="600" Width="800"
        WindowStartupLocation="CenterOwner"
        Background="#F5F5F5">
    
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- Header -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="📋" FontSize="24" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <TextBlock Text="System Log Viewer" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
            <TextBlock Name="LogCountText" Text="(0 entries)" FontSize="12" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="Gray"/>
        </StackPanel>
        
        <!-- Controls -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
            <Button Name="RefreshButton" Content="🔄 Refresh" Width="100" Height="30" Margin="0,0,10,0" Click="Refresh_Click"/>
            <Button Name="ClearLogsButton" Content="🗑️ Clear" Width="100" Height="30" Margin="0,0,10,0" Click="ClearLogs_Click"/>
            <ComboBox Name="LogLevelFilter" Width="120" Height="30" Margin="0,0,10,0" SelectionChanged="LogLevelFilter_Changed">
                <ComboBoxItem Content="All Levels" IsSelected="True"/>
                <ComboBoxItem Content="Error"/>
                <ComboBoxItem Content="Warning"/>
                <ComboBoxItem Content="Info"/>
                <ComboBoxItem Content="Debug"/>
            </ComboBox>
            <TextBox Name="FilterTextBox" Width="200" Height="30" Margin="0,0,10,0" 
                     Text="Filter logs..." Foreground="Gray" 
                     GotFocus="FilterTextBox_GotFocus" LostFocus="FilterTextBox_LostFocus" TextChanged="FilterTextBox_TextChanged"/>
        </StackPanel>
        
        <!-- Log Display -->
        <Border Grid.Row="2" BorderBrush="#DDD" BorderThickness="1" Background="White" CornerRadius="5">
            <ScrollViewer Name="LogScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                <TextBlock Name="LogTextBlock" 
                          FontFamily="Consolas" 
                          FontSize="11" 
                          Margin="10" 
                          Text="Loading logs..." 
                          TextWrapping="NoWrap"/>
            </ScrollViewer>
        </Border>
        
        <!-- Status -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,10,0,0">
            <TextBlock Name="StatusText" Text="Ready" Foreground="Gray"/>
            <TextBlock Text=" | Auto-refresh: " Foreground="Gray"/>
            <CheckBox Name="AutoRefreshCheckBox" Content="Enabled" IsChecked="True" Checked="AutoRefresh_Changed" Unchecked="AutoRefresh_Changed"/>
            <Button Content="Close" Width="80" Height="30" Margin="20,0,0,0" HorizontalAlignment="Right" Click="Close_Click"/>
        </StackPanel>
    </Grid>
</Window>