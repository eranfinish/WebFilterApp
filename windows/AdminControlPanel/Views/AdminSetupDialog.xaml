<Window x:Class="AdminControlPanel.Views.AdminSetupDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="First-Time Setup - URL Filter"
        Height="550" Width="450"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="SingleBorderWindow"
        Background="#F5F5F5">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#4CAF50" Padding="20">
            <StackPanel HorizontalAlignment="Center">
                <TextBlock Text="🛡️" FontSize="48" HorizontalAlignment="Center"/>
                <TextBlock Text="Welcome to URL Filter" FontSize="22" FontWeight="Bold"
                          Foreground="White" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                <TextBlock Text="Let's set up admin protection" FontSize="12"
                          Foreground="#C8E6C9" HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Setup Form -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="30,20,30,20">

                <!-- Instructions -->
                <Border Background="#E3F2FD" CornerRadius="8" Padding="15" Margin="0,0,0,20">
                    <TextBlock TextWrapping="Wrap" FontSize="12">
                        <Run FontWeight="Bold">Create your admin PIN or password</Run>
                        <LineBreak/>
                        This will be required to access the control panel and change filter settings.
                        Keep it secret from children!
                    </TextBlock>
                </Border>

                <!-- PIN/Password -->
                <TextBlock Text="Create PIN or Password *" FontWeight="Bold" Margin="0,0,0,5"/>
                <PasswordBox x:Name="PasswordBox" FontSize="16" Padding="12" MaxLength="50"/>
                <TextBlock Text="Minimum 4 characters (PIN) or use a strong password"
                          FontSize="11" Foreground="#757575" Margin="0,3,0,0"/>

                <!-- Confirm Password -->
                <TextBlock Text="Confirm PIN/Password *" FontWeight="Bold" Margin="0,20,0,5"/>
                <PasswordBox x:Name="ConfirmPasswordBox" FontSize="16" Padding="12" MaxLength="50"/>

                <!-- Security Question -->
                <TextBlock Text="Security Question (for password recovery)" FontWeight="Bold" Margin="0,25,0,5"/>
                <ComboBox x:Name="SecurityQuestionCombo" FontSize="14" Padding="10">
                    <ComboBoxItem Content="What is your mother's maiden name?"/>
                    <ComboBoxItem Content="What was the name of your first pet?"/>
                    <ComboBoxItem Content="What city were you born in?"/>
                    <ComboBoxItem Content="What is your favorite movie?"/>
                    <ComboBoxItem Content="What was your childhood nickname?"/>
                    <ComboBoxItem Content="What is the name of your favorite teacher?"/>
                </ComboBox>

                <!-- Security Answer -->
                <TextBlock Text="Security Answer" FontWeight="Bold" Margin="0,15,0,5"/>
                <TextBox x:Name="SecurityAnswerBox" FontSize="14" Padding="12"/>
                <TextBlock Text="This will help you recover your password if you forget it"
                          FontSize="11" Foreground="#757575" Margin="0,3,0,0"/>

                <!-- Error Message -->
                <Border x:Name="ErrorBorder" Background="#FFEBEE" CornerRadius="4"
                       Padding="10" Margin="0,20,0,0" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⚠️" FontSize="16" Margin="0,0,8,0"/>
                        <TextBlock x:Name="ErrorMessage" Text="" Foreground="#C62828"
                                  TextWrapping="Wrap" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- Footer with buttons -->
        <Border Grid.Row="2" Background="#EEEEEE" Padding="20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="* Required fields" FontSize="11"
                          Foreground="#757575" VerticalAlignment="Center"/>

                <Button Grid.Column="1" Content="Cancel" Width="100" Height="40"
                       Background="#9E9E9E" Foreground="White" FontWeight="Bold"
                       Margin="0,0,10,0" Click="Cancel_Click"/>

                <Button Grid.Column="2" Content="Complete Setup" Width="140" Height="40"
                       Background="#4CAF50" Foreground="White" FontWeight="Bold"
                       Click="CompleteSetup_Click"/>
            </Grid>
        </Border>
    </Grid>
</Window>
