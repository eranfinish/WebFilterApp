<Window x:Class="AdminControlPanel.Views.LoginDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Admin Login - URL Filter"
        Height="520" Width="420"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="SingleBorderWindow"
        Background="#F5F5F5">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#2196F3" Padding="20">
            <StackPanel HorizontalAlignment="Center">
                <TextBlock Text="🔒" FontSize="48" HorizontalAlignment="Center"/>
                <TextBlock Text="Admin Login" FontSize="24" FontWeight="Bold"
                          Foreground="White" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                <TextBlock Text="URL Filter Control Panel" FontSize="12"
                          Foreground="#B3E5FC" HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Login Form -->
        <StackPanel Grid.Row="1" Margin="30,30,30,20" VerticalAlignment="Center">

            <!-- PIN/Password Entry -->
            <TextBlock Text="Enter your PIN or Password:" FontWeight="Bold"
                      Margin="0,0,0,10" FontSize="14"/>

            <PasswordBox x:Name="PasswordBox"
                        FontSize="18" Padding="10"
                        Height="44"
                        Background="White"
                        Foreground="Black"
                        BorderBrush="#BDBDBD"
                        BorderThickness="1"
                        MaxLength="50"
                        KeyDown="PasswordBox_KeyDown"/>

            <!-- Error Message -->
            <Border x:Name="ErrorBorder" Background="#FFEBEE" CornerRadius="4"
                   Padding="10" Margin="0,15,0,0" Visibility="Collapsed">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="⚠️" FontSize="16" Margin="0,0,8,0"/>
                    <TextBlock x:Name="ErrorMessage" Text="" Foreground="#C62828"
                              TextWrapping="Wrap" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- Lockout Warning -->
            <Border x:Name="LockoutBorder" Background="#FFF3E0" CornerRadius="4"
                   Padding="10" Margin="0,15,0,0" Visibility="Collapsed">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="🔐" FontSize="16" Margin="0,0,8,0"/>
                    <TextBlock x:Name="LockoutMessage" Text="" Foreground="#E65100"
                              TextWrapping="Wrap" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- Login Button -->
            <Button x:Name="LoginButton" Content="Login"
                   Height="45" Margin="0,25,0,0"
                   Background="#4CAF50" Foreground="White"
                   FontSize="16" FontWeight="Bold"
                   Click="LoginButton_Click"/>

            <!-- Forgot Password Link -->
            <TextBlock Margin="0,15,0,0" HorizontalAlignment="Center">
                <Hyperlink x:Name="ForgotPasswordLink" Click="ForgotPassword_Click">
                    Forgot PIN/Password?
                </Hyperlink>
            </TextBlock>
        </StackPanel>

        <!-- Footer -->
        <Border Grid.Row="2" Background="#EEEEEE" Padding="15">
            <TextBlock Text="Only Windows administrators can access this panel."
                      FontSize="11" Foreground="#757575" HorizontalAlignment="Center"/>
        </Border>
    </Grid>
</Window>
