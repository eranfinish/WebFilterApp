<UserControl x:Class="AdminControlPanel.Controls.YouTubeChannelCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Background="White" CornerRadius="8" Padding="15" Margin="5">
        <Border.Effect>
            <DropShadowEffect BlurRadius="3" ShadowDepth="1" Color="LightGray"/>
        </Border.Effect>
        
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="80"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            
            <!-- Channel Thumbnail -->
            <Border Grid.Column="0" Width="70" Height="70" CornerRadius="35" 
                   Background="LightGray" VerticalAlignment="Top">
                <Image x:Name="ChannelThumbnail" Source="{Binding ThumbnailUrl}" 
                      Stretch="UniformToFill"/>
            </Border>
            
            <!-- Channel Info -->
            <StackPanel Grid.Column="1" Margin="15,0,0,0" VerticalAlignment="Top">
                <TextBlock x:Name="ChannelName" Text="{Binding ChannelName}" 
                          FontWeight="Bold" FontSize="14" TextWrapping="Wrap"/>
                <TextBlock x:Name="ChannelDescription" Text="{Binding Description}" 
                          FontSize="12" Foreground="Gray" TextWrapping="Wrap" Margin="0,3,0,0"/>
                <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                    <TextBlock x:Name="AgeRating" Text="{Binding AgeRating}" 
                              FontSize="10" Background="LightBlue" Padding="3,1" Margin="0,0,5,0"/>
                    <TextBlock x:Name="Category" Text="{Binding Category}" 
                              FontSize="10" Background="LightGreen" Padding="3,1"/>
                </StackPanel>
                <TextBlock x:Name="SubscriberCount" Text="{Binding SubscriberCountText}" 
                          FontSize="11" Foreground="Gray" Margin="0,3,0,0"/>
            </StackPanel>
            
            <!-- Action Buttons -->
            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                <Button x:Name="AllowButton" Content="✅ Allow" Background="LightGreen" 
                       Margin="2" Padding="10,5" Click="AllowButton_Click"
                       Style="{StaticResource PrimaryButton}"/>
                <Button x:Name="BlockButton" Content="❌ Block" Background="LightCoral"
                       Margin="2" Padding="10,5" Click="BlockButton_Click"
                       Style="{StaticResource PrimaryButton}"/>
                <Button x:Name="PreviewButton" Content="ℹ️ Preview" Background="LightBlue"
                       Margin="2" Padding="10,5" Click="PreviewButton_Click"
                       Style="{StaticResource PrimaryButton}"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>