<UserControl x:Class="AdminControlPanel.Controls.QuickActionsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Background="White" CornerRadius="10" Padding="20" Margin="10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="5" ShadowDepth="2" Color="LightGray"/>
        </Border.Effect>
        
        <StackPanel>
            <TextBlock Text="Quick Actions" FontWeight="Bold" FontSize="16" Margin="0,0,0,10" HorizontalAlignment="Center"/>
            
            <!-- Internet Status Indicator -->
            <Border Name="InternetStatusBorder" Background="#4CAF50" CornerRadius="8" Padding="12" Margin="0,0,0,15">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <!-- Status Icon -->
                    <Ellipse Name="InternetStatusIcon" Grid.Column="0" Width="16" Height="16" 
                            Fill="White" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    
                    <!-- Status Text -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Name="InternetStatusText" Text="🌐 Internet Available - Filtering Active" 
                                  Foreground="White" FontWeight="Bold" FontSize="14"/>
                        <TextBlock Name="FilterStatusText" Text="Safe browsing is enabled for all family members" 
                                  Foreground="White" FontSize="11" Opacity="0.9" Margin="0,2,0,0"/>
                    </StackPanel>
                    
                    <!-- Details Button -->
                    <Button Name="StatusDetailsButton" Grid.Column="2" Content="ℹ️" 
                           Width="24" Height="24" Background="Transparent" BorderThickness="0"
                           Foreground="White" FontSize="12" FontWeight="Bold"
                           Click="StatusDetails_Click" Cursor="Hand"
                           ToolTip="Click for detailed status information"/>
                </Grid>
            </Border>
            
            <!-- Time Management Actions -->
            <GroupBox Header="⏰ Time Management" Margin="0,0,0,10">
                <WrapPanel Orientation="Horizontal">
                    <Button Content="Extend 15min" Margin="5" Padding="10,8" Click="ExtendTime_Click" Tag="15"
                           Style="{StaticResource PrimaryButton}"/>
                    <Button Content="Extend 30min" Margin="5" Padding="10,8" Click="ExtendTime_Click" Tag="30"
                           Style="{StaticResource PrimaryButton}"/>
                    <Button Content="Homework Mode" Margin="5" Padding="10,8" Click="HomeworkMode_Click"
                           Style="{StaticResource PrimaryButton}"/>
                    <Button Content="Bedtime Now" Margin="5" Padding="10,8" Click="BedtimeMode_Click"
                           Style="{StaticResource PrimaryButton}"/>
                </WrapPanel>
            </GroupBox>
            
            <!-- Content Controls -->
            <GroupBox Header="🚫 Content Controls" Margin="0,0,0,10">
                <WrapPanel Orientation="Horizontal">
                    <Button Content="🛡️ Website Lists" Margin="5" Padding="10,8" Click="BlockSite_Click"
                           Style="{StaticResource PrimaryButton}"/>
                    <Button Content="🚫 Block/Allow Sites" Margin="5" Padding="10,8" Click="AllowSite_Click"
                           Style="{StaticResource PrimaryButton}"/>
                    <Button x:Name="SafeSearchButton" Content="Toggle Safe Search" Margin="5" Padding="10,8" Click="SafeSearch_Click"
                           Style="{StaticResource PrimaryButton}"/>
                    <Button x:Name="YouTubeKidsButton" Content="Toggle YouTube Kids" Margin="5" Padding="10,8" Click="YouTubeKids_Click"
                           Style="{StaticResource PrimaryButton}"/>
                </WrapPanel>
            </GroupBox>
            
            <!-- System Controls -->
            <GroupBox Header="🔧 System Controls" Margin="0,0,0,10">
                <WrapPanel Orientation="Horizontal">
                    <Button x:Name="FilterToggleButton" Content="🔴 Turn OFF Filtering" Background="Red" Foreground="White"
                           Margin="5" Padding="15,8" Click="FilterToggle_Click" FontWeight="Bold"/>
                    <Button Content="Emergency Unlock" Background="Orange" Foreground="White" 
                           Margin="5" Padding="10,8" Click="EmergencyUnlock_Click"/>
                    <Button Content="Block All Internet" Background="Gray" Foreground="White"
                           Margin="5" Padding="10,8" Click="BlockAll_Click"/>
                    <Button Content="Reset to Defaults" Background="LightGray" Foreground="Black"
                           Margin="5" Padding="10,8" Click="ResetDefaults_Click"/>
                </WrapPanel>
            </GroupBox>
            
            <!-- System Status -->
            <GroupBox Header="📊 System Status">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Service Status:" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="ServiceStatusIndicator" Width="12" Height="12" Fill="Green" Margin="0,0,5,0"/>
                            <TextBlock x:Name="ServiceStatusText" Text="Running" VerticalAlignment="Center"/>
                        </StackPanel>
                        
                        <TextBlock Text="Filtered Requests Today:" FontWeight="SemiBold" Margin="0,10,0,5"/>
                        <TextBlock x:Name="FilteredRequestsText" Text="0" FontSize="18" FontWeight="Bold" Foreground="Blue"/>
                    </StackPanel>
                    
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Active Users:" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <TextBlock x:Name="ActiveUsersText" Text="0" FontSize="16"/>
                        
                        <TextBlock Text="Blocked Attempts:" FontWeight="SemiBold" Margin="0,10,0,5"/>
                        <TextBlock x:Name="BlockedAttemptsText" Text="0" FontSize="18" FontWeight="Bold" Foreground="Red"/>
                    </StackPanel>
                </Grid>
            </GroupBox>
        </StackPanel>
    </Border>
</UserControl>