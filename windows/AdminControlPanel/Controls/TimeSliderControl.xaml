<UserControl x:Class="AdminControlPanel.Controls.TimeSliderControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Background="White" CornerRadius="8" Padding="20" Margin="5">
        <StackPanel>
            <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>
            
            <!-- Time Limit Slider -->
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                
                <!-- Time Labels -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    
                    <TextBlock Grid.Column="0" Text="0h" HorizontalAlignment="Center" FontSize="12"/>
                    <TextBlock Grid.Column="1" Text="1h" HorizontalAlignment="Center" FontSize="12"/>
                    <TextBlock Grid.Column="2" Text="2h" HorizontalAlignment="Center" FontSize="12"/>
                    <TextBlock Grid.Column="3" Text="3h" HorizontalAlignment="Center" FontSize="12"/>
                    <TextBlock Grid.Column="4" Text="4h+" HorizontalAlignment="Center" FontSize="12"/>
                </Grid>
                
                <!-- Slider -->
                <Slider Grid.Row="1" x:Name="TimeSlider" Minimum="0" Maximum="240" 
                       Value="{Binding TimeLimit}" TickFrequency="30" IsSnapToTickEnabled="True"
                       ValueChanged="TimeSlider_ValueChanged"/>
                
                <!-- Current Value Display -->
                <TextBlock Grid.Row="2" HorizontalAlignment="Center" Margin="0,10,0,0">
                    <Run Text="Daily Limit: "/>
                    <Run x:Name="CurrentTimeText" Text="{Binding TimeLimit}" FontWeight="Bold"/>
                    <Run Text=" minutes"/>
                </TextBlock>
            </Grid>
            
            <!-- Quick Time Buttons -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,15,0,0">
                <Button Content="30m" Click="QuickTime_Click" Tag="30" Margin="2" Padding="8,4" 
                       Style="{StaticResource PrimaryButton}"/>
                <Button Content="1h" Click="QuickTime_Click" Tag="60" Margin="2" Padding="8,4"
                       Style="{StaticResource PrimaryButton}"/>
                <Button Content="2h" Click="QuickTime_Click" Tag="120" Margin="2" Padding="8,4"
                       Style="{StaticResource PrimaryButton}"/>
                <Button Content="3h" Click="QuickTime_Click" Tag="180" Margin="2" Padding="8,4"
                       Style="{StaticResource PrimaryButton}"/>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>