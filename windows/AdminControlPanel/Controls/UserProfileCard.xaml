<UserControl x:Class="AdminControlPanel.Controls.UserProfileCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Background="White" CornerRadius="10" Padding="15" Margin="5">
        <Border.Effect>
            <DropShadowEffect BlurRadius="5" ShadowDepth="2" Color="LightGray"/>
        </Border.Effect>
        
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="60"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            
            <!-- User Avatar and Name -->
            <StackPanel Grid.Row="0" Orientation="Horizontal">
                <Ellipse Width="50" Height="50" Fill="LightBlue" Margin="0,0,10,0">
                    <Ellipse.OpacityMask>
                        <ImageBrush x:Name="AvatarBrush" ImageSource="{Binding Avatar, FallbackValue={x:Null}}"/>
                    </Ellipse.OpacityMask>
                </Ellipse>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="UserName" Text="{Binding DisplayName}" FontWeight="Bold" FontSize="16"/>
                    <TextBlock x:Name="UserAge" Text="{Binding AgeText}" Foreground="Gray" FontSize="12"/>
                </StackPanel>
            </StackPanel>
            
            <!-- Status Indicator -->
            <StackPanel Grid.Row="1" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10">
                    <Ellipse x:Name="StatusIndicator" Width="15" Height="15" Fill="{Binding StatusColor}" Margin="0,0,5,0"/>
                    <TextBlock x:Name="StatusText" Text="{Binding StatusText}" FontWeight="SemiBold"/>
                </StackPanel>
                <TextBlock x:Name="TimeRemaining" Text="{Binding TimeRemainingText}" 
                          HorizontalAlignment="Center" Foreground="DarkBlue" FontSize="14"/>
            </StackPanel>
            
            <!-- Quick Actions -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Content="⏰" ToolTip="Extend Time" Margin="2" Padding="5" 
                       Click="ExtendTime_Click" Style="{StaticResource PrimaryButton}"/>
                <Button Content="📚" ToolTip="Homework Mode" Margin="2" Padding="5"
                       Click="HomeworkMode_Click" Style="{StaticResource PrimaryButton}"/>
                <Button Content="🚫" ToolTip="Block Now" Margin="2" Padding="5"
                       Click="BlockNow_Click" Style="{StaticResource PrimaryButton}"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>