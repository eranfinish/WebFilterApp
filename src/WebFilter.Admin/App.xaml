<Application x:Class="WebFilter.Admin.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:WebFilter.Admin.Converters"
             xmlns:res="clr-namespace:WebFilter.Admin.Resources"
             xmlns:vm="clr-namespace:WebFilter.Admin.ViewModels"
             ShutdownMode="OnMainWindowClose">
  <Application.Resources>

    <!-- Palette -->
    <SolidColorBrush x:Key="WindowBrush" Color="#F4F6F9" />
    <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="BorderBrush" Color="#DDE2E8" />
    <SolidColorBrush x:Key="TextBrush" Color="#1F2933" />
    <SolidColorBrush x:Key="SubtleTextBrush" Color="#5F6B7A" />
    <SolidColorBrush x:Key="NavBrush" Color="#1E293B" />
    <SolidColorBrush x:Key="NavTextBrush" Color="#CBD5E1" />
    <SolidColorBrush x:Key="NavSelectedBrush" Color="#334155" />
    <SolidColorBrush x:Key="AccentBrush" Color="#2563EB" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#1D4ED8" />
    <SolidColorBrush x:Key="DangerBrush" Color="#B42318" />
    <SolidColorBrush x:Key="DangerSoftBrush" Color="#FDECEA" />
    <SolidColorBrush x:Key="WarningBrush" Color="#93590B" />
    <SolidColorBrush x:Key="WarningSoftBrush" Color="#FEF3D7" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#11734B" />
    <SolidColorBrush x:Key="SuccessSoftBrush" Color="#E3F5EC" />
    <SolidColorBrush x:Key="InfoBrush" Color="#1E4FAF" />
    <SolidColorBrush x:Key="InfoSoftBrush" Color="#E5EDFD" />
    <SolidColorBrush x:Key="NeutralSoftBrush" Color="#EEF1F5" />

    <!-- Converters -->
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    <conv:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisibility" />
    <conv:HasValueToVisibilityConverter x:Key="HasValueToVisibility" />

    <!-- Text -->
    <Style x:Key="HeadingText" TargetType="TextBlock">
      <Setter Property="FontSize" Value="24" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    </Style>
    <Style x:Key="SectionText" TargetType="TextBlock">
      <Setter Property="FontSize" Value="17" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
      <Setter Property="Margin" Value="0,8,0,8" />
    </Style>
    <Style x:Key="SubtleText" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource SubtleTextBrush}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="LabelText" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource SubtleTextBrush}" />
      <Setter Property="Margin" Value="0,0,0,4" />
    </Style>

    <!-- Containers -->
    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource CardBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="16" />
      <Setter Property="Margin" Value="0,0,12,12" />
    </Style>
    <Style x:Key="Badge" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource NeutralSoftBrush}" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="8,2" />
      <Setter Property="Margin" Value="0,0,6,4" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="ErrorBanner" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource DangerSoftBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource DangerBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="12,8" />
      <Setter Property="Margin" Value="0,8,0,0" />
    </Style>
    <Style x:Key="SuccessBanner" TargetType="Border" BasedOn="{StaticResource ErrorBanner}">
      <Setter Property="Background" Value="{StaticResource SuccessSoftBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource SuccessBrush}" />
    </Style>

    <!-- Buttons -->
    <Style TargetType="Button">
      <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
      <Setter Property="Background" Value="{StaticResource CardBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="12,6" />
      <Setter Property="Margin" Value="0,0,8,8" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                <Setter TargetName="Chrome" Property="BorderThickness" Value="2" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Chrome" Property="Opacity" Value="0.5" />
                <Setter Property="Cursor" Value="Arrow" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="{StaticResource AccentBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
      <Setter Property="Foreground" Value="White" />
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="{StaticResource AccentHoverBrush}" />
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
    </Style>

    <!-- Inputs -->
    <Style TargetType="TextBox">
      <Setter Property="Padding" Value="6,4" />
      <Setter Property="MinWidth" Value="220" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="Padding" Value="6,4" />
      <Setter Property="MinWidth" Value="160" />
    </Style>

    <!-- Tables -->
    <Style TargetType="DataGrid">
      <Setter Property="AutoGenerateColumns" Value="False" />
      <Setter Property="IsReadOnly" Value="True" />
      <Setter Property="CanUserAddRows" Value="False" />
      <Setter Property="CanUserDeleteRows" Value="False" />
      <Setter Property="SelectionMode" Value="Single" />
      <Setter Property="HeadersVisibility" Value="Column" />
      <Setter Property="GridLinesVisibility" Value="Horizontal" />
      <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource BorderBrush}" />
      <Setter Property="Background" Value="{StaticResource CardBrush}" />
      <Setter Property="RowBackground" Value="{StaticResource CardBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
      <Setter Property="MinRowHeight" Value="34" />
      <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
      <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
    </Style>
    <Style TargetType="DataGridColumnHeader">
      <Setter Property="Background" Value="{StaticResource NeutralSoftBrush}" />
      <Setter Property="Foreground" Value="{StaticResource SubtleTextBrush}" />
      <Setter Property="Padding" Value="8,6" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style TargetType="DataGridCell">
      <Setter Property="Padding" Value="8,4" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="DataGridCell">
            <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
              <ContentPresenter VerticalAlignment="Center" />
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="IsSelected" Value="True">
          <Setter Property="Background" Value="{StaticResource InfoSoftBrush}" />
          <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="WrapCell" TargetType="TextBlock">
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- Requirement checks (a list of CheckItem): a coloured mark and the sentence. -->
    <DataTemplate x:Key="CheckList">
      <ItemsControl ItemsSource="{Binding}" Focusable="False">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <DockPanel Margin="0,3">
              <TextBlock DockPanel.Dock="Left" Text="{Binding Glyph}" FontWeight="Bold" Width="20" TextAlignment="Center" Margin="0,0,8,0">
                <TextBlock.Style>
                  <Style TargetType="TextBlock">
                    <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsOk}" Value="True">
                        <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                      </DataTrigger>
                      <DataTrigger Binding="{Binding IsFail}" Value="True">
                        <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>
              <TextBlock Text="{Binding Text}" TextWrapping="Wrap" />
            </DockPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </DataTemplate>

    <!-- Header shared by every page: title, intro, refresh, busy bar, error and success messages. DataContext = PageViewModel. -->
    <DataTemplate x:Key="PageHeader">
      <StackPanel Margin="0,0,0,12">
        <DockPanel>
          <Button DockPanel.Dock="Right" Content="{x:Static res:Strings.Common_Refresh}" Command="{Binding RefreshCommand}" Margin="0" VerticalAlignment="Top" />
          <StackPanel>
            <TextBlock Text="{Binding Title}" Style="{StaticResource HeadingText}" />
            <TextBlock Text="{Binding Intro}" Style="{StaticResource SubtleText}" Margin="0,4,0,0" />
          </StackPanel>
        </DockPanel>
        <ProgressBar IsIndeterminate="True" Height="3" Margin="0,8,0,0" BorderThickness="0" Background="Transparent"
                     Foreground="{StaticResource AccentBrush}" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
        <Border Style="{StaticResource ErrorBanner}" Visibility="{Binding ErrorMessage, Converter={StaticResource HasValueToVisibility}}">
          <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" />
        </Border>
        <Border Style="{StaticResource SuccessBanner}" Visibility="{Binding StatusMessage, Converter={StaticResource HasValueToVisibility}}">
          <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource SuccessBrush}" TextWrapping="Wrap" />
        </Border>
      </StackPanel>
    </DataTemplate>

    <!-- The form under one of a new account's answers. -->
    <Style x:Key="AnswerPanel" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource CardBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="12,10,12,4" />
      <Setter Property="Margin" Value="0,4,0,0" />
    </Style>

    <!--
      "A new Windows account was found" (dashboard and devices page; DataContext = NewAccountViewModel): what it means now,
      and the four answers — an existing member, a new child, an adult without filtering, or keeping it blocked as a guest.
    -->
    <DataTemplate x:Key="NewAccountCard" DataType="{x:Type vm:NewAccountViewModel}">
      <Border Background="{StaticResource WarningSoftBrush}" BorderBrush="{StaticResource WarningBrush}" BorderThickness="1" CornerRadius="8" Padding="16,12,16,8">
        <StackPanel>
          <DockPanel>
            <Button DockPanel.Dock="Right" Content="{x:Static res:Strings.Common_Cancel}" Command="{Binding CloseCommand}" Margin="8,0,0,0" Padding="10,3" VerticalAlignment="Top"
                    Visibility="{Binding CanClose, Converter={StaticResource BoolToVisibility}}" />
            <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource WarningBrush}" TextWrapping="Wrap" />
          </DockPanel>
          <TextBlock Text="{x:Static res:Strings.NewAccount_Text}" TextWrapping="Wrap" Margin="0,4,0,10" />
          <WrapPanel>
            <Button Content="{x:Static res:Strings.NewAccount_Existing}" Command="{Binding ChooseExistingCommand}" ToolTip="{x:Static res:Strings.NewAccount_ExistingHint}" />
            <Button Content="{x:Static res:Strings.NewAccount_NewChild}" Command="{Binding ChooseNewChildCommand}" ToolTip="{x:Static res:Strings.NewAccount_NewChildHint}" />
            <Button Content="{x:Static res:Strings.NewAccount_Adult}" Command="{Binding ChooseAdultCommand}" ToolTip="{x:Static res:Strings.NewAccount_AdultHint}" />
            <Button Content="{x:Static res:Strings.NewAccount_Guest}" Command="{Binding KeepAsGuestCommand}" ToolTip="{x:Static res:Strings.NewAccount_GuestHint}" />
          </WrapPanel>

          <!-- An existing member: children, teens and adults. -->
          <Border Style="{StaticResource AnswerPanel}" Visibility="{Binding IsChoosingExisting, Converter={StaticResource BoolToVisibility}}">
            <WrapPanel>
              <TextBlock Text="{x:Static res:Strings.NewAccount_WhichMember}" VerticalAlignment="Center" Margin="0,0,8,8" />
              <ComboBox ItemsSource="{Binding MemberOptions}" SelectedValuePath="Value" DisplayMemberPath="Label" SelectedValue="{Binding ExistingMemberId}"
                        MinWidth="180" Margin="0,0,8,8" AutomationProperties.Name="{x:Static res:Strings.NewAccount_WhichMember}" />
              <Button Content="{x:Static res:Strings.NewAccount_Link}" Command="{Binding LinkExistingCommand}" Style="{StaticResource PrimaryButton}" />
              <Button Content="{x:Static res:Strings.Common_Cancel}" Command="{Binding CancelAnswerCommand}" />
            </WrapPanel>
          </Border>

          <!-- A new child or teen, from the role's template as in the setup wizard. -->
          <Border Style="{StaticResource AnswerPanel}" Visibility="{Binding IsAddingChild, Converter={StaticResource BoolToVisibility}}">
            <StackPanel>
              <WrapPanel>
                <StackPanel Margin="0,0,12,8">
                  <TextBlock Text="{x:Static res:Strings.Member_Name}" Style="{StaticResource LabelText}" />
                  <TextBox Text="{Binding ChildName, UpdateSourceTrigger=PropertyChanged}" MinWidth="170" AutomationProperties.Name="{x:Static res:Strings.Member_Name}" />
                </StackPanel>
                <StackPanel Margin="0,0,12,8">
                  <TextBlock Text="{x:Static res:Strings.Member_Role}" Style="{StaticResource LabelText}" />
                  <ComboBox ItemsSource="{x:Static vm:NewAccountViewModel.ChildRoleOptions}" SelectedValuePath="Value" DisplayMemberPath="Label"
                            SelectedValue="{Binding ChildRole}" MinWidth="120" AutomationProperties.Name="{x:Static res:Strings.Member_Role}" />
                </StackPanel>
                <StackPanel Margin="0,0,12,8">
                  <TextBlock Text="{x:Static res:Strings.Member_Age}" Style="{StaticResource LabelText}" />
                  <TextBox Text="{Binding ChildAgeText, UpdateSourceTrigger=PropertyChanged}" MinWidth="0" Width="56" AutomationProperties.Name="{x:Static res:Strings.Member_Age}" />
                </StackPanel>
              </WrapPanel>
              <TextBlock Text="{Binding ChildTemplateText}" Style="{StaticResource SubtleText}" FontSize="12" />
              <TextBlock Text="{x:Static res:Strings.NewAccount_ChildLater}" Style="{StaticResource SubtleText}" FontSize="12" Margin="0,2,0,8" />
              <WrapPanel>
                <Button Content="{x:Static res:Strings.NewAccount_AddAndLink}" Command="{Binding AddChildCommand}" Style="{StaticResource PrimaryButton}" />
                <Button Content="{x:Static res:Strings.Common_Cancel}" Command="{Binding CancelAnswerCommand}" />
              </WrapPanel>
            </StackPanel>
          </Border>

          <!-- An adult without filtering: one of the family's, or a new one. -->
          <Border Style="{StaticResource AnswerPanel}" Visibility="{Binding IsChoosingAdult, Converter={StaticResource BoolToVisibility}}">
            <StackPanel>
              <WrapPanel>
                <StackPanel Margin="0,0,12,8" Visibility="{Binding HasAdults, Converter={StaticResource BoolToVisibility}}">
                  <TextBlock Text="{x:Static res:Strings.NewAccount_WhichAdult}" Style="{StaticResource LabelText}" />
                  <ComboBox ItemsSource="{Binding AdultOptions}" SelectedValuePath="Value" DisplayMemberPath="Label" SelectedValue="{Binding AdultChoice}"
                            MinWidth="170" AutomationProperties.Name="{x:Static res:Strings.NewAccount_WhichAdult}" />
                </StackPanel>
                <StackPanel Margin="0,0,12,8" Visibility="{Binding IsNewAdult, Converter={StaticResource BoolToVisibility}}">
                  <TextBlock Text="{x:Static res:Strings.Member_Name}" Style="{StaticResource LabelText}" />
                  <TextBox Text="{Binding AdultName, UpdateSourceTrigger=PropertyChanged}" MinWidth="170" AutomationProperties.Name="{x:Static res:Strings.Member_Name}" />
                </StackPanel>
              </WrapPanel>
              <TextBlock Text="{x:Static res:Strings.NewAccount_AdultHint}" Style="{StaticResource SubtleText}" FontSize="12" Margin="0,0,0,8" />
              <WrapPanel>
                <Button Content="{Binding AdultActionText}" Command="{Binding LinkAdultCommand}" Style="{StaticResource PrimaryButton}" />
                <Button Content="{x:Static res:Strings.Common_Cancel}" Command="{Binding CancelAnswerCommand}" />
              </WrapPanel>
            </StackPanel>
          </Border>

          <TextBlock Text="{Binding Message}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" Margin="0,6,0,4"
                     Visibility="{Binding Message, Converter={StaticResource HasValueToVisibility}}" />
        </StackPanel>
      </Border>
    </DataTemplate>

  </Application.Resources>
</Application>
