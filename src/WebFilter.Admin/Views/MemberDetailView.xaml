<UserControl x:Class="WebFilter.Admin.Views.MemberDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:res="clr-namespace:WebFilter.Admin.Resources"
             xmlns:vm="clr-namespace:WebFilter.Admin.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:MemberDetailViewModel}">
  <UserControl.Resources>
    <Style x:Key="FormField" TargetType="StackPanel">
      <Setter Property="Margin" Value="0,0,12,8" />
    </Style>
    <Style x:Key="RowText" TargetType="TextBlock">
      <Setter Property="Margin" Value="8,6" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="ActionBadge" TargetType="Border" BasedOn="{StaticResource Badge}">
      <Setter Property="Background" Value="{StaticResource DangerSoftBrush}" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsAllow}" Value="True">
          <Setter Property="Background" Value="{StaticResource SuccessSoftBrush}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
  </UserControl.Resources>

  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="24,20,24,24" Grid.IsSharedSizeScope="True">
      <ContentControl Content="{Binding}" ContentTemplate="{StaticResource PageHeader}" Focusable="False" />

      <Border Style="{StaticResource Card}" Margin="0" Visibility="{Binding IsNotHub, Converter={StaticResource BoolToVisibility}}">
        <TextBlock Text="{x:Static res:Strings.Member_NotHub}" TextWrapping="Wrap" />
      </Border>
      <TextBlock Text="{x:Static res:Strings.Member_NoMembers}" Style="{StaticResource SubtleText}"
                 Visibility="{Binding HasNoMembers, Converter={StaticResource BoolToVisibility}}" />

      <StackPanel Visibility="{Binding HasMember, Converter={StaticResource BoolToVisibility}}">
        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
          <TextBlock Text="{x:Static res:Strings.Member_Choose}" VerticalAlignment="Center" Margin="0,0,8,0" />
          <ComboBox ItemsSource="{Binding MemberOptions}" SelectedValuePath="Value" DisplayMemberPath="Label" SelectedValue="{Binding SelectedMemberId}" MinWidth="220" />
        </StackPanel>
        <Border Style="{StaticResource Badge}" Background="{StaticResource InfoSoftBrush}" CornerRadius="6" Padding="12,8" Margin="0,0,0,12" HorizontalAlignment="Stretch"
                Visibility="{Binding IsUnrestricted, Converter={StaticResource BoolToVisibility}}">
          <TextBlock Text="{x:Static res:Strings.Member_UnrestrictedNote}" Foreground="{StaticResource InfoBrush}" TextWrapping="Wrap" />
        </Border>

        <!-- Profile and modes (SetMember) -->
        <TextBlock Text="{x:Static res:Strings.Member_Profile}" Style="{StaticResource SectionText}" />
        <Border Style="{StaticResource Card}" Margin="0,0,0,16" DataContext="{Binding Profile}">
          <StackPanel d:DataContext="{d:DesignInstance Type=vm:MemberProfileEditor}">
            <WrapPanel>
              <StackPanel Style="{StaticResource FormField}">
                <TextBlock Text="{x:Static res:Strings.Member_Name}" Style="{StaticResource LabelText}" />
                <TextBox Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}" MinWidth="180" />
              </StackPanel>
              <StackPanel Style="{StaticResource FormField}">
                <TextBlock Text="{x:Static res:Strings.Member_Role}" Style="{StaticResource LabelText}" />
                <ComboBox ItemsSource="{Binding Roles}" SelectedValuePath="Value" DisplayMemberPath="Label" SelectedValue="{Binding Role}" MinWidth="120" />
              </StackPanel>
              <StackPanel Style="{StaticResource FormField}">
                <TextBlock Text="{x:Static res:Strings.Member_Age}" Style="{StaticResource LabelText}" />
                <TextBox Text="{Binding AgeText, UpdateSourceTrigger=PropertyChanged}" MinWidth="60" Width="70" />
              </StackPanel>
              <StackPanel Style="{StaticResource FormField}">
                <TextBlock Text="{x:Static res:Strings.Settings_Col_FilterMode}" Style="{StaticResource LabelText}" />
                <ComboBox ItemsSource="{Binding FilterModeOptions}" SelectedValuePath="Value" DisplayMemberPath="Label" SelectedValue="{Binding FilterMode}" MinWidth="220" />
              </StackPanel>
              <StackPanel Style="{StaticResource FormField}">
                <TextBlock Text="{x:Static res:Strings.Settings_Col_YouTubeMode}" Style="{StaticResource LabelText}" />
                <ComboBox ItemsSource="{Binding YouTubeModeOptions}" SelectedValuePath="Value" DisplayMemberPath="Label" SelectedValue="{Binding YouTubeMode}" MinWidth="200" />
              </StackPanel>
            </WrapPanel>
            <Border Style="{StaticResource ErrorBanner}" Visibility="{Binding Message, Converter={StaticResource HasValueToVisibility}}">
              <TextBlock Text="{Binding Message}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" />
            </Border>
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0" Visibility="{Binding IsDirty, Converter={StaticResource BoolToVisibility}}">
              <Button Content="{x:Static res:Strings.Common_Save}" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButton}" />
              <Button Content="{x:Static res:Strings.Common_Revert}" Command="{Binding RevertCommand}" />
            </StackPanel>
          </StackPanel>
        </Border>

        <!-- Weekly hours and daily limits -->
        <TextBlock Text="{x:Static res:Strings.Member_Week}" Style="{StaticResource SectionText}" />
        <TextBlock Text="{x:Static res:Strings.Member_WeekHint}" Style="{StaticResource SubtleText}" Margin="0,0,0,8" />
        <Border Style="{StaticResource Card}" Margin="0,0,0,16" DataContext="{Binding Week}">
          <StackPanel d:DataContext="{d:DesignInstance Type=vm:WeekEditor}">
            <CheckBox Content="{x:Static res:Strings.Member_RestrictHours}" IsChecked="{Binding RestrictsHours}" Margin="0,0,0,8" />
            <Grid Background="{StaticResource NeutralSoftBrush}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition SharedSizeGroup="Day" Width="Auto" MinWidth="110" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition SharedSizeGroup="Limit" Width="Auto" MinWidth="170" />
                <ColumnDefinition SharedSizeGroup="Copy" Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="{x:Static res:Strings.Member_Col_Day}" Style="{StaticResource RowText}" FontWeight="SemiBold" Foreground="{StaticResource SubtleTextBrush}" />
              <TextBlock Grid.Column="1" Text="{x:Static res:Strings.Member_Col_Hours}" Style="{StaticResource RowText}" FontWeight="SemiBold" Foreground="{StaticResource SubtleTextBrush}" />
              <TextBlock Grid.Column="2" Text="{x:Static res:Strings.Member_Col_Limit}" Style="{StaticResource RowText}" FontWeight="SemiBold" Foreground="{StaticResource SubtleTextBrush}" />
            </Grid>
            <ItemsControl ItemsSource="{Binding Days}" Focusable="False">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:DayEditor}">
                  <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition SharedSizeGroup="Day" Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition SharedSizeGroup="Limit" Width="Auto" />
                        <ColumnDefinition SharedSizeGroup="Copy" Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <TextBlock Grid.Column="0" Text="{Binding Name}" Style="{StaticResource RowText}" FontWeight="SemiBold" />

                      <TextBlock Grid.Column="1" Text="{x:Static res:Strings.Member_AnyHour}" Style="{StaticResource RowText}" Foreground="{StaticResource SubtleTextBrush}"
                                 Visibility="{Binding HoursEnabled, Converter={StaticResource InverseBoolToVisibility}}" />
                      <WrapPanel Grid.Column="1" Margin="8,4" VerticalAlignment="Center" Visibility="{Binding HoursEnabled, Converter={StaticResource BoolToVisibility}}">
                        <ItemsControl ItemsSource="{Binding Windows}" Focusable="False">
                          <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                              <WrapPanel />
                            </ItemsPanelTemplate>
                          </ItemsControl.ItemsPanel>
                          <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:WindowEditor}">
                              <!-- Right to left like the rest of the form (from, then until); only the times inside the boxes run left to right. -->
                              <StackPanel Orientation="Horizontal" Margin="0,2,12,2">
                                <TextBox Text="{Binding Start, UpdateSourceTrigger=PropertyChanged}" MinWidth="0" Width="62" HorizontalContentAlignment="Center"
                                         FlowDirection="LeftToRight" AutomationProperties.Name="{x:Static res:Strings.Member_From}" />
                                <TextBlock Text="–" Margin="4,0" VerticalAlignment="Center" />
                                <TextBox Text="{Binding End, UpdateSourceTrigger=PropertyChanged}" MinWidth="0" Width="62" HorizontalContentAlignment="Center"
                                         FlowDirection="LeftToRight" AutomationProperties.Name="{x:Static res:Strings.Member_To}" />
                                <Button Content="✕" ToolTip="{x:Static res:Strings.Member_RemoveWindow}" Margin="4,0,0,0" Padding="7,2"
                                        Command="{Binding DataContext.RemoveWindowCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                              </StackPanel>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{x:Static res:Strings.Member_Closed}" Foreground="{StaticResource WarningBrush}" VerticalAlignment="Center" Margin="0,0,12,0"
                                   Visibility="{Binding IsClosed, Converter={StaticResource BoolToVisibility}}" />
                        <Button Content="{x:Static res:Strings.Member_AddWindow}" Command="{Binding AddWindowCommand}" Margin="0,2" Padding="8,2" />
                      </WrapPanel>

                      <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="8,4" VerticalAlignment="Center">
                        <TextBox Text="{Binding LimitText, UpdateSourceTrigger=PropertyChanged}" MinWidth="0" Width="60" HorizontalContentAlignment="Center"
                                 FlowDirection="LeftToRight" AutomationProperties.Name="{x:Static res:Strings.Member_Col_Limit}" />
                        <TextBlock Text="{x:Static res:Strings.Member_MinutesSuffix}" VerticalAlignment="Center" Margin="6,0,0,0" />
                        <TextBlock Text="{x:Static res:Strings.Member_NoLimit}" VerticalAlignment="Center" Margin="6,0,0,0" Foreground="{StaticResource SubtleTextBrush}"
                                   Visibility="{Binding HasNoLimit, Converter={StaticResource BoolToVisibility}}" />
                      </StackPanel>
                      <Button Grid.Column="3" Content="{x:Static res:Strings.Member_CopyToAll}" Margin="8,4" Padding="8,2" VerticalAlignment="Center"
                              Command="{Binding DataContext.CopyToAllCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Border Style="{StaticResource ErrorBanner}" Visibility="{Binding Message, Converter={StaticResource HasValueToVisibility}}">
              <TextBlock Text="{Binding Message}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" />
            </Border>
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0" Visibility="{Binding IsDirty, Converter={StaticResource BoolToVisibility}}">
              <Button Content="{x:Static res:Strings.Common_Save}" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButton}" />
              <Button Content="{x:Static res:Strings.Common_Revert}" Command="{Binding RevertCommand}" />
            </StackPanel>
          </StackPanel>
        </Border>

        <!-- Personal site rules -->
        <TextBlock Text="{x:Static res:Strings.Member_Sites}" Style="{StaticResource SectionText}" />
        <Border Style="{StaticResource Card}" Margin="0,0,0,16">
          <StackPanel>
            <WrapPanel>
              <StackPanel Style="{StaticResource FormField}">
                <TextBlock Text="{x:Static res:Strings.Rules_Add_Pattern}" Style="{StaticResource LabelText}" />
                <TextBox Text="{Binding NewPattern, UpdateSourceTrigger=PropertyChanged}" FlowDirection="LeftToRight" MinWidth="260">
                  <TextBox.InputBindings>
                    <KeyBinding Key="Enter" Command="{Binding AddRuleCommand}" />
                  </TextBox.InputBindings>
                </TextBox>
              </StackPanel>
              <StackPanel Style="{StaticResource FormField}">
                <TextBlock Text="{x:Static res:Strings.Rules_Add_Type}" Style="{StaticResource LabelText}" />
                <ComboBox ItemsSource="{Binding RuleTypeOptions}" SelectedValuePath="Value" DisplayMemberPath="Label" SelectedValue="{Binding NewType}" MinWidth="200" />
              </StackPanel>
              <StackPanel Style="{StaticResource FormField}">
                <TextBlock Text="{x:Static res:Strings.Rules_Add_Action}" Style="{StaticResource LabelText}" />
                <ComboBox ItemsSource="{Binding RuleActionOptions}" SelectedValuePath="Value" DisplayMemberPath="Label" SelectedValue="{Binding NewAction}" MinWidth="110" />
              </StackPanel>
              <StackPanel Style="{StaticResource FormField}">
                <TextBlock Text="{x:Static res:Strings.Rules_Add_Expiry}" Style="{StaticResource LabelText}" />
                <ComboBox ItemsSource="{Binding ExpiryOptions}" SelectedValuePath="Value" DisplayMemberPath="Label" SelectedValue="{Binding NewExpiry}" MinWidth="140" />
              </StackPanel>
            </WrapPanel>
            <CheckBox Content="{x:Static res:Strings.Rules_Add_AlwaysAllowed}" IsChecked="{Binding NewAlwaysAllowed}" IsEnabled="{Binding CanBeAlwaysAllowed}" />
            <Border Style="{StaticResource ErrorBanner}" Visibility="{Binding RuleMessage, Converter={StaticResource HasValueToVisibility}}">
              <TextBlock Text="{Binding RuleMessage}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" />
            </Border>
            <Button Content="{x:Static res:Strings.Rules_Add_Button}" Command="{Binding AddRuleCommand}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Margin="0,10,0,12" />

            <TextBlock Text="{x:Static res:Strings.Member_NoSites}" Style="{StaticResource SubtleText}" Visibility="{Binding HasNoRules, Converter={StaticResource BoolToVisibility}}" />
            <ItemsControl ItemsSource="{Binding Rules}" Focusable="False">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:RuleItemViewModel}">
                  <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition SharedSizeGroup="RulePattern" Width="Auto" MinWidth="200" />
                        <ColumnDefinition SharedSizeGroup="RuleType" Width="Auto" />
                        <ColumnDefinition SharedSizeGroup="RuleAction" Width="Auto" />
                        <ColumnDefinition SharedSizeGroup="RuleExpiry" Width="Auto" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <TextBlock Grid.Column="0" Text="{Binding Pattern}" Style="{StaticResource RowText}" FlowDirection="LeftToRight" HorizontalAlignment="Left" />
                      <TextBlock Grid.Column="1" Text="{Binding TypeText}" Style="{StaticResource RowText}" />
                      <WrapPanel Grid.Column="2" Margin="8,4" VerticalAlignment="Center">
                        <Border Style="{StaticResource ActionBadge}">
                          <TextBlock Text="{Binding ActionText}" FontSize="12" />
                        </Border>
                        <Border Style="{StaticResource Badge}" Background="{StaticResource InfoSoftBrush}" Visibility="{Binding AlwaysAllowed, Converter={StaticResource BoolToVisibility}}">
                          <TextBlock Text="{x:Static res:Strings.Rule_AlwaysAllowed}" FontSize="12" Foreground="{StaticResource InfoBrush}" />
                        </Border>
                      </WrapPanel>
                      <TextBlock Grid.Column="3" Text="{Binding ExpiryText}" Style="{StaticResource RowText}" />
                      <Button Grid.Column="4" Content="{x:Static res:Strings.Common_Remove}" Style="{StaticResource DangerButton}" Margin="8,4" Padding="10,3" HorizontalAlignment="Right"
                              Command="{Binding DataContext.RemoveRuleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>

        <!-- YouTube channels -->
        <TextBlock Text="{x:Static res:Strings.Member_Channels}" Style="{StaticResource SectionText}" />
        <TextBlock Text="{x:Static res:Strings.Member_ChannelsHint}" Style="{StaticResource SubtleText}" Margin="0,0,0,8" />
        <Border Style="{StaticResource Card}" Margin="0,0,0,16">
          <StackPanel>
            <WrapPanel>
              <StackPanel Style="{StaticResource FormField}">
                <TextBlock Text="{x:Static res:Strings.Member_ChannelId}" Style="{StaticResource LabelText}" />
                <TextBox Text="{Binding NewChannel, UpdateSourceTrigger=PropertyChanged}" FlowDirection="LeftToRight" MinWidth="280" />
              </StackPanel>
              <StackPanel Style="{StaticResource FormField}">
                <TextBlock Text="{x:Static res:Strings.Member_ChannelHandle}" Style="{StaticResource LabelText}" />
                <TextBox Text="{Binding NewChannelHandle, UpdateSourceTrigger=PropertyChanged}" FlowDirection="LeftToRight" MinWidth="160" />
              </StackPanel>
              <StackPanel Style="{StaticResource FormField}">
                <TextBlock Text="{x:Static res:Strings.Member_ChannelTitle}" Style="{StaticResource LabelText}" />
                <TextBox Text="{Binding NewChannelTitle, UpdateSourceTrigger=PropertyChanged}" MinWidth="160" />
              </StackPanel>
              <StackPanel Style="{StaticResource FormField}">
                <TextBlock Text="{x:Static res:Strings.Rules_Add_Action}" Style="{StaticResource LabelText}" />
                <ComboBox ItemsSource="{Binding ChannelActionOptions}" SelectedValuePath="Value" DisplayMemberPath="Label" SelectedValue="{Binding NewChannelAction}" MinWidth="110" />
              </StackPanel>
            </WrapPanel>
            <Border Style="{StaticResource ErrorBanner}" Visibility="{Binding ChannelMessage, Converter={StaticResource HasValueToVisibility}}">
              <TextBlock Text="{Binding ChannelMessage}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" />
            </Border>
            <Button Content="{x:Static res:Strings.Member_AddChannel}" Command="{Binding AddChannelCommand}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Margin="0,10,0,12" />

            <TextBlock Text="{x:Static res:Strings.Member_NoChannels}" Style="{StaticResource SubtleText}" Visibility="{Binding HasNoChannels, Converter={StaticResource BoolToVisibility}}" />
            <ItemsControl ItemsSource="{Binding Channels}" Focusable="False">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:ChannelItemViewModel}">
                  <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition SharedSizeGroup="ChannelName" Width="Auto" MinWidth="160" />
                        <ColumnDefinition SharedSizeGroup="ChannelDetail" Width="Auto" />
                        <ColumnDefinition SharedSizeGroup="ChannelAction" Width="Auto" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <TextBlock Grid.Column="0" Text="{Binding NameText}" Style="{StaticResource RowText}" FontWeight="SemiBold" />
                      <TextBlock Grid.Column="1" Text="{Binding DetailText}" Style="{StaticResource RowText}" FlowDirection="LeftToRight" HorizontalAlignment="Left"
                                 Foreground="{StaticResource SubtleTextBrush}" />
                      <Border Grid.Column="2" Style="{StaticResource ActionBadge}" Margin="8,4">
                        <TextBlock Text="{Binding ActionText}" FontSize="12" />
                      </Border>
                      <Button Grid.Column="3" Content="{x:Static res:Strings.Common_Remove}" Style="{StaticResource DangerButton}" Margin="8,4" Padding="10,3" HorizontalAlignment="Right"
                              Command="{Binding DataContext.RemoveChannelCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>

        <!-- Approved apps -->
        <TextBlock Text="{x:Static res:Strings.Member_Apps}" Style="{StaticResource SectionText}" />
        <TextBlock Text="{x:Static res:Strings.Member_AppsHint}" Style="{StaticResource SubtleText}" Margin="0,0,0,8" />
        <Border Style="{StaticResource Card}" Margin="0,0,0,16">
          <StackPanel>
            <WrapPanel>
              <StackPanel Style="{StaticResource FormField}">
                <TextBlock Text="{x:Static res:Strings.Member_AppMatch}" Style="{StaticResource LabelText}" />
                <ComboBox ItemsSource="{Binding AppMatchOptions}" SelectedValuePath="Value" DisplayMemberPath="Label" SelectedValue="{Binding NewAppMatch}" MinWidth="180" />
              </StackPanel>
              <StackPanel Style="{StaticResource FormField}">
                <TextBlock Text="{x:Static res:Strings.Member_AppValue}" Style="{StaticResource LabelText}" />
                <TextBox Text="{Binding NewAppValue, UpdateSourceTrigger=PropertyChanged}" FlowDirection="LeftToRight" MinWidth="380" />
              </StackPanel>
              <StackPanel Style="{StaticResource FormField}">
                <TextBlock Text="{x:Static res:Strings.Rules_Add_Expiry}" Style="{StaticResource LabelText}" />
                <ComboBox ItemsSource="{Binding ExpiryOptions}" SelectedValuePath="Value" DisplayMemberPath="Label" SelectedValue="{Binding NewAppExpiry}" MinWidth="140" />
              </StackPanel>
            </WrapPanel>
            <CheckBox Content="{x:Static res:Strings.Member_AppAlwaysAllowed}" IsChecked="{Binding NewAppAlwaysAllowed}" />
            <Border Style="{StaticResource ErrorBanner}" Visibility="{Binding AppMessage, Converter={StaticResource HasValueToVisibility}}">
              <TextBlock Text="{Binding AppMessage}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" />
            </Border>
            <Button Content="{x:Static res:Strings.Member_AddApp}" Command="{Binding AddAppCommand}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Margin="0,10,0,12" />

            <TextBlock Text="{x:Static res:Strings.Member_NoApps}" Style="{StaticResource SubtleText}" Visibility="{Binding HasNoApps, Converter={StaticResource BoolToVisibility}}" />
            <ItemsControl ItemsSource="{Binding Apps}" Focusable="False">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:AppRuleItemViewModel}">
                  <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition SharedSizeGroup="AppName" Width="Auto" MinWidth="140" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition SharedSizeGroup="AppMatch" Width="Auto" />
                        <ColumnDefinition SharedSizeGroup="AppAction" Width="Auto" />
                        <ColumnDefinition SharedSizeGroup="AppExpiry" Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <TextBlock Grid.Column="0" Text="{Binding Name}" Style="{StaticResource RowText}" FontWeight="SemiBold" FlowDirection="LeftToRight" HorizontalAlignment="Left" />
                      <TextBlock Grid.Column="1" Text="{Binding Value}" Style="{StaticResource RowText}" FlowDirection="LeftToRight" HorizontalAlignment="Left" TextWrapping="NoWrap"
                                 TextTrimming="CharacterEllipsis" ToolTip="{Binding Value}" Foreground="{StaticResource SubtleTextBrush}" />
                      <TextBlock Grid.Column="2" Text="{Binding MatchText}" Style="{StaticResource RowText}" />
                      <WrapPanel Grid.Column="3" Margin="8,4" VerticalAlignment="Center">
                        <Border Style="{StaticResource ActionBadge}">
                          <TextBlock Text="{Binding ActionText}" FontSize="12" />
                        </Border>
                        <Border Style="{StaticResource Badge}" Background="{StaticResource InfoSoftBrush}" Visibility="{Binding AlwaysAllowed, Converter={StaticResource BoolToVisibility}}">
                          <TextBlock Text="{x:Static res:Strings.Rule_AlwaysAllowed}" FontSize="12" Foreground="{StaticResource InfoBrush}" />
                        </Border>
                      </WrapPanel>
                      <TextBlock Grid.Column="4" Text="{Binding ExpiryText}" Style="{StaticResource RowText}" />
                      <Button Grid.Column="5" Content="{x:Static res:Strings.Common_Remove}" Style="{StaticResource DangerButton}" Margin="8,4" Padding="10,3"
                              Command="{Binding DataContext.RemoveAppCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>

        <!-- Categories -->
        <TextBlock Text="{x:Static res:Strings.Member_Categories}" Style="{StaticResource SectionText}" />
        <TextBlock Text="{x:Static res:Strings.Member_CategoriesHint}" Style="{StaticResource SubtleText}" Margin="0,0,0,8" />
        <Border Style="{StaticResource Card}" Margin="0" DataContext="{Binding Categories}">
          <StackPanel d:DataContext="{d:DesignInstance Type=vm:CategoriesEditor}">
            <TextBlock Text="{x:Static res:Strings.Member_NoCategories}" Style="{StaticResource SubtleText}"
                       Visibility="{Binding HasNoCategories, Converter={StaticResource BoolToVisibility}}" />
            <ItemsControl ItemsSource="{Binding Items}" Focusable="False">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:CategoryChoiceViewModel}">
                  <Grid Margin="0,4">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition SharedSizeGroup="CategoryName" Width="Auto" MinWidth="140" />
                      <ColumnDefinition SharedSizeGroup="CategoryChoice" Width="Auto" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding Label}" Style="{StaticResource RowText}" FontWeight="SemiBold" />
                    <ComboBox Grid.Column="1" ItemsSource="{Binding Options}" SelectedValuePath="Value" DisplayMemberPath="Label" SelectedValue="{Binding Choice}" MinWidth="200" Margin="8,0" />
                    <TextBlock Grid.Column="2" Text="{Binding DomainsText}" Style="{StaticResource RowText}" FlowDirection="LeftToRight" HorizontalAlignment="Left"
                               Foreground="{StaticResource SubtleTextBrush}" FontSize="12" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Border Style="{StaticResource ErrorBanner}" Visibility="{Binding Message, Converter={StaticResource HasValueToVisibility}}">
              <TextBlock Text="{Binding Message}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" />
            </Border>
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0" Visibility="{Binding IsDirty, Converter={StaticResource BoolToVisibility}}">
              <Button Content="{x:Static res:Strings.Common_Save}" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButton}" />
              <Button Content="{x:Static res:Strings.Common_Revert}" Command="{Binding RevertCommand}" />
            </StackPanel>
          </StackPanel>
        </Border>
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
