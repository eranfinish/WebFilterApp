<UserControl x:Class="WebFilter.Admin.Views.RulesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:res="clr-namespace:WebFilter.Admin.Resources"
             xmlns:vm="clr-namespace:WebFilter.Admin.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:RulesViewModel}">
  <DockPanel Margin="24,20,24,24">
    <ContentControl DockPanel.Dock="Top" Content="{Binding}" ContentTemplate="{StaticResource PageHeader}" Focusable="False" />

    <!-- Add a rule -->
    <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="0,0,0,16">
      <StackPanel>
        <TextBlock Text="{x:Static res:Strings.Rules_Add_Title}" Style="{StaticResource SectionText}" Margin="0,0,0,8" />
        <WrapPanel>
          <StackPanel Margin="0,0,12,8">
            <TextBlock Text="{x:Static res:Strings.Rules_Add_Pattern}" Style="{StaticResource LabelText}" />
            <TextBox Text="{Binding NewPattern, UpdateSourceTrigger=PropertyChanged}" FlowDirection="LeftToRight" MinWidth="300">
              <TextBox.InputBindings>
                <KeyBinding Key="Enter" Command="{Binding AddCommand}" />
              </TextBox.InputBindings>
            </TextBox>
          </StackPanel>
          <StackPanel Margin="0,0,12,8">
            <TextBlock Text="{x:Static res:Strings.Rules_Add_Type}" Style="{StaticResource LabelText}" />
            <ComboBox ItemsSource="{Binding TypeOptions}" SelectedValuePath="Value" DisplayMemberPath="Label" SelectedValue="{Binding NewType}" MinWidth="200" />
          </StackPanel>
          <StackPanel Margin="0,0,12,8">
            <TextBlock Text="{x:Static res:Strings.Rules_Add_Action}" Style="{StaticResource LabelText}" />
            <ComboBox ItemsSource="{Binding ActionOptions}" SelectedValuePath="Value" DisplayMemberPath="Label" SelectedValue="{Binding NewAction}" MinWidth="110" />
          </StackPanel>
          <StackPanel Margin="0,0,12,8">
            <TextBlock Text="{x:Static res:Strings.Rules_Add_AppliesTo}" Style="{StaticResource LabelText}" />
            <ComboBox ItemsSource="{Binding AppliesToOptions}" SelectedValuePath="Value" DisplayMemberPath="Label" SelectedValue="{Binding NewAppliesTo}" />
          </StackPanel>
        </WrapPanel>
        <TextBlock Text="{x:Static res:Strings.Rules_Add_PatternHint}" Style="{StaticResource SubtleText}" FontSize="12" />
        <CheckBox Content="{x:Static res:Strings.Rules_Add_AlwaysAllowed}" IsChecked="{Binding NewAlwaysAllowed}" Margin="0,10,0,0"
                  IsEnabled="{Binding CanBeAlwaysAllowed}" />
        <Border Style="{StaticResource ErrorBanner}" Visibility="{Binding ValidationMessage, Converter={StaticResource HasValueToVisibility}}">
          <TextBlock Text="{Binding ValidationMessage}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" />
        </Border>
        <Button Content="{x:Static res:Strings.Rules_Add_Button}" Command="{Binding AddCommand}" Style="{StaticResource PrimaryButton}"
                HorizontalAlignment="Left" Margin="0,12,0,0" />
      </StackPanel>
    </Border>

    <!-- Filter -->
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
      <TextBlock Text="{x:Static res:Strings.Rules_Filter}" VerticalAlignment="Center" Margin="0,0,8,0" />
      <ComboBox ItemsSource="{Binding FilterOptions}" SelectedValuePath="Value" DisplayMemberPath="Label" SelectedValue="{Binding SelectedFilter}" MinWidth="220" />
    </StackPanel>
    <TextBlock DockPanel.Dock="Top" Text="{x:Static res:Strings.Rules_Empty}" Style="{StaticResource SubtleText}"
               Visibility="{Binding HasNoRules, Converter={StaticResource BoolToVisibility}}" />

    <DataGrid ItemsSource="{Binding Rules}" Visibility="{Binding HasNoRules, Converter={StaticResource InverseBoolToVisibility}}">
      <DataGrid.Columns>
        <DataGridTemplateColumn Header="{x:Static res:Strings.Rules_Col_Pattern}" Width="2*">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate DataType="{x:Type vm:RuleItemViewModel}">
              <TextBlock Text="{Binding Pattern}" FlowDirection="LeftToRight" HorizontalAlignment="Left" TextTrimming="CharacterEllipsis" ToolTip="{Binding Pattern}" />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTextColumn Header="{x:Static res:Strings.Rules_Col_Type}" Binding="{Binding TypeText}" Width="1.4*" ElementStyle="{StaticResource WrapCell}" />
        <DataGridTemplateColumn Header="{x:Static res:Strings.Rules_Col_Action}" Width="1.2*">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate DataType="{x:Type vm:RuleItemViewModel}">
              <WrapPanel>
                <Border>
                  <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource Badge}">
                      <Setter Property="Background" Value="{StaticResource DangerSoftBrush}" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding IsAllow}" Value="True">
                          <Setter Property="Background" Value="{StaticResource SuccessSoftBrush}" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Border.Style>
                  <TextBlock Text="{Binding ActionText}" FontSize="12" />
                </Border>
                <Border Style="{StaticResource Badge}" Background="{StaticResource InfoSoftBrush}"
                        Visibility="{Binding AlwaysAllowed, Converter={StaticResource BoolToVisibility}}">
                  <TextBlock Text="{x:Static res:Strings.Rule_AlwaysAllowed}" FontSize="12" Foreground="{StaticResource InfoBrush}" />
                </Border>
              </WrapPanel>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTextColumn Header="{x:Static res:Strings.Rules_Col_AppliesTo}" Binding="{Binding AppliesToText}" Width="*" ElementStyle="{StaticResource WrapCell}" />
        <DataGridTextColumn Header="{x:Static res:Strings.Rules_Col_Expiry}" Binding="{Binding ExpiryText}" Width="*" ElementStyle="{StaticResource WrapCell}" />
        <DataGridTemplateColumn Width="Auto">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate DataType="{x:Type vm:RuleItemViewModel}">
              <Button Content="{x:Static res:Strings.Common_Remove}" Style="{StaticResource DangerButton}" Margin="0" Padding="10,3"
                      Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
      </DataGrid.Columns>
    </DataGrid>
  </DockPanel>
</UserControl>
