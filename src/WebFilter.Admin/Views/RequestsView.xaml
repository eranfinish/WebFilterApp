<UserControl x:Class="WebFilter.Admin.Views.RequestsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:res="clr-namespace:WebFilter.Admin.Resources"
             xmlns:vm="clr-namespace:WebFilter.Admin.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:RequestsViewModel}">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="24,20,24,24">
      <ContentControl Content="{Binding}" ContentTemplate="{StaticResource PageHeader}" Focusable="False" />

      <TextBlock Text="{x:Static res:Strings.Requests_Pending}" Style="{StaticResource SectionText}" />
      <TextBlock Text="{x:Static res:Strings.Requests_NoPending}" Style="{StaticResource SubtleText}" Margin="0,0,0,12"
                 Visibility="{Binding HasNoPending, Converter={StaticResource BoolToVisibility}}" />

      <ItemsControl ItemsSource="{Binding Pending}" Focusable="False">
        <ItemsControl.ItemTemplate>
          <DataTemplate DataType="{x:Type vm:RequestItemViewModel}">
            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
              <StackPanel>
                <DockPanel>
                  <TextBlock DockPanel.Dock="Right" Text="{Binding SentText}" Style="{StaticResource SubtleText}" FontSize="12" VerticalAlignment="Center" />
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding MemberName}" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <Border Style="{StaticResource Badge}" Background="{StaticResource InfoSoftBrush}" Margin="0">
                      <TextBlock Text="{Binding KindText}" FontSize="12" Foreground="{StaticResource InfoBrush}" />
                    </Border>
                  </StackPanel>
                </DockPanel>

                <TextBlock Text="{Binding TargetText}" FontWeight="SemiBold" Margin="0,8,0,0" TextWrapping="Wrap"
                           FlowDirection="LeftToRight" HorizontalAlignment="Left" />
                <TextBlock Text="{Binding MessageText}" FontStyle="Italic" Style="{StaticResource SubtleText}" Margin="0,6,0,0"
                           Visibility="{Binding MessageText, Converter={StaticResource HasValueToVisibility}}" />

                <StackPanel Orientation="Horizontal" Margin="0,10,0,0" Visibility="{Binding IsUrl, Converter={StaticResource BoolToVisibility}}">
                  <TextBlock Text="{x:Static res:Strings.Request_ScopeLabel}" VerticalAlignment="Center" Margin="0,0,8,0" />
                  <ComboBox ItemsSource="{Binding ScopeOptions}" SelectedValuePath="Value" DisplayMemberPath="Label"
                            SelectedValue="{Binding SelectedScope}" MinWidth="240" />
                </StackPanel>

                <WrapPanel Margin="0,12,0,0">
                  <ItemsControl ItemsSource="{Binding Choices}" Focusable="False">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <WrapPanel />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate DataType="{x:Type vm:ApprovalChoice}">
                        <Button Content="{Binding Label}" Command="{Binding Command}" CommandParameter="{Binding Value}" Style="{StaticResource PrimaryButton}" />
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <Button Content="{x:Static res:Strings.Request_Deny}" Command="{Binding DenyCommand}" Style="{StaticResource DangerButton}" />
                </WrapPanel>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <TextBlock Text="{x:Static res:Strings.Requests_Recent}" Style="{StaticResource SectionText}" Margin="0,16,0,8" />
      <TextBlock Text="{x:Static res:Strings.Requests_NoRecent}" Style="{StaticResource SubtleText}"
                 Visibility="{Binding HasNoRecent, Converter={StaticResource BoolToVisibility}}" />
      <Border Style="{StaticResource Card}" Margin="0" Padding="0"
              Visibility="{Binding HasNoRecent, Converter={StaticResource InverseBoolToVisibility}}">
        <ItemsControl ItemsSource="{Binding Recent}" Focusable="False">
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="{x:Type vm:RequestItemViewModel}">
              <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="16,8">
                <DockPanel>
                  <Border DockPanel.Dock="Right" Margin="0">
                    <Border.Style>
                      <Style TargetType="Border" BasedOn="{StaticResource Badge}">
                        <Setter Property="Background" Value="{StaticResource DangerSoftBrush}" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding IsApproved}" Value="True">
                            <Setter Property="Background" Value="{StaticResource SuccessSoftBrush}" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding StatusText}" FontSize="12" />
                  </Border>
                  <!-- Separate blocks so a URL or channel id never mixes with the Hebrew around it. -->
                  <WrapPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding MemberName}" FontWeight="SemiBold" Margin="0,0,8,0" />
                    <TextBlock Text="{Binding KindText}" Foreground="{StaticResource SubtleTextBrush}" Margin="0,0,8,0" />
                    <TextBlock Text="{Binding TargetText}" FlowDirection="LeftToRight" TextTrimming="CharacterEllipsis" MaxWidth="460" ToolTip="{Binding TargetText}" />
                  </WrapPanel>
                </DockPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
