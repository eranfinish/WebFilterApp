<UserControl x:Class="WebFilter.Admin.Views.DevicesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:res="clr-namespace:WebFilter.Admin.Resources"
             xmlns:vm="clr-namespace:WebFilter.Admin.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:DevicesViewModel}">
  <UserControl.Resources>
    <Style x:Key="ColumnHeader" TargetType="TextBlock">
      <Setter Property="Margin" Value="8" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{StaticResource SubtleTextBrush}" />
    </Style>

    <!-- Header of a device table; its columns line up with DeviceRow (and across both tables) through the shared size groups. -->
    <DataTemplate x:Key="DeviceHeader">
      <Grid Background="{StaticResource NeutralSoftBrush}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition SharedSizeGroup="Name" Width="Auto" MinWidth="170" />
          <ColumnDefinition SharedSizeGroup="Os" Width="Auto" MinWidth="110" />
          <ColumnDefinition SharedSizeGroup="Paired" Width="Auto" MinWidth="110" />
          <ColumnDefinition SharedSizeGroup="Seen" Width="Auto" MinWidth="170" />
          <ColumnDefinition SharedSizeGroup="Status" Width="Auto" MinWidth="110" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0" Text="{x:Static res:Strings.Devices_Col_Name}" Style="{StaticResource ColumnHeader}" Margin="16,8,8,8" />
        <TextBlock Grid.Column="1" Text="{x:Static res:Strings.Devices_Col_Os}" Style="{StaticResource ColumnHeader}" />
        <TextBlock Grid.Column="2" Text="{x:Static res:Strings.Devices_Col_PairedAt}" Style="{StaticResource ColumnHeader}" />
        <TextBlock Grid.Column="3" Text="{x:Static res:Strings.Devices_Col_LastSeen}" Style="{StaticResource ColumnHeader}" />
        <TextBlock Grid.Column="4" Text="{x:Static res:Strings.Devices_Col_Status}" Style="{StaticResource ColumnHeader}" />
      </Grid>
    </DataTemplate>

    <DataTemplate x:Key="DeviceRow" DataType="{x:Type vm:DeviceItemViewModel}">
      <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition SharedSizeGroup="Name" Width="Auto" />
            <ColumnDefinition SharedSizeGroup="Os" Width="Auto" />
            <ColumnDefinition SharedSizeGroup="Paired" Width="Auto" />
            <ColumnDefinition SharedSizeGroup="Seen" Width="Auto" />
            <ColumnDefinition SharedSizeGroup="Status" Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" Text="{Binding Name}" ToolTip="{Binding IdText}" FontWeight="SemiBold" Margin="16,8,8,8" MaxWidth="280"
                     TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
          <TextBlock Grid.Column="1" Text="{Binding OsText}" Margin="8" VerticalAlignment="Center" />
          <TextBlock Grid.Column="2" Text="{Binding PairedText}" Margin="8" VerticalAlignment="Center" />
          <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="8" VerticalAlignment="Center">
            <Ellipse Width="9" Height="9" Margin="0,0,6,0" Fill="#22C55E" VerticalAlignment="Center" ToolTip="{x:Static res:Strings.Device_Online}"
                     Visibility="{Binding IsOnline, Converter={StaticResource BoolToVisibility}}" />
            <TextBlock Text="{Binding LastSeenText}" VerticalAlignment="Center" />
          </StackPanel>
          <Border Grid.Column="4" Margin="8,0">
            <Border.Style>
              <Style TargetType="Border" BasedOn="{StaticResource Badge}">
                <Setter Property="Background" Value="{StaticResource SuccessSoftBrush}" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsRevoked}" Value="True">
                    <Setter Property="Background" Value="{StaticResource NeutralSoftBrush}" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Border.Style>
            <TextBlock Text="{Binding StatusText}" FontSize="12" />
          </Border>
          <Button Grid.Column="5" Content="{x:Static res:Strings.Devices_Revoke}" Style="{StaticResource DangerButton}" Margin="8,4,16,4" Padding="10,3"
                  HorizontalAlignment="Left" VerticalAlignment="Center"
                  Command="{Binding DataContext.RevokeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                  Visibility="{Binding IsRevoked, Converter={StaticResource InverseBoolToVisibility}}" />
        </Grid>
      </Border>
    </DataTemplate>

    <!-- One of the hub's addresses; the selected one goes into the pair command. -->
    <Style x:Key="AddressChip" TargetType="ListBoxItem">
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="Chip" Background="{StaticResource NeutralSoftBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                    CornerRadius="12" Padding="10,3" Margin="0,0,6,4">
              <TextBlock Text="{Binding}" FontFamily="Consolas" FontSize="15" FlowDirection="LeftToRight" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Chip" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Chip" Property="Background" Value="{StaticResource InfoSoftBrush}" />
                <Setter TargetName="Chip" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- "Pair a new computer": the code, its countdown, where to reach this hub, and the command for the other computer. -->
    <DataTemplate x:Key="PairingPanel" DataType="{x:Type vm:PairingViewModel}">
      <Border Style="{StaticResource Card}" Margin="0" BorderBrush="{StaticResource AccentBrush}" BorderThickness="2">
        <StackPanel>
          <DockPanel>
            <Button DockPanel.Dock="Right" Content="{x:Static res:Strings.Common_Close}" Command="{Binding CloseCommand}" Margin="0" VerticalAlignment="Top" />
            <TextBlock Text="{x:Static res:Strings.Pairing_Title}" Style="{StaticResource SectionText}" Margin="0,0,0,4" />
          </DockPanel>
          <TextBlock Text="{x:Static res:Strings.Pairing_Steps}" Style="{StaticResource SubtleText}" />

          <!-- Large enough to read out or type on the other computer. -->
          <TextBlock Text="{x:Static res:Strings.Pairing_CodeLabel}" Style="{StaticResource LabelText}" Margin="0,14,0,2" />
          <TextBlock Text="{Binding Code}" FontFamily="Consolas" FontSize="40" FontWeight="SemiBold" FlowDirection="LeftToRight" HorizontalAlignment="Left"
                     AutomationProperties.Name="{x:Static res:Strings.Pairing_CodeLabel}">
            <TextBlock.Style>
              <Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsExpired}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource SubtleTextBrush}" />
                    <Setter Property="TextDecorations" Value="Strikethrough" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
          <TextBlock Text="{Binding CountdownText}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,2,0,0">
            <TextBlock.Style>
              <Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource InfoBrush}" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsExpired}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
          <Button Content="{x:Static res:Strings.Pairing_NewCode}" Command="{Binding NewCodeCommand}" Style="{StaticResource PrimaryButton}"
                  HorizontalAlignment="Left" Margin="0,10,0,0" Visibility="{Binding IsExpired, Converter={StaticResource BoolToVisibility}}" />

          <!-- Where the other computer reaches this hub. -->
          <WrapPanel Margin="0,14,0,0">
            <StackPanel Margin="0,0,32,8">
              <TextBlock Text="{x:Static res:Strings.Pairing_Address}" Style="{StaticResource LabelText}" />
              <ListBox ItemsSource="{Binding Addresses}" SelectedItem="{Binding SelectedAddress}" ItemContainerStyle="{StaticResource AddressChip}"
                       AutomationProperties.Name="{x:Static res:Strings.Pairing_Address}"
                       Visibility="{Binding HasAddresses, Converter={StaticResource BoolToVisibility}}">
                <!-- No scroll viewer of its own: the page scrolls, and a nested one would swallow the mouse wheel. -->
                <ListBox.Template>
                  <ControlTemplate TargetType="ListBox">
                    <ItemsPresenter />
                  </ControlTemplate>
                </ListBox.Template>
                <ListBox.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel />
                  </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
              </ListBox>
              <TextBlock Text="{x:Static res:Strings.Pairing_NoAddress}" Foreground="{StaticResource WarningBrush}" FontWeight="SemiBold" TextWrapping="Wrap" MaxWidth="440"
                         Visibility="{Binding HasAddresses, Converter={StaticResource InverseBoolToVisibility}}" />
            </StackPanel>
            <StackPanel Margin="0,0,0,8">
              <TextBlock Text="{x:Static res:Strings.Pairing_Port}" Style="{StaticResource LabelText}" />
              <TextBlock Text="{Binding PortText}" FontFamily="Consolas" FontSize="15" Margin="0,4,0,0" HorizontalAlignment="Left" />
            </StackPanel>
          </WrapPanel>
          <TextBlock Text="{x:Static res:Strings.Pairing_SeveralAddresses}" Style="{StaticResource SubtleText}" FontSize="12"
                     Visibility="{Binding HasSeveralAddresses, Converter={StaticResource BoolToVisibility}}" />

          <!-- The command for the other computer; greyed out once the code has expired. -->
          <StackPanel Visibility="{Binding HasAddresses, Converter={StaticResource BoolToVisibility}}">
            <StackPanel.Style>
              <Style TargetType="StackPanel">
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsExpired}" Value="True">
                    <Setter Property="Opacity" Value="0.45" />
                    <Setter Property="IsEnabled" Value="False" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </StackPanel.Style>
            <TextBlock Text="{x:Static res:Strings.Pairing_CommandLabel}" Style="{StaticResource LabelText}" Margin="0,14,0,4" />
            <DockPanel>
              <Button DockPanel.Dock="Right" Content="{x:Static res:Strings.Pairing_Copy}" Command="{Binding CopyCommand}" Style="{StaticResource PrimaryButton}"
                      Margin="8,0,0,0" VerticalAlignment="Center" />
              <TextBox Text="{Binding PairCommandText, Mode=OneWay}" IsReadOnly="True" FlowDirection="LeftToRight" FontFamily="Consolas" FontSize="14"
                       VerticalContentAlignment="Center" AutomationProperties.Name="{x:Static res:Strings.Pairing_CommandLabel}" />
            </DockPanel>
            <TextBlock Text="{Binding CopyMessage}" TextWrapping="Wrap" Margin="0,6,0,0"
                       Visibility="{Binding CopyMessage, Converter={StaticResource HasValueToVisibility}}">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding CopyFailed}" Value="True">
                      <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
          </StackPanel>
        </StackPanel>
      </Border>
    </DataTemplate>
  </UserControl.Resources>

  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="24,20,24,24" Grid.IsSharedSizeScope="True">
      <ContentControl Content="{Binding}" ContentTemplate="{StaticResource PageHeader}" Focusable="False" />

      <!-- Agent computer: devices are managed on the hub, so no buttons here. -->
      <Border Style="{StaticResource Card}" Margin="0" Background="{StaticResource InfoSoftBrush}" BorderBrush="{StaticResource InfoBrush}"
              Visibility="{Binding IsNotHub, Converter={StaticResource BoolToVisibility}}">
        <StackPanel>
          <TextBlock Text="{x:Static res:Strings.Devices_NotHubTitle}" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource InfoBrush}" TextWrapping="Wrap" />
          <TextBlock Text="{x:Static res:Strings.Devices_NotHub}" TextWrapping="Wrap" Margin="0,6,0,0" />
        </StackPanel>
      </Border>

      <StackPanel Visibility="{Binding IsHub, Converter={StaticResource BoolToVisibility}}">
        <Button Content="{x:Static res:Strings.Devices_Pair}" Command="{Binding StartPairingCommand}" Style="{StaticResource PrimaryButton}"
                HorizontalAlignment="Left" Margin="0" Visibility="{Binding IsPairing, Converter={StaticResource InverseBoolToVisibility}}" />
        <ContentControl Content="{Binding Pairing}" ContentTemplate="{StaticResource PairingPanel}" Focusable="False"
                        Visibility="{Binding IsPairing, Converter={StaticResource BoolToVisibility}}" />

        <TextBlock Text="{x:Static res:Strings.Devices_Paired}" Style="{StaticResource SectionText}" Margin="0,20,0,8" />
        <TextBlock Text="{x:Static res:Strings.Devices_Empty}" Style="{StaticResource SubtleText}"
                   Visibility="{Binding HasNoActive, Converter={StaticResource BoolToVisibility}}" />
        <Border Style="{StaticResource Card}" Margin="0" Padding="0"
                Visibility="{Binding HasNoActive, Converter={StaticResource InverseBoolToVisibility}}">
          <StackPanel>
            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource DeviceHeader}" Focusable="False" />
            <ItemsControl ItemsSource="{Binding Active}" ItemTemplate="{StaticResource DeviceRow}" Focusable="False" />
          </StackPanel>
        </Border>

        <!-- Revoked computers: apart and greyed out. -->
        <StackPanel Margin="0,20,0,0" Opacity="0.7" Visibility="{Binding HasRevoked, Converter={StaticResource BoolToVisibility}}">
          <TextBlock Text="{x:Static res:Strings.Devices_RevokedSection}" Style="{StaticResource SectionText}" Margin="0,0,0,4" />
          <TextBlock Text="{x:Static res:Strings.Devices_RevokedHint}" Style="{StaticResource SubtleText}" Margin="0,0,0,8" />
          <Border Style="{StaticResource Card}" Margin="0" Padding="0">
            <StackPanel>
              <ContentControl Content="{Binding}" ContentTemplate="{StaticResource DeviceHeader}" Focusable="False" />
              <ItemsControl ItemsSource="{Binding Revoked}" ItemTemplate="{StaticResource DeviceRow}" Focusable="False" />
            </StackPanel>
          </Border>
        </StackPanel>

        <!-- Each computer's Windows accounts and whom they belong to -->
        <TextBlock Text="{x:Static res:Strings.Devices_Accounts}" Style="{StaticResource SectionText}" Margin="0,20,0,4" />
        <TextBlock Text="{x:Static res:Strings.Devices_AccountsHint}" Style="{StaticResource SubtleText}" Margin="0,0,0,8" />
        <ItemsControl ItemsSource="{Binding AccountGroups}" Focusable="False">
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="{x:Type vm:DeviceAccountsViewModel}">
              <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                  <DockPanel Margin="0,0,0,6">
                    <Button DockPanel.Dock="Right" Content="{x:Static res:Strings.Devices_Rescan}" Margin="0" Padding="10,3"
                            Command="{Binding DataContext.ScanAccountsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            Visibility="{Binding IsThisComputer, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center" />
                  </DockPanel>
                  <TextBlock Text="{x:Static res:Strings.Devices_NoAccounts}" Style="{StaticResource SubtleText}"
                             Visibility="{Binding HasNoAccounts, Converter={StaticResource BoolToVisibility}}" />
                  <ItemsControl ItemsSource="{Binding Accounts}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                      <!--
                        A linked standard account: the member, to change. Not linked yet: the new-account card. A guest: says so,
                        with a way to give another answer. An administrator: never filtered, so no children to choose; optionally
                        the adult it belongs to, or (linked to a filtered member) a warning and a way to unlink it.
                      -->
                      <DataTemplate DataType="{x:Type vm:DeviceAccountItemViewModel}">
                        <StackPanel Margin="0,4">
                          <Grid>
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition SharedSizeGroup="AccountName" Width="Auto" MinWidth="160" />
                              <ColumnDefinition SharedSizeGroup="AccountAdmin" Width="Auto" />
                              <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding Name}" VerticalAlignment="Center" FlowDirection="LeftToRight" HorizontalAlignment="Left" />
                            <Border Grid.Column="1" Style="{StaticResource Badge}" Margin="8,0" ToolTip="{x:Static res:Strings.Devices_AdminToolTip}"
                                    Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVisibility}}">
                              <TextBlock Text="{x:Static res:Strings.Devices_AdminNotFiltered}" FontSize="12" />
                            </Border>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="8,0">
                              <StackPanel Orientation="Horizontal" Visibility="{Binding ShowsChoice, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="{x:Static res:Strings.Devices_AdminOwner}" Style="{StaticResource SubtleText}" VerticalAlignment="Center" Margin="0,0,8,0"
                                           Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVisibility}}" />
                                <ComboBox ItemsSource="{Binding Choices}" SelectedValuePath="Value" DisplayMemberPath="Label" SelectedValue="{Binding MemberId}" MinWidth="200">
                                  <ComboBox.Style>
                                    <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
                                      <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsAdmin}" Value="True">
                                          <Setter Property="ToolTip" Value="{x:Static res:Strings.Devices_AdminOwnerHint}" />
                                        </DataTrigger>
                                      </Style.Triggers>
                                    </Style>
                                  </ComboBox.Style>
                                </ComboBox>
                              </StackPanel>
                              <StackPanel Orientation="Horizontal" Visibility="{Binding ShowsGuest, Converter={StaticResource BoolToVisibility}}">
                                <Border Style="{StaticResource Badge}" Margin="0,0,8,0" ToolTip="{x:Static res:Strings.Devices_GuestToolTip}">
                                  <TextBlock Text="{x:Static res:Strings.Devices_GuestAccount}" FontSize="12" />
                                </Border>
                                <Button Content="{x:Static res:Strings.Devices_ChangeGuest}" Command="{Binding ChangeGuestCommand}" Margin="0" Padding="10,3" />
                              </StackPanel>
                              <Button Content="{x:Static res:Strings.Devices_Unlink}" Command="{Binding UnlinkCommand}" Margin="0" Padding="10,3"
                                      Visibility="{Binding Warning, Converter={StaticResource HasValueToVisibility}}" />
                            </StackPanel>
                          </Grid>
                          <TextBlock Text="{Binding Warning}" Foreground="{StaticResource WarningBrush}" TextWrapping="Wrap" Margin="0,4,0,0" FontSize="12"
                                     Visibility="{Binding Warning, Converter={StaticResource HasValueToVisibility}}" />
                          <ContentControl Content="{Binding Card}" ContentTemplate="{StaticResource NewAccountCard}" Focusable="False" Margin="0,6,0,4"
                                          Visibility="{Binding ShowsCard, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
