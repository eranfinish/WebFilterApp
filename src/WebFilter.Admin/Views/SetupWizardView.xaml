<UserControl x:Class="WebFilter.Admin.Views.SetupWizardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:res="clr-namespace:WebFilter.Admin.Resources"
             xmlns:vm="clr-namespace:WebFilter.Admin.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:SetupWizardViewModel}">
  <UserControl.Resources>
    <Style x:Key="ColumnHeader" TargetType="TextBlock">
      <Setter Property="Margin" Value="8" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{StaticResource SubtleTextBrush}" />
    </Style>
  </UserControl.Resources>

  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="24,20,24,24" Grid.IsSharedSizeScope="True">
      <ContentControl Content="{Binding}" ContentTemplate="{StaticResource PageHeader}" Focusable="False" />

      <Border Style="{StaticResource Card}" Margin="0" Visibility="{Binding IsNotHub, Converter={StaticResource BoolToVisibility}}">
        <TextBlock Text="{x:Static res:Strings.Setup_NotHub}" TextWrapping="Wrap" />
      </Border>
      <Border Style="{StaticResource Card}" Margin="0" Visibility="{Binding ShowsAlreadySetUp, Converter={StaticResource BoolToVisibility}}">
        <StackPanel>
          <TextBlock Text="{x:Static res:Strings.Setup_AlreadySetUp}" TextWrapping="Wrap" />
          <Button Content="{x:Static res:Strings.Setup_OpenMembers}" Command="{Binding OpenMembersCommand}" HorizontalAlignment="Left" Margin="0,12,0,0" />
        </StackPanel>
      </Border>

      <StackPanel Visibility="{Binding ShowsWizard, Converter={StaticResource BoolToVisibility}}">
        <!-- Progress -->
        <ItemsControl ItemsSource="{Binding Steps}" Focusable="False" Margin="0,0,0,12"
                      Visibility="{Binding IsDone, Converter={StaticResource InverseBoolToVisibility}}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="{x:Type vm:WizardStepItem}">
              <Border CornerRadius="14" Padding="12,4" Margin="0,0,8,4">
                <Border.Style>
                  <Style TargetType="Border">
                    <Setter Property="Background" Value="{StaticResource NeutralSoftBrush}" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsComplete}" Value="True">
                        <Setter Property="Background" Value="{StaticResource SuccessSoftBrush}" />
                      </DataTrigger>
                      <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                        <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Border.Style>
                <TextBlock Text="{Binding Label}">
                  <TextBlock.Style>
                    <Style TargetType="TextBlock">
                      <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                          <Setter Property="Foreground" Value="White" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </TextBlock.Style>
                </TextBlock>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- 1. Members -->
        <StackPanel Visibility="{Binding IsMembersStep, Converter={StaticResource BoolToVisibility}}">
          <TextBlock Text="{x:Static res:Strings.Setup_MembersHint}" Style="{StaticResource SubtleText}" Margin="0,0,0,8" />
          <Border Style="{StaticResource Card}" Padding="0" Margin="0">
            <StackPanel>
              <Grid Background="{StaticResource NeutralSoftBrush}">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition SharedSizeGroup="MName" Width="Auto" MinWidth="170" />
                  <ColumnDefinition SharedSizeGroup="MRole" Width="Auto" MinWidth="120" />
                  <ColumnDefinition SharedSizeGroup="MAge" Width="Auto" MinWidth="70" />
                  <ColumnDefinition SharedSizeGroup="MFilter" Width="Auto" MinWidth="220" />
                  <ColumnDefinition SharedSizeGroup="MYouTube" Width="Auto" MinWidth="200" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{x:Static res:Strings.Member_Name}" Style="{StaticResource ColumnHeader}" Margin="16,8,8,8" />
                <TextBlock Grid.Column="1" Text="{x:Static res:Strings.Member_Role}" Style="{StaticResource ColumnHeader}" />
                <TextBlock Grid.Column="2" Text="{x:Static res:Strings.Member_Age}" Style="{StaticResource ColumnHeader}" />
                <TextBlock Grid.Column="3" Text="{x:Static res:Strings.Settings_Col_FilterMode}" Style="{StaticResource ColumnHeader}" />
                <TextBlock Grid.Column="4" Text="{x:Static res:Strings.Settings_Col_YouTubeMode}" Style="{StaticResource ColumnHeader}" />
              </Grid>
              <ItemsControl ItemsSource="{Binding Members}" Focusable="False">
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="{x:Type vm:WizardMemberViewModel}">
                    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition SharedSizeGroup="MName" Width="Auto" />
                          <ColumnDefinition SharedSizeGroup="MRole" Width="Auto" />
                          <ColumnDefinition SharedSizeGroup="MAge" Width="Auto" />
                          <ColumnDefinition SharedSizeGroup="MFilter" Width="Auto" />
                          <ColumnDefinition SharedSizeGroup="MYouTube" Width="Auto" />
                          <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" MinWidth="150" Margin="16,6,8,6"
                                 AutomationProperties.Name="{x:Static res:Strings.Member_Name}" />
                        <ComboBox Grid.Column="1" ItemsSource="{Binding RoleOptions}" SelectedValuePath="Value" DisplayMemberPath="Label" SelectedValue="{Binding Role}"
                                  MinWidth="110" Margin="8,6" />
                        <TextBox Grid.Column="2" Text="{Binding AgeText, UpdateSourceTrigger=PropertyChanged}" MinWidth="0" Width="56" Margin="8,6"
                                 AutomationProperties.Name="{x:Static res:Strings.Member_Age}" />
                        <ComboBox Grid.Column="3" ItemsSource="{Binding FilterModeOptions}" SelectedValuePath="Value" DisplayMemberPath="Label" SelectedValue="{Binding FilterMode}" Margin="8,6" />
                        <ComboBox Grid.Column="4" ItemsSource="{Binding YouTubeModeOptions}" SelectedValuePath="Value" DisplayMemberPath="Label" SelectedValue="{Binding YouTubeMode}" Margin="8,6" />
                        <Button Grid.Column="5" Content="{x:Static res:Strings.Common_Remove}" Style="{StaticResource DangerButton}" Margin="8,6,16,6" Padding="10,3"
                                HorizontalAlignment="Right" VerticalAlignment="Center"
                                Command="{Binding DataContext.RemoveMemberCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
          <Button Content="{x:Static res:Strings.Setup_AddMember}" Command="{Binding AddMemberCommand}" HorizontalAlignment="Left" Margin="0,12,0,0" />
        </StackPanel>

        <!-- 2. This computer's Windows accounts -->
        <StackPanel Visibility="{Binding IsAccountsStep, Converter={StaticResource BoolToVisibility}}">
          <TextBlock Text="{x:Static res:Strings.Setup_AccountsHint}" Style="{StaticResource SubtleText}" Margin="0,0,0,8" />
          <Border Style="{StaticResource Card}" Margin="0">
            <StackPanel>
              <TextBlock Text="{x:Static res:Strings.Setup_NoAccounts}" Style="{StaticResource SubtleText}"
                         Visibility="{Binding HasNoAccounts, Converter={StaticResource BoolToVisibility}}" />
              <ItemsControl ItemsSource="{Binding Accounts}" Focusable="False">
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="{x:Type vm:WizardAccountViewModel}">
                    <StackPanel Margin="0,4">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition SharedSizeGroup="AName" Width="Auto" MinWidth="160" />
                          <ColumnDefinition SharedSizeGroup="AAdmin" Width="Auto" />
                          <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" FlowDirection="LeftToRight" HorizontalAlignment="Left" />
                        <Border Grid.Column="1" Style="{StaticResource Badge}" Margin="8,0" Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVisibility}}">
                          <TextBlock Text="{x:Static res:Strings.Setup_AdminAccount}" FontSize="12" />
                        </Border>
                        <ComboBox Grid.Column="2" ItemsSource="{Binding Options}" SelectedValuePath="Value" DisplayMemberPath="Label" SelectedValue="{Binding MemberId}"
                                  MinWidth="200" HorizontalAlignment="Left" Margin="8,0" />
                      </Grid>
                      <TextBlock Text="{Binding Warning}" Foreground="{StaticResource WarningBrush}" TextWrapping="Wrap" Margin="0,4,0,0"
                                 Visibility="{Binding Warning, Converter={StaticResource HasValueToVisibility}}" />
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <Button Content="{x:Static res:Strings.Setup_Rescan}" Command="{Binding RescanCommand}" HorizontalAlignment="Left" Margin="0,12,0,0" />
            </StackPanel>
          </Border>
        </StackPanel>

        <!-- 3. Hours and daily limits -->
        <StackPanel Visibility="{Binding IsTimeStep, Converter={StaticResource BoolToVisibility}}">
          <TextBlock Text="{x:Static res:Strings.Setup_TimeHint}" Style="{StaticResource SubtleText}" Margin="0,0,0,8" />
          <Border Style="{StaticResource Card}" Margin="0">
            <StackPanel>
              <TextBlock Text="{x:Static res:Strings.Setup_NoTimedMembers}" Style="{StaticResource SubtleText}"
                         Visibility="{Binding HasNoTimedMembers, Converter={StaticResource BoolToVisibility}}" />
              <ItemsControl ItemsSource="{Binding TimedMembers}" Focusable="False">
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="{x:Type vm:WizardMemberViewModel}">
                    <WrapPanel Margin="0,6">
                      <TextBlock Text="{Binding Name}" FontWeight="SemiBold" MinWidth="120" VerticalAlignment="Center" Margin="0,0,12,0" />
                      <CheckBox Content="{x:Static res:Strings.Setup_LimitTime}" IsChecked="{Binding LimitTime}" VerticalAlignment="Center" Margin="0,0,16,0" />
                      <StackPanel Orientation="Horizontal" IsEnabled="{Binding LimitTime}">
                        <TextBlock Text="{x:Static res:Strings.Setup_Between}" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox Text="{Binding Start, UpdateSourceTrigger=PropertyChanged}" MinWidth="0" Width="62" FlowDirection="LeftToRight" HorizontalContentAlignment="Center"
                                 AutomationProperties.Name="{x:Static res:Strings.Member_From}" />
                        <TextBlock Text="{x:Static res:Strings.Setup_And}" VerticalAlignment="Center" Margin="6,0" />
                        <TextBox Text="{Binding End, UpdateSourceTrigger=PropertyChanged}" MinWidth="0" Width="62" FlowDirection="LeftToRight" HorizontalContentAlignment="Center"
                                 AutomationProperties.Name="{x:Static res:Strings.Member_To}" />
                        <TextBlock Text="{x:Static res:Strings.Setup_UpTo}" VerticalAlignment="Center" Margin="16,0,6,0" />
                        <TextBox Text="{Binding LimitText, UpdateSourceTrigger=PropertyChanged}" MinWidth="0" Width="60" HorizontalContentAlignment="Center"
                                 AutomationProperties.Name="{x:Static res:Strings.Member_Col_Limit}" />
                        <TextBlock Text="{x:Static res:Strings.Setup_MinutesPerDay}" VerticalAlignment="Center" Margin="6,0,0,0" />
                      </StackPanel>
                    </WrapPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
        </StackPanel>

        <!-- 4. Ready-made categories -->
        <StackPanel Visibility="{Binding IsCategoriesStep, Converter={StaticResource BoolToVisibility}}">
          <TextBlock Text="{x:Static res:Strings.Setup_CategoriesHint}" Style="{StaticResource SubtleText}" Margin="0,0,0,8" />
          <Border Style="{StaticResource Card}" Margin="0,0,0,12">
            <ItemsControl ItemsSource="{Binding StarterCategories}" Focusable="False">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:WizardCategoryViewModel}">
                  <CheckBox Content="{Binding Text}" IsChecked="{Binding Include}" ToolTip="{Binding Sample}" Margin="0,4" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Border>
          <TextBlock Text="{x:Static res:Strings.Setup_CategoriesForMembers}" Style="{StaticResource SectionText}" />
          <TextBlock Text="{x:Static res:Strings.Setup_NoTimedMembers}" Style="{StaticResource SubtleText}"
                     Visibility="{Binding HasNoTimedMembers, Converter={StaticResource BoolToVisibility}}" />
          <Border Style="{StaticResource Card}" Margin="0" Visibility="{Binding HasNoTimedMembers, Converter={StaticResource InverseBoolToVisibility}}">
            <ItemsControl ItemsSource="{Binding TimedMembers}" Focusable="False">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:WizardMemberViewModel}">
                  <WrapPanel Margin="0,6">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" MinWidth="120" VerticalAlignment="Center" Margin="0,0,12,0" />
                    <ItemsControl ItemsSource="{Binding Categories}" Focusable="False">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <WrapPanel />
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:WizardCategoryChoice}">
                          <StackPanel Orientation="Horizontal" Margin="0,2,16,2" Visibility="{Binding Category.Include, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{Binding Category.Label}" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <ComboBox ItemsSource="{Binding Options}" SelectedValuePath="Value" DisplayMemberPath="Label" SelectedValue="{Binding Choice}" MinWidth="170" />
                          </StackPanel>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </WrapPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Border>
        </StackPanel>

        <!-- 5. Review -->
        <StackPanel Visibility="{Binding IsReviewStep, Converter={StaticResource BoolToVisibility}}">
          <TextBlock Text="{x:Static res:Strings.Setup_ReviewHint}" Style="{StaticResource SubtleText}" Margin="0,0,0,8" />
          <Border Style="{StaticResource Card}" Margin="0">
            <StackPanel>
              <ItemsControl ItemsSource="{Binding Members}" Focusable="False">
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="{x:Type vm:WizardMemberViewModel}">
                    <StackPanel Margin="0,4">
                      <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                      <TextBlock Text="{Binding SummaryText}" Style="{StaticResource SubtleText}" />
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Text="{Binding CategoriesSummary}" Style="{StaticResource SubtleText}" Margin="0,8,0,0" />
              <TextBlock Text="{Binding AccountsSummary}" Style="{StaticResource SubtleText}" Margin="0,4,0,0"
                         Visibility="{Binding AccountsSummary, Converter={StaticResource HasValueToVisibility}}" />
            </StackPanel>
          </Border>
        </StackPanel>

        <!-- Requirements check, on the review step -->
        <StackPanel Visibility="{Binding IsReviewStep, Converter={StaticResource BoolToVisibility}}">
          <StackPanel Visibility="{Binding HasChecks, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="{x:Static res:Strings.Setup_ChecksTitle}" Style="{StaticResource SectionText}" />
            <TextBlock Text="{x:Static res:Strings.Setup_ChecksHint}" Style="{StaticResource SubtleText}" Margin="0,0,0,8" />
            <Border Style="{StaticResource Card}" Margin="0">
              <ContentControl Content="{Binding Checks}" ContentTemplate="{StaticResource CheckList}" Focusable="False" />
            </Border>
          </StackPanel>
        </StackPanel>

        <!-- Done -->
        <Border Style="{StaticResource Card}" Margin="0" Visibility="{Binding IsDone, Converter={StaticResource BoolToVisibility}}">
          <StackPanel>
            <TextBlock Text="{x:Static res:Strings.Setup_DoneTitle}" Style="{StaticResource SectionText}" Margin="0,0,0,8" />
            <TextBlock Text="{x:Static res:Strings.Setup_DoneText}" TextWrapping="Wrap" />
            <WrapPanel Margin="0,12,0,0">
              <Button Content="{x:Static res:Strings.Setup_OpenDevices}" Command="{Binding OpenDevicesCommand}" Style="{StaticResource PrimaryButton}" />
              <Button Content="{x:Static res:Strings.Setup_OpenMembers}" Command="{Binding OpenMembersCommand}" />
              <Button Content="{x:Static res:Strings.Setup_OpenDashboard}" Command="{Binding OpenDashboardCommand}" />
            </WrapPanel>
          </StackPanel>
        </Border>

        <Border Style="{StaticResource ErrorBanner}" Visibility="{Binding Message, Converter={StaticResource HasValueToVisibility}}">
          <TextBlock Text="{Binding Message}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" />
        </Border>
        <WrapPanel Margin="0,16,0,0" Visibility="{Binding IsDone, Converter={StaticResource InverseBoolToVisibility}}">
          <Button Content="{x:Static res:Strings.Setup_Back}" Command="{Binding BackCommand}" Visibility="{Binding CanGoBack, Converter={StaticResource BoolToVisibility}}" />
          <Button Content="{x:Static res:Strings.Setup_Next}" Command="{Binding NextCommand}" Style="{StaticResource PrimaryButton}"
                  Visibility="{Binding CanGoNext, Converter={StaticResource BoolToVisibility}}" />
          <Button Content="{x:Static res:Strings.Setup_Apply}" Command="{Binding ApplyCommand}" Style="{StaticResource PrimaryButton}"
                  Visibility="{Binding IsReviewStep, Converter={StaticResource BoolToVisibility}}" />
        </WrapPanel>
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
