<UserControl x:Class="WebFilter.Admin.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:res="clr-namespace:WebFilter.Admin.Resources"
             xmlns:vm="clr-namespace:WebFilter.Admin.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel}">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="24,20,24,24" Grid.IsSharedSizeScope="True">
      <ContentControl Content="{Binding}" ContentTemplate="{StaticResource PageHeader}" Focusable="False" />

      <!-- Family members (managed on the hub, so not on an agent computer) -->
      <StackPanel Visibility="{Binding IsAgent, Converter={StaticResource InverseBoolToVisibility}}">
        <TextBlock Text="{x:Static res:Strings.Settings_Members}" Style="{StaticResource SectionText}" />
        <TextBlock Text="{x:Static res:Strings.Settings_MembersHint}" Style="{StaticResource SubtleText}" Margin="0,0,0,8" />
        <Border Style="{StaticResource Card}" Margin="0,0,0,16" Padding="0">
          <StackPanel>
            <Grid Background="{StaticResource NeutralSoftBrush}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition SharedSizeGroup="Name" Width="Auto" MinWidth="120" />
                <ColumnDefinition SharedSizeGroup="Role" Width="Auto" MinWidth="90" />
                <ColumnDefinition SharedSizeGroup="Age" Width="Auto" MinWidth="50" />
                <ColumnDefinition SharedSizeGroup="Filter" Width="Auto" MinWidth="220" />
                <ColumnDefinition SharedSizeGroup="YouTube" Width="Auto" MinWidth="200" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="{x:Static res:Strings.Settings_Col_Name}" Margin="16,8" FontWeight="SemiBold" Foreground="{StaticResource SubtleTextBrush}" />
              <TextBlock Grid.Column="1" Text="{x:Static res:Strings.Settings_Col_Role}" Margin="8" FontWeight="SemiBold" Foreground="{StaticResource SubtleTextBrush}" />
              <TextBlock Grid.Column="2" Text="{x:Static res:Strings.Settings_Col_Age}" Margin="8" FontWeight="SemiBold" Foreground="{StaticResource SubtleTextBrush}" />
              <TextBlock Grid.Column="3" Text="{x:Static res:Strings.Settings_Col_FilterMode}" Margin="8" FontWeight="SemiBold" Foreground="{StaticResource SubtleTextBrush}" />
              <TextBlock Grid.Column="4" Text="{x:Static res:Strings.Settings_Col_YouTubeMode}" Margin="8" FontWeight="SemiBold" Foreground="{StaticResource SubtleTextBrush}" />
            </Grid>
            <ItemsControl ItemsSource="{Binding Members}" Focusable="False">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:MemberSettingsViewModel}">
                  <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition SharedSizeGroup="Name" Width="Auto" />
                        <ColumnDefinition SharedSizeGroup="Role" Width="Auto" />
                        <ColumnDefinition SharedSizeGroup="Age" Width="Auto" />
                        <ColumnDefinition SharedSizeGroup="Filter" Width="Auto" />
                        <ColumnDefinition SharedSizeGroup="YouTube" Width="Auto" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <TextBlock Grid.Column="0" Text="{Binding DisplayName}" FontWeight="SemiBold" Margin="16,8" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="1" Text="{Binding RoleText}" Margin="8" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="2" Text="{Binding AgeText}" Margin="8" VerticalAlignment="Center" />
                      <ComboBox Grid.Column="3" ItemsSource="{Binding FilterModeOptions}" SelectedValuePath="Value" DisplayMemberPath="Label"
                                SelectedValue="{Binding FilterMode}" Margin="8,6" />
                      <ComboBox Grid.Column="4" ItemsSource="{Binding YouTubeModeOptions}" SelectedValuePath="Value" DisplayMemberPath="Label"
                                SelectedValue="{Binding YouTubeMode}" Margin="8,6" />
                      <StackPanel Grid.Column="5" Orientation="Horizontal" Margin="8,6,16,6" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Visibility="{Binding IsDirty, Converter={StaticResource BoolToVisibility}}">
                          <Button Content="{x:Static res:Strings.Common_Save}" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" />
                          <Button Content="{x:Static res:Strings.Common_Revert}" Command="{Binding RevertCommand}" Margin="0,0,8,0" />
                        </StackPanel>
                        <Button Content="{x:Static res:Strings.Action_MemberDetails}" Command="{Binding OpenDetailsCommand}" Margin="0" />
                      </StackPanel>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>

        <!-- Windows features for children (PROTECTION-SPEC §2), family-wide, saved together -->
        <TextBlock Text="{x:Static res:Strings.Settings_WindowsFeatures}" Style="{StaticResource SectionText}" />
        <TextBlock Text="{x:Static res:Strings.Settings_WindowsFeaturesHint}" Style="{StaticResource SubtleText}" Margin="0,0,0,8" />
        <Border Style="{StaticResource Card}" Margin="0,0,0,16" DataContext="{Binding WindowsFeatures}">
          <StackPanel d:DataContext="{d:DesignInstance Type=vm:WindowsFeaturesEditor}">
            <CheckBox Content="{x:Static res:Strings.Settings_Feature_NotificationsAndSync}" IsChecked="{Binding NotificationsAndSync}" />
            <TextBlock Text="{x:Static res:Strings.Settings_Feature_NotificationsAndSyncHint}" Style="{StaticResource SubtleText}" FontSize="12" Margin="22,2,0,10" />
            <CheckBox Content="{x:Static res:Strings.Settings_Feature_OneDrive}" IsChecked="{Binding OneDrive}" />
            <TextBlock Text="{x:Static res:Strings.Settings_Feature_OneDriveHint}" Style="{StaticResource SubtleText}" FontSize="12" Margin="22,2,0,10" />
            <CheckBox Content="{x:Static res:Strings.Settings_Feature_WebSearchInStart}" IsChecked="{Binding WebSearchInStart}" />
            <TextBlock Text="{x:Static res:Strings.Settings_Feature_WebSearchInStartHint}" Style="{StaticResource SubtleText}" FontSize="12" Margin="22,2,0,0" />
            <StackPanel Orientation="Horizontal" Margin="0,10,0,0" Visibility="{Binding IsDirty, Converter={StaticResource BoolToVisibility}}">
              <Button Content="{x:Static res:Strings.Common_Save}" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButton}" />
              <Button Content="{x:Static res:Strings.Common_Revert}" Command="{Binding RevertCommand}" />
            </StackPanel>
          </StackPanel>
        </Border>

        <!-- Baseline protection for the parents and adults (PROTECTION-SPEC §13), family-wide, saved together -->
        <TextBlock Text="{x:Static res:Strings.Settings_Baseline}" Style="{StaticResource SectionText}" />
        <TextBlock Text="{x:Static res:Strings.Settings_BaselineHint}" Style="{StaticResource SubtleText}" Margin="0,0,0,8" TextWrapping="Wrap" />
        <Border Style="{StaticResource Card}" Margin="0,0,0,16" DataContext="{Binding Baseline}">
          <StackPanel d:DataContext="{d:DesignInstance Type=vm:BaselineEditor}">
            <CheckBox Content="{x:Static res:Strings.Settings_Baseline_BlockAdult}" IsChecked="{Binding BlockAdult}" />
            <TextBlock Text="{x:Static res:Strings.Settings_Baseline_BlockAdultHint}" Style="{StaticResource SubtleText}" FontSize="12" Margin="22,2,0,10" />
            <CheckBox Content="{x:Static res:Strings.Settings_Baseline_JumpGuard}" IsChecked="{Binding JumpGuard}" />
            <TextBlock Text="{x:Static res:Strings.Settings_Baseline_JumpGuardHint}" Style="{StaticResource SubtleText}" FontSize="12" Margin="22,2,0,10" />
            <CheckBox Content="{x:Static res:Strings.Settings_Baseline_BlockAds}" IsChecked="{Binding BlockAds}" />
            <TextBlock Text="{x:Static res:Strings.Settings_Baseline_BlockAdsHint}" Style="{StaticResource SubtleText}" FontSize="12" Margin="22,2,0,10" />
            <CheckBox Content="{x:Static res:Strings.Settings_Baseline_SafeSearch}" IsChecked="{Binding SafeSearch}" />
            <TextBlock Text="{x:Static res:Strings.Settings_Baseline_SafeSearchHint}" Style="{StaticResource SubtleText}" FontSize="12" Margin="22,2,0,0" />
            <Border Background="{StaticResource WarningSoftBrush}" CornerRadius="6" Padding="10,6" Margin="0,10,0,0"
                    Visibility="{Binding NeedsAdultList, Converter={StaticResource BoolToVisibility}}">
              <TextBlock Text="{x:Static res:Strings.Settings_Baseline_AdultListMissing}" Foreground="{StaticResource WarningBrush}" TextWrapping="Wrap" />
            </Border>
            <StackPanel Orientation="Horizontal" Margin="0,10,0,0" Visibility="{Binding IsDirty, Converter={StaticResource BoolToVisibility}}">
              <Button Content="{x:Static res:Strings.Common_Save}" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButton}" />
              <Button Content="{x:Static res:Strings.Common_Revert}" Command="{Binding RevertCommand}" />
            </StackPanel>
          </StackPanel>
        </Border>
      </StackPanel>

      <!-- What this computer has and lacks -->
      <StackPanel Visibility="{Binding HasChecks, Converter={StaticResource BoolToVisibility}}">
        <TextBlock Text="{x:Static res:Strings.Settings_Checks}" Style="{StaticResource SectionText}" />
        <Border Style="{StaticResource Card}" Margin="0,0,0,16">
          <ContentControl Content="{Binding Checks}" ContentTemplate="{StaticResource CheckList}" Focusable="False" />
        </Border>
      </StackPanel>

      <!-- Service connection diagnostics -->
      <TextBlock Text="{x:Static res:Strings.Diagnostics_Title}" Style="{StaticResource SectionText}" />
      <Border Style="{StaticResource Card}" Margin="0" HorizontalAlignment="Left" MinWidth="460">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
          </Grid.RowDefinitions>
          <Grid.Resources>
            <Style TargetType="TextBlock">
              <Setter Property="Margin" Value="0,3,16,3" />
              <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
          </Grid.Resources>
          <TextBlock Grid.Row="0" Text="{x:Static res:Strings.Diagnostics_State}" Foreground="{StaticResource SubtleTextBrush}" />
          <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding ConnectionStateText}" MaxWidth="420" />
          <TextBlock Grid.Row="1" Text="{x:Static res:Strings.Diagnostics_Pipe}" Foreground="{StaticResource SubtleTextBrush}" />
          <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding PipeName}" FlowDirection="LeftToRight" HorizontalAlignment="Left" />
          <TextBlock Grid.Row="2" Text="{x:Static res:Strings.Diagnostics_SettingsVersion}" Foreground="{StaticResource SubtleTextBrush}" />
          <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SettingsVersionText}" />
          <TextBlock Grid.Row="3" Text="{x:Static res:Strings.Diagnostics_Device}" Foreground="{StaticResource SubtleTextBrush}" />
          <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding DeviceText}" FlowDirection="LeftToRight" HorizontalAlignment="Left" />
          <TextBlock Grid.Row="4" Text="{x:Static res:Strings.Diagnostics_IsHub}" Foreground="{StaticResource SubtleTextBrush}" />
          <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding IsHubText}" />
          <TextBlock Grid.Row="5" Text="{x:Static res:Strings.Diagnostics_ServiceTime}" Foreground="{StaticResource SubtleTextBrush}" />
          <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding ServiceTimeText}" />
          <TextBlock Grid.Row="6" Text="{x:Static res:Strings.Diagnostics_TimeZone}" Foreground="{StaticResource SubtleTextBrush}" />
          <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding TimeZoneText}" FlowDirection="LeftToRight" HorizontalAlignment="Left" />
          <TextBlock Grid.Row="7" Text="{x:Static res:Strings.Diagnostics_Hub}" Foreground="{StaticResource SubtleTextBrush}"
                     Visibility="{Binding IsAgent, Converter={StaticResource BoolToVisibility}}" />
          <TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding HubText}" MaxWidth="420" Visibility="{Binding IsAgent, Converter={StaticResource BoolToVisibility}}" />
        </Grid>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
