<Window x:Class="WebFilter.Admin.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:res="clr-namespace:WebFilter.Admin.Resources"
        xmlns:vm="clr-namespace:WebFilter.Admin.ViewModels"
        xmlns:views="clr-namespace:WebFilter.Admin.Views"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="{x:Static res:Strings.App_Title}"
        Width="1180" Height="760" MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        FlowDirection="RightToLeft"
        FontFamily="Segoe UI" FontSize="14"
        Foreground="{StaticResource TextBrush}"
        Background="{StaticResource WindowBrush}">

  <Window.Resources>
    <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
      <views:DashboardView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:RequestsViewModel}">
      <views:RequestsView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:RulesViewModel}">
      <views:RulesView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:ActivityViewModel}">
      <views:ActivityView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:DevicesViewModel}">
      <views:DevicesView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
      <views:SettingsView />
    </DataTemplate>

    <Style x:Key="NavItem" TargetType="ListBoxItem">
      <Setter Property="Foreground" Value="{StaticResource NavTextBrush}" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="Chrome" Background="Transparent" CornerRadius="6" Padding="14,10" Margin="10,2">
              <ContentPresenter />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource NavSelectedBrush}" />
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource AccentBrush}" />
                <Setter Property="Foreground" Value="White" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="230" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <!-- Navigation (on the right in RTL) -->
    <Border Grid.Column="0" Background="{StaticResource NavBrush}">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top" Margin="22,24,22,20">
          <TextBlock Text="WebFilter" FontSize="22" FontWeight="SemiBold" Foreground="White" />
          <TextBlock Text="{x:Static res:Strings.App_Subtitle}" Foreground="{StaticResource NavTextBrush}" TextWrapping="Wrap" Margin="0,4,0,0" />
        </StackPanel>

        <Border DockPanel.Dock="Bottom" Margin="16" Padding="10,8" CornerRadius="6" Background="{StaticResource NavSelectedBrush}">
          <DockPanel>
            <Ellipse DockPanel.Dock="Left" Width="9" Height="9" Margin="0,5,8,0" VerticalAlignment="Top">
              <Ellipse.Style>
                <Style TargetType="Ellipse">
                  <Setter Property="Fill" Value="#F59E0B" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsConnected}" Value="True">
                      <Setter Property="Fill" Value="#22C55E" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding HasConnectionProblem}" Value="True">
                      <Setter Property="Fill" Value="#EF4444" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Ellipse.Style>
            </Ellipse>
            <TextBlock Text="{Binding ConnectionShortText}" ToolTip="{Binding ConnectionText}" Foreground="{StaticResource NavTextBrush}" FontSize="12" TextWrapping="Wrap" />
          </DockPanel>
        </Border>

        <ListBox ItemsSource="{Binding Pages}" SelectedItem="{Binding SelectedPage}" Background="Transparent" BorderThickness="0"
                 ItemContainerStyle="{StaticResource NavItem}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
          <ListBox.ItemTemplate>
            <DataTemplate DataType="{x:Type vm:PageViewModel}">
              <DockPanel>
                <Border DockPanel.Dock="Right" Background="#EF4444" CornerRadius="9" Padding="7,0" MinWidth="20"
                        Visibility="{Binding Badge, Converter={StaticResource HasValueToVisibility}}">
                  <TextBlock Text="{Binding Badge}" Foreground="White" FontSize="12" HorizontalAlignment="Center" />
                </Border>
                <TextBlock Text="{Binding Title}" FontSize="15" />
              </DockPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Border>

    <!-- Content -->
    <DockPanel Grid.Column="1">
      <Border DockPanel.Dock="Top" Background="{StaticResource WarningSoftBrush}" BorderBrush="{StaticResource WarningBrush}" BorderThickness="0,0,0,1"
              Padding="24,12" Visibility="{Binding HasConnectionProblem, Converter={StaticResource BoolToVisibility}}">
        <DockPanel>
          <Button DockPanel.Dock="Right" Content="{x:Static res:Strings.Common_Retry}" Command="{Binding RetryCommand}" Margin="12,0,0,0" VerticalAlignment="Center" />
          <TextBlock Text="{Binding ConnectionText}" Foreground="{StaticResource WarningBrush}" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center" />
        </DockPanel>
      </Border>
      <ContentControl Content="{Binding SelectedPage}" Focusable="False" />
    </DockPanel>
  </Grid>
</Window>
