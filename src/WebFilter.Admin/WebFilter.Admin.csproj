<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyTitle>WebFilter parents' admin</AssemblyTitle>
    <!-- Hebrew is the neutral (built-in) language; Strings.en.resx becomes a satellite assembly. -->
    <NeutralLanguage>he</NeutralLanguage>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <!--
    Release builds demand elevation (MVP-PLAN §4.5): the admin pipe only admits elevated administrators.
    Debug and Simulation builds run asInvoker so developers can talk to a service running under their own account.
  -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' != 'Release'">
    <ApplicationManifest>app.asInvoker.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\WebFilter.Contracts\WebFilter.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- Public accessor class (used from XAML via x:Static and from view models), regenerated by Visual Studio on save. -->
    <EmbeddedResource Update="Resources\Strings.resx">
      <Generator>PublicResXFileCodeGenerator</Generator>
      <LastGenOutput>Strings.Designer.cs</LastGenOutput>
    </EmbeddedResource>
    <EmbeddedResource Update="Resources\Strings.en.resx">
      <DependentUpon>Strings.resx</DependentUpon>
    </EmbeddedResource>
    <Compile Update="Resources\Strings.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Strings.resx</DependentUpon>
    </Compile>
    <None Include="app.manifest" />
    <None Include="app.asInvoker.manifest" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="WebFilter.Admin.Tests" />
  </ItemGroup>

</Project>
