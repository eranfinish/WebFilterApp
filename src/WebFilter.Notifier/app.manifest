<?xml version="1.0" encoding="utf-8"?>
<!--
  The notifier runs as the signed-in user, never elevated: it only reads the notify pipe, which admits administrators'
  accounts unelevated. Opening the admin app (requireAdministrator) is what asks for elevation (UAC).
-->
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">
  <assemblyIdentity version="1.0.0.0" name="WebFilter.Notifier.app" />
  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v2">
    <security>
      <requestedPrivileges xmlns="urn:schemas-microsoft-com:asm.v3">
        <requestedExecutionLevel level="asInvoker" uiAccess="false" />
      </requestedPrivileges>
    </security>
  </trustInfo>
  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows 10 and Windows 11 -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}" />
    </application>
  </compatibility>
  <!-- DPI awareness: ApplicationHighDpiMode in the project (WinForms sets it at start, not the manifest). -->
</assembly>
